002Fsyslog","8.plugins\u002Fsyslog",{"title":354,"path":355,"stem":356},"tarpit","\u002Fplugins\u002Ftarpit","8.plugins\u002Ftarpit",{"title":358,"path":359,"stem":360},"tls","\u002Fplugins\u002Ftls","8.plugins\u002Ftls",{"title":362,"path":363,"stem":364},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":366,"path":367,"stem":368},"uribl","\u002Fplugins\u002Furibl","8.plugins\u002Furibl",{"title":370,"path":371,"stem":372},"watch","\u002Fplugins\u002Fwatch","8.plugins\u002Fwatch",{"title":374,"path":375,"stem":376},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":378,"title":379,"body":380,"description":531,"extension":532,"links":533,"meta":534,"navigation":535,"path":206,"seo":536,"stem":207,"__hash__":537},"docs\u002F8.plugins\u002Ffcrdns.md","fcrdns - Forward Confirmed Reverse DNS plugin for Haraka",{"type":381,"value":382,"toc":522},"minimark",[383,388,392,402,406,409,420,424,427,435,442,445,448,454,458,461,465,472,484,487,490,507,510,513,516,519],[384,385,387],"h2",{"id":386},"description","DESCRIPTION",[389,390,391],"p",{},"Determine if the SMTP sender has matching forward and reverse DNS.",[389,393,394,395],{},"See ",[396,397,401],"a",{"href":398,"rel":399},"http:\u002F\u002Fen.wikipedia.org\u002Fwiki\u002FFCrDNS",[400],"nofollow","FCrDNS at wikipedia",[384,403,405],{"id":404},"usage","USAGE",[389,407,408],{},"Other plugins can use FCrDNS results like this:",[410,411,416],"pre",{"className":412,"code":414,"language":415},[413],"language-text","var fcrdns = connection.results.get('fcrdns');\nif (fcrdns) {\n    if (fcrdns.fcrdns) {\n        \u002F\u002F they passed, reward them\n    }\n\n    var fails = fcrdns.fail;\n    if (connection.results.has('fcrdns', 'fail', \u002F^is_generic\u002F) {\n        \u002F\u002F their IP is in their hostname, unlikely to be MX, penalize\n    }\n}\n","text",[417,418,414],"code",{"__ignoreMap":419},"",[384,421,423],{"id":422},"configuration","CONFIGURATION",[389,425,426],{},"Edit config\u002Ffcrdns.ini",[389,428,429,430,434],{},"This plugin honors the whitelisting of IPs as set by the rdns_access plugin.\nFor that to work, rdns_access needs to be listed ",[431,432,433],"em",{},"before"," this plugin in\nconfig\u002Fplugins.",[436,437,438],"ul",{},[439,440,441],"li",{},"timeout=30",[389,443,444],{},"When performing DNS lookups, time out after this many seconds.",[389,446,447],{},"The following settings permit control of which test will block connections. To\nmimic the lookup_rdns.strict plugin, set no_rdns=true.",[410,449,452],{"className":450,"code":451,"language":415},[413],"[reject]\n; reject if the IP address has no PTR record\nno_rdns=false\n\n; reject if the FCrDNS test fails\nno_fcrdns=false\n\n; reject if the PTR points to a hostname without a valid TLD\ninvalid_tld=false\n\n; reject if the rDNS is generic, examples:\n; 1.2.3.4.in.addr.arpa\n; c-67-171-0-90.hsd1.wa.comcast.net\ngeneric_rdns=false\n",[417,453,451],{"__ignoreMap":419},[384,455,457],{"id":456},"anti-spam-effects","ANTI-SPAM EFFECTS",[389,459,460],{},"The reverse DNS of zombie PCs in bot nets is out of the bot operators control.\nThis presents a significant hurdle for a large portion of the hosts that\nattempt spam delivery.",[384,462,464],{"id":463},"how-it-works","HOW IT WORKS",[389,466,467,468],{},"From Wikipedia: ",[396,469,471],{"href":398,"rel":470},[400],"Forward Confirmed Reverse DNS",[473,474,475,478,481],"ol",{},[439,476,477],{},"First a reverse DNS lookup (PTR query) is performed on the IP address,\nwhich returns a list of zero or more PTR records.",[439,479,480],{},"For each domain name returned in the PTR query results, a regular\n'forward' DNS lookup (type A or AAAA query) is then performed.",[439,482,483],{},"Any A or AAAA records returned by the second query are then compared\nagainst the original IP address. If there is a match, FCrDNS passes.",[384,485,486],{"id":486},"iprev",[389,488,489],{},"The iprev results are added to the Authentication-Results header.",[389,491,492,497,502],{},[396,493,496],{"href":494,"rel":495},"http:\u002F\u002Fwww.ietf.org\u002Frfc\u002Frfc1912.txt",[400],"RFC 1912",[396,498,501],{"href":499,"rel":500},"http:\u002F\u002Fwww.ietf.org\u002Frfc\u002Frfc5451.txt",[400],"RFC 5451",[396,503,506],{"href":504,"rel":505},"http:\u002F\u002Ftools.ietf.org\u002Fhtml\u002Frfc7001#section-3",[400],"RFC 7001",[389,508,509],{},"2.6.3.  \"iprev\" Results",[389,511,512],{},"pass:  The DNS evaluation succeeded, i.e., the \"reverse\" and\n\"forward\" lookup results were returned and were in agreement.",[389,514,515],{},"fail:  The DNS evaluation failed.  In particular, the \"reverse\" and\n\"forward\" lookups each produced results, but they were not in\nagreement, or the \"forward\" query completed but produced no\nresult, e.g., a DNS RCODE of 3, commonly known as NXDOMAIN, or an\nRCODE of 0 (NOERROR) in a reply containing no answers, was\nreturned.",[389,517,518],{},"temperror:  The DNS evaluation could not be completed due to some\nerror that is likely transient in nature, such as a temporary DNS\nerror, e.g., a DNS RCODE of 2, commonly known as SERVFAIL, or\nother error condition resulted.  A later attempt may produce a\nfinal result.",[389,520,521],{},"permerror:  The DNS evaluation could not be completed because no PTR\ndata are published for the connecting IP address, e.g., a DNS\nRCODE of 3, commonly known as NXDOMAIN, or an RCODE of 0 (NOERROR)\nin a reply containing no answers, was returned.  This prevented\ncompletion of the evaluation.  A later attempt is unlikely to\nproduce a final result.",{"title":419,"searchDepth":523,"depth":523,"links":524},2,[525,526,527,528,529,530],{"id":386,"depth":523,"text":387},{"id":404,"depth":523,"text":405},{"id":422,"depth":523,"text":423},{"id":456,"depth":523,"text":457},{"id":463,"depth":523,"text":464},{"id":486,"depth":523,"text":486},"Haraka fcrdns plugin - Forward Confirmed Reverse DNS","md",null,{},{"title":205},{"title":379,"description":531},"EUBd_KX0o82cxfDrq3wC_FBq-5Ne2FCB9whjK5ChCA8",[539,541],{"title":201,"path":202,"stem":203,"description":540,"children":-1},"Haraka esets plugin - ESET Antivirus Plugin",{"title":209,"path":210,"stem":211,"description":542,"children":-1},"Haraka geoip plugin - GeoIP lookup",1794456866513]