em":352},"syslog","\u002Fplugins\u002Fsyslog","8.plugins\u002Fsyslog",{"title":354,"path":355,"stem":356},"tarpit","\u002Fplugins\u002Ftarpit","8.plugins\u002Ftarpit",{"title":358,"path":359,"stem":360},"tls","\u002Fplugins\u002Ftls","8.plugins\u002Ftls",{"title":362,"path":363,"stem":364},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":366,"path":367,"stem":368},"uribl","\u002Fplugins\u002Furibl","8.plugins\u002Furibl",{"title":370,"path":371,"stem":372},"watch","\u002Fplugins\u002Fwatch","8.plugins\u002Fwatch",{"title":374,"path":375,"stem":376},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":378,"title":379,"body":380,"description":435,"extension":436,"links":437,"meta":438,"navigation":439,"path":238,"seo":440,"stem":239,"__hash__":441},"docs\u002F8.plugins\u002Fmail_from.is_resolvable.md","mail_from.is_resolvable - Rejects messages with unresolvable mail_from domains",{"type":381,"value":382,"toc":430},"minimark",[383,387,392,395],[384,385,386],"p",{},"This plugin checks that the domain used in MAIL FROM is resolvable to an MX\nrecord.",[388,389,391],"h2",{"id":390},"configuration","Configuration",[384,393,394],{},"This plugin uses the INI-style file format and accepts the following options:",[396,397,398,409,419],"ul",{},[399,400,401,402,405,406,408],"li",{},"timeout",[403,404],"br",{},"Default: 30",[403,407],{},"Maximum limit in seconds for queries to complete.  If the timeout is\nreached a TEMPFAIL is returned to the client.",[399,410,411,412,416,418],{},"allow_mx_ip=",[413,414,415],"span",{},"0|1",[403,417],{},"Allow MX records that return IP addresses instead of hostnames.\nThis is not allowed as per the RFC, but some MTAs allow it.",[399,420,421,422,424,426,427,429],{},"reject_no_mx=",[413,423,415],{},[403,425],{},"Return DENY and reject the command if no MX record is found.  Otherwise a\nDENYSOFT (TEMPFAIL) is returned and the client will retry later.",[403,428],{},"DNS errors always return DENYSOFT, so this should be safe to enable.",{"title":431,"searchDepth":432,"depth":432,"links":433},"",2,[434],{"id":390,"depth":432,"text":391},"Haraka mail_from.is_resolvable plugin - Rejects messages with unresolvable mail_from domains","md",null,{},{"title":237},{"title":379,"description":435},"74WwI6xpxCNtGKWaPiNUSdNszV4O5uPSBjRfyM8Ajnk",[443,445],{"title":233,"path":234,"stem":235,"description":444,"children":-1},"Haraka limit plugin - Limits the number of messages per connection",{"title":241,"path":242,"stem":243,"description":446,"children":-1},"Haraka messagesniffer plugin - Message Sniffer",1794456871745]