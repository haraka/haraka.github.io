[{"data":1,"prerenderedAt":866},["ShallowReactive",2],{"navigation_docs":3,"-plugins-karma":377,"-plugins-karma-surround":861},[4,8,12,16,20,86,103],{"title":5,"path":6,"stem":7},"Getting Started","\u002Fgetting_started","1.getting_started",{"title":9,"path":10,"stem":11},"About","\u002Fabout","2.about",{"title":13,"path":14,"stem":15},"Community","\u002Fcommunity","3.community",{"title":17,"path":18,"stem":19},"Known Users","\u002Fusers","5.users",{"title":21,"path":22,"stem":23,"children":24,"page":85},"Core","\u002Fcore","6.core",[25,29,33,37,41,45,49,53,57,61,65,69,73,77,81],{"title":26,"path":27,"stem":28},"Address Object","\u002Fcore\u002FAddress","6.core\u002F1.Address",{"title":30,"path":31,"stem":32},"Net_Utils","\u002Fcore\u002FNet_Utils","6.core\u002F10.Net_Utils",{"title":34,"path":35,"stem":36},"Logging","\u002Fcore\u002FLogging","6.core\u002F11.Logging",{"title":38,"path":39,"stem":40},"Outbound","\u002Fcore\u002FOutbound","6.core\u002F12.Outbound",{"title":42,"path":43,"stem":44},"Plugins","\u002Fcore\u002FPlugins","6.core\u002F13.Plugins",{"title":46,"path":47,"stem":48},"Results","\u002Fcore\u002FResults","6.core\u002F14.Results",{"title":50,"path":51,"stem":52},"Transaction Object","\u002Fcore\u002FTransaction","6.core\u002F15.Transaction",{"title":54,"path":55,"stem":56},"Body Object","\u002Fcore\u002FBody","6.core\u002F2.Body",{"title":58,"path":59,"stem":60},"Config","\u002Fcore\u002FConfig","6.core\u002F3.Config",{"title":62,"path":63,"stem":64},"Connection Object","\u002Fcore\u002FConnection","6.core\u002F4.Connection",{"title":66,"path":67,"stem":68},"Core Configuration Files","\u002Fcore\u002FCoreConfig","6.core\u002F5.CoreConfig",{"title":70,"path":71,"stem":72},"Custom Return Codes","\u002Fcore\u002FCustomReturnCodes","6.core\u002F6.CustomReturnCodes",{"title":74,"path":75,"stem":76},"HAProxy","\u002Fcore\u002FHAProxy","6.core\u002F7.HAProxy",{"title":78,"path":79,"stem":80},"Logging API","\u002Fcore\u002FLogging_API","6.core\u002F8.Loggin