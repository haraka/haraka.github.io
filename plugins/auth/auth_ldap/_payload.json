"\u002Fplugins\u002Fsyslog","8.plugins\u002Fsyslog",{"title":354,"path":355,"stem":356},"tarpit","\u002Fplugins\u002Ftarpit","8.plugins\u002Ftarpit",{"title":358,"path":359,"stem":360},"tls","\u002Fplugins\u002Ftls","8.plugins\u002Ftls",{"title":362,"path":363,"stem":364},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":366,"path":367,"stem":368},"uribl","\u002Fplugins\u002Furibl","8.plugins\u002Furibl",{"title":370,"path":371,"stem":372},"watch","\u002Fplugins\u002Fwatch","8.plugins\u002Fwatch",{"title":374,"path":375,"stem":376},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":378,"title":379,"body":380,"description":462,"extension":463,"links":464,"meta":465,"navigation":466,"path":134,"seo":467,"stem":135,"__hash__":468},"docs\u002F8.plugins\u002Fauth\u002Fauth_ldap.md","auth\u002Fauth_ldap - Authenticate users against an LDAP server",{"type":381,"value":382,"toc":458},"minimark",[383,391,396,403,414,421,431,434,440,450,452],[384,385,386,387,390],"p",{},"The ",[388,389,133],"code",{}," plugin uses an LDAP bind to authenticate a user. Currently\nonly one server and multiple DNs can be configured. If any of the DN binds succeed,\nthe user is authenticated.",[392,393,395],"h2",{"id":394},"configuration","Configuration",[384,397,398,399,402],{},"Configuration is stored in ",[388,400,401],{},"config\u002Fauth_ldap.ini"," and uses the INI\nstyle formatting.",[384,404,405,406,409,410,413],{},"Only the ",[388,407,408],{},"LOGIN"," authentication method is supported assuming that passwords in the\nLDAP database are not stored in cleartext (which would allow for CRAM-MD5). Note\nthat this means passwords will be sent in the clear to the LDAP server unless\nan ",[388,411,412],{},"ldaps:\u002F\u002F"," conection is used.",[384,415,416,417,420],{},"Current configuration options in ",[388,418,419],{},"[core]"," are:",[422,423,428],"pre",{"className":424,"code":426,"language":427},[425],"language-text","server - the url of the LDAP server (ldap:\u002F\u002F or ldaps:\u002F\u002F)\ntimeout - time in miliseconds to wait for the server resonse before giving up\nrejectUnauthorized - boolean (true or false) as to whether to reject connections\n    not verified against a CA. Meaning, a \"false\" allows non-verified.  \n","text",[388,429,426],{"__ignoreMap":430},"",[384,432,433],{},"Example:",[422,435,438],{"className":436,"code":437,"language":427},[425],"[core]\nserver=ldaps:\u002F\u002Fldap.opoet.com\ntimeout=5000\nrejectUnauthorized=false  \n",[388,439,437],{"__ignoreMap":430},[384,441,386,442,445,446,449],{},[388,443,444],{},"[dns]"," section (that is plural DN and not domain name system), is a list of DNs to use\nto bind. The ",[388,447,448],{},"%u"," in the strings is substituted with the user name used in the SMTP\nauthentication. Note that the keys have no meaning and the DNs are tried in series until\nthe first successful bind. The LDAP RFC does not allow for parallel binds on a connection,\nso it is suggested that the most commonly used DN be placed earlier in the list.",[384,451,433],{},[422,453,456],{"className":454,"code":455,"language":427},[425],"[dns]\ndn1=uid=%u,ou=Users,dc=opoet,dc=com\ndn2=uid=%u,ou=people,dc=opoet,dc=com \n",[388,457,455],{"__ignoreMap":430},{"title":430,"searchDepth":459,"depth":459,"links":460},2,[461],{"id":394,"depth":459,"text":395},"Haraka auth\u002Fauth_ldap plugin - Authenticate users against an LDAP server","md",null,{},{"title":133},{"title":379,"description":462},"FA8M45sWHdeeuWvxsNwBDYCAKwyOW7Z0WHt_rh618TA",[470,472],{"title":129,"path":130,"stem":131,"description":471,"children":-1},"Haraka auth\u002Fauth_bridge plugin - Authenticate users against an external service",{"title":137,"path":138,"stem":139,"description":473,"children":-1},"Haraka auth\u002Fauth_proxy plugin - Authenticate users against an external service",1794456873339]