\u002Ftls",{"title":210,"path":211,"stem":212},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":214,"path":215,"stem":216},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":218,"title":219,"body":220,"description":328,"extension":329,"links":330,"meta":331,"navigation":332,"path":126,"seo":333,"stem":127,"__hash__":334},"docs\u002F8.plugins\u002Fauth\u002Fflat_file.md","auth\u002Fflat_file - Authenticate users against a flat file",{"type":221,"value":222,"toc":324},"minimark",[223,231,234,249,255,260,267,296,299,309,316,318],[224,225,226,227,230],"p",{},"The ",[228,229,125],"code",{}," plugin allows you to create a file containing username\nand password combinations, and have relaying users authenticate from that\nfile.",[224,232,233],{},"Note that passwords are stored in clear-text, so this may not be a great idea\nfor large scale systems. However the plugin would be a good start for someone\nlooking to implement authentication using some other form of auth.",[224,235,236,240,241,248],{},[237,238,239],"strong",{},"Security"," - it is recommended to switch to ",[242,243,247],"a",{"href":244,"rel":245},"https:\u002F\u002Fgithub.com\u002FAuspeXeu\u002Fharaka-plugin-auth-enc-file",[246],"nofollow","auth-encfile","\nto protect your user credentials.",[224,250,251,254],{},[237,252,253],{},"IMPORANT NOTE"," - this plugin requires that STARTTLS be used via the tls plugin\nbefore it will advertise AUTH capabilities by the EHLO command.  This is to\nimprove security out-of-the-box.   Localhost and any IP in RFC1918 ranges\nare automatically exempt from this rule.",[256,257,259],"h2",{"id":258},"configuration","Configuration",[224,261,262,263,266],{},"Configuration is stored in ",[228,264,265],{},"config\u002Fauth_flat_file.ini"," and uses the INI\nstyle formatting.",[224,268,269,270,273,274,277,278,281,282,285,286,289,290,292,293,295],{},"Authentication methods are listed in the ",[228,271,272],{},"[core]"," section under ",[228,275,276],{},"methods","\nparameter. Lists of authentification methods are comma separated. Currently\nsupported methods are: ",[228,279,280],{},"CRAM-MD5",", ",[228,283,284],{},"PLAIN"," and ",[228,287,288],{},"LOGIN",". The ",[228,291,284],{},"\nand ",[228,294,288],{}," methods are not secure. That is why TLS is required before AUTH is\noffered.",[224,297,298],{},"Example:",[300,301,306],"pre",{"className":302,"code":304,"language":305},[303],"language-text","[core]\nmethods=PLAIN,LOGIN,CRAM-MD5\n","text",[228,307,304],{"__ignoreMap":308},"",[224,310,311,312,315],{},"Users are stored in the ",[228,313,314],{},"[users]"," section.",[224,317,298],{},[300,319,322],{"className":320,"code":321,"language":305},[303],"[users]\nuser1=password1\nuser@domain.com=password2\n",[228,323,321],{"__ignoreMap":308},{"title":308,"searchDepth":325,"depth":325,"links":326},2,[327],{"id":258,"depth":325,"text":259},"Haraka auth\u002Fflat_file plugin - Authenticate users against a flat file","md",null,{},{"title":125},{"title":219,"description":328},"ehbPndhN9XMcAMYpTemA1WLzvGysS3m2hXs-x7VMuzY",[336,338],{"title":121,"path":122,"stem":123,"description":337,"children":-1},"Haraka auth\u002Fauth_vpopmaild plugin - Authenticate users against vpopmaild",{"title":129,"path":130,"stem":131,"description":339,"children":-1},"Haraka block_me plugin - Blocks mail from a specific IP address",1794458077929]