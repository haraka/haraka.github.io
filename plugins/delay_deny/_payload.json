s",{"title":210,"path":211,"stem":212},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":214,"path":215,"stem":216},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":218,"title":219,"body":220,"description":267,"extension":268,"links":269,"meta":270,"navigation":271,"path":138,"seo":272,"stem":139,"__hash__":273},"docs\u002F8.plugins\u002Fdelay_deny.md","delay_deny - Connection Delays plugin for Haraka",{"type":221,"value":222,"toc":258},"minimark",[223,227,232,235,238,243,251,255],[224,225,226],"p",{},"Delays all pre-DATA 'deny' results until the recipients are sent\nand all post-DATA commands until all hook_data_post plugins have run.\nThis allows relays and authenticated users to bypass pre-DATA rejections.",[228,229,231],"h2",{"id":230},"configuration","Configuration",[224,233,234],{},"Configuration options are in config\u002Fdelay_deny.ini.",[224,236,237],{},"This plugin operates in one of two modes: included and excluded.",[239,240,242],"h3",{"id":241},"included-plugins","included plugins",[224,244,245,246,250],{},"A comma or semicolon separated list of denials that are to be included.\nIn this mode, ",[247,248,249],"em",{},"only"," plugins in the list are bypassed. All other plugins\ncan immediately reject connections.",[239,252,254],{"id":253},"excluded-plugins","excluded plugins",[224,256,257],{},"A comma or semicolon separated list of denials that are to be excluded.\nExcluded plugins that are not bypassed and can still immediately reject\nconnections.",{"title":259,"searchDepth":260,"depth":260,"links":261},"",2,[262],{"id":230,"depth":260,"text":231,"children":263},[264,266],{"id":241,"depth":265,"text":242},3,{"id":253,"depth":265,"text":254},"Haraka delay_deny plugin - Connection Delays","md",null,{},{"title":137},{"title":219,"description":267},"gp8fS1MIb4UF6yMPxKeP0p2suKxI4ZVHnuW01CrpA6w",[275,277],{"title":133,"path":134,"stem":135,"description":276,"children":-1},"Haraka data.signatures plugin - Signatures