ueue\u002Frabbitmq_amqplib","\u002Fplugins\u002Fqueue\u002Frabbitmq_amqplib","8.plugins\u002Fqueue\u002Frabbitmq_amqplib",{"title":290,"path":291,"stem":292},"queue\u002Fsmtp_bridge","\u002Fplugins\u002Fqueue\u002Fsmtp_bridge","8.plugins\u002Fqueue\u002Fsmtp_bridge",{"title":294,"path":295,"stem":296},"queue\u002Fsmtp_forward","\u002Fplugins\u002Fqueue\u002Fsmtp_forward","8.plugins\u002Fqueue\u002Fsmtp_forward",{"title":298,"path":299,"stem":300},"queue\u002Fsmtp_proxy","\u002Fplugins\u002Fqueue\u002Fsmtp_proxy","8.plugins\u002Fqueue\u002Fsmtp_proxy",{"title":302,"path":303,"stem":304},"rcpt_to.in_host_list","\u002Fplugins\u002Frcpt_to.in_host_list","8.plugins\u002Frcpt_to.in_host_list",{"title":306,"path":307,"stem":308},"rcpt_to.ldap.js","\u002Fplugins\u002Frcpt_to.ldap","8.plugins\u002Frcpt_to.ldap",{"title":310,"path":311,"stem":312},"rcpt_to.qmail_deliverable","\u002Fplugins\u002Frcpt_to.qmail_deliverable","8.plugins\u002Frcpt_to.qmail_deliverable",{"title":314,"path":315,"stem":316},"rcpt_to.routes","\u002Fplugins\u002Frcpt_to.routes","8.plugins\u002Frcpt_to.routes",{"title":318,"path":319,"stem":320},"record_envelope_addresses","\u002Fplugins\u002Frecord_envelope_addresses","8.plugins\u002Frecord_envelope_addresses",{"title":322,"path":323,"stem":324},"redis","\u002Fplugins\u002Fredis","8.plugins\u002Fredis",{"title":326,"path":327,"stem":328},"relay","\u002Fplugins\u002Frelay","8.plugins\u002Frelay",{"title":330,"path":331,"stem":332},"reseed_rng","\u002Fplugins\u002Freseed_rng","8.plugins\u002Freseed_rng",{"title":334,"path":335,"stem":336},"rspamd","\u002Fplugins\u002Frspamd","8.plugins\u002Frspamd",{"title":338,"path":339,"stem":340},"spamassassin","\u002Fplugins\u002Fspamassassin","8.plugins\u002Fspamassassin",{"title":342,"path":343,"stem":344},"spf","\u002Fplugins\u002Fspf","8.plugins\u002Fspf",{"title":346,"path":347,"stem":348},"status","\u002Fplugins\u002Fstatus","8.plugins\u002Fstatus",{"title":350,"path":351,"stem":352},"syslog","\u002Fplugins\u002Fsyslog","8.plugins\u002Fsyslog",{"title":354,"path":355,"stem":356},"tarpit","\u002Fplugins\u002Ftarpit","8.plugins\u002Ftarpit",{"title":358,"path":359,"stem":360},"tls","\u002Fplugins\u002Ftls","8.plugins\u002Ftls",{"title":362,"path":363,"stem":364},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":366,"path":367,"stem":368},"uribl","\u002Fplugins\u002Furibl","8.plugins\u002Furibl",{"title":370,"path":371,"stem":372},"watch","\u002Fplugins\u002Fwatch","8.plugins\u002Fwatch",{"title":374,"path":375,"stem":376},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":378,"title":379,"body":380,"description":743,"extension":744,"links":745,"meta":746,"navigation":747,"path":327,"seo":748,"stem":328,"__hash__":749},"docs\u002F8.plugins\u002Frelay.md","relay - Relay outbound mail",{"type":381,"value":382,"toc":731},"minimark",[383,404,423,429,434,447,457,460,466,491,495,502,508,511,524,531,537,550,556,564,570,576,579,586,593,599,604,611,618,621,627,631,634,640,642,648,668,674,676,682,692,698,701,704,709,715,718,725,728],[384,385,386,393,394,398,399,403],"p",{},[387,388,392],"a",{"href":389,"rel":390},"http:\u002F\u002Fen.wikipedia.org\u002Fwiki\u002FMail_transfer_agent",[391],"nofollow","MTAs"," generally only accept mail for ",[395,396,397],"em",{},"local"," domains they can deliver to. In Haraka, the ",[400,401,402],"code",{},"rcpt_to.*"," plugins usually decide which domains and\u002For email addresses are deliverable. By default, everything else is rejected.",[384,405,406,410,411,416,417,422],{},[407,408,409],"strong",{},"Relaying"," is when a MTA accepts mail that is destined elsewhere. Back in the day (1980s), most MTAs permitted open relaying. Soon spammers abused our open relays (1990s) and left us with soiled mail queues. Now nearly all MTAs have relaying disabled and ",[387,412,415],{"href":413,"rel":414},"http:\u002F\u002Fen.wikipedia.org\u002Fwiki\u002FMail_user_agent",[391],"MUAs"," are required to use a ",[387,418,421],{"href":419,"rel":420},"http:\u002F\u002Fen.wikipedia.org\u002Fwiki\u002FMessage_submission_agent",[391],"MSA"," to relay. Most MTAs (including Haraka) have MSA features and can serve both purposes.",[384,424,425,426,428],{},"This ",[407,427,326],{}," plugin provides Haraka with options for managing relay permissions.",[430,431,433],"h2",{"id":432},"authentication","Authentication",[384,435,436,437,439,440,443,444,446],{},"One way to enable relaying is ",[387,438,432],{"href":43}," via the auth plugins. Successful authentication enables relaying during ",[395,441,442],{},"that"," SMTP connection. To securely offer SMTP AUTH, the ",[387,445,358],{"href":359}," plugin and at least one auth plugin must be enabled and properly configured. When that requirement is met, the AUTH SMTP extension will be advertised to SMTP clients.",[448,449,454],"pre",{"className":450,"code":452,"language":453},[451],"language-text","% nc mail.example.com 587\n220 mail.example.com ESMTP Haraka 2.4.0 ready\nehlo client.example.com\n250-mail.example.com Hello client.example.com [192.168.0.1], Haraka is at your service.\n250-PIPELINING\n250-8BITMIME\n250-SIZE 10000000\n250 STARTTLS\nquit\n221 mail.example.com closing connection. Have a jolly good day.\n","text",[400,455,452],{"__ignoreMap":456},"",[384,458,459],{},"Notice that there's no AUTH advertised. We only permit authentication when the\nconnection is secured with TLS:",[448,461,464],{"className":462,"code":463,"language":453,"meta":456},[451],"% openssl s_client -connect mail.example.com:587 -starttls smtp\nCONNECTED(00000003)\n\u003Csnip long SSL certificate details>\n---\n250 STARTTLS\nehlo client.example.com\n250-mail.example.com Hello client.example.com [192.168.1.1], Haraka is at your service.\n250-PIPELINING\n250-8BITMIME\n250-SIZE 10000000\n250 AUTH PLAIN LOGIN\nquit\n221 mail.example.com closing connection. Have a jolly good day.\nclosed\n",[400,465,463],{"__ignoreMap":456},[384,467,468,469,474,475,480,481,486,487,490],{},"To avoid port 25 restrictions, in 1998 we developed ",[387,470,473],{"href":471,"rel":472},"http:\u002F\u002Ftools.ietf.org\u002Fhtml\u002Frfc2476",[391],"SMTP submission"," on port 587. As of January 2018, ",[387,476,479],{"href":477,"rel":478},"https:\u002F\u002Ftools.ietf.org\u002Fhtml\u002Frfc8314",[391],"RFC 8314"," resurrects ",[387,482,485],{"href":483,"rel":484},"https:\u002F\u002Fen.wikipedia.org\u002Fwiki\u002FSMTPS",[391],"SMTPS"," on port 465 in favor of port 587 with STARTTLS. For optimal security and reliability, ",[387,488,415],{"href":413,"rel":489},[391]," should be configured to send mail to port 465 with TLS.",[430,492,494],{"id":493},"acl-access-control-list","ACL (Access Control List)",[384,496,497,498,501],{},"ACL processing is enabled by setting acl=true in the ",[499,500,326],"span",{}," section of\nrelay.ini:",[448,503,506],{"className":504,"code":505,"language":453},[451],"[relay]\nacl=true\n",[400,507,505],{"__ignoreMap":456},[384,509,510],{},"With the Access Control List feature, relaying can be enabled for IPv4 and\nIPv6 networks. IP ranges listed in the ACL file are allowed to send mails\nwithout furthur checks.",[512,513,514],"ul",{},[515,516,517,520,523],"li",{},[400,518,519],{},"config\u002Frelay_acl_allow",[521,522],"br",{},"Allowed IP ranges in CIDR notation, one per line.",[384,525,526,527,530],{},"Back in the day, ISPs enabled all of their IP space to relay. That proved\nproblematic for users who took their laptops and mobile phones elsewhere and\nthen couldn't send mail. For end users therefore, use SMTP AUTH described\nabove. If you reside somewhere technology evolves more slowly, you can still\nadd IP allocations to ",[400,528,529],{},"relay_acl_allow"," like so:",[448,532,535],{"className":533,"code":534,"language":453},[451],"echo 'N.N.N.N\u002F24' >> \u002Fpath\u002Fto\u002Fharaka\u002Fconfig\u002Frelay_acl_allow\n",[400,536,534],{"__ignoreMap":456},[384,538,539,540,542,543,546,547,549],{},"A common use case for IP based relaying is to relay messages on behalf of\nanother mail server. If your organization has an Exchange server, using Haraka\nto filter inbound messages is a great choice. You might also want to relay\noutbound messages via Haraka as well, so they can be DKIM signed on their way\nto the internet. For such a use case, you would set 'acl=true' (the default)\nin the ",[499,541,326],{}," section of ",[400,544,545],{},"relay.ini"," and then add the external IP address\nof the corporate firewall to ",[400,548,519],{},":",[448,551,554],{"className":552,"code":553,"language":453},[451],"echo 'N.N.N.N\u002F32' >> \u002Fpath\u002Fto\u002Fharaka\u002Fconfig\u002Frelay_acl_allow\n",[400,555,553],{"__ignoreMap":456},[430,557,559,560,563],{"id":558},"force-route-destination-domains","Force Route \u002F Dest",[499,561,562],{},"ination"," Domains",[384,565,566,567,569],{},"Force routes and Destination Domains are enabled by setting in the ",[499,568,326],{},"\nsection of relay.ini:",[448,571,574],{"className":572,"code":573,"language":453},[451],"[relay]\nforce_routing=false  (default: false)\ndest_domains=false   (default: false)\n",[400,575,573],{"__ignoreMap":456},[384,577,578],{},"These two features share another common config file:",[512,580,581],{},[515,582,583],{},[400,584,585],{},"config\u002Frelay_dest_domains.ini",[384,587,588,589,592],{},"The format is ini and entries are within the ",[499,590,591],{},"domains"," section. The key for each entry is the domain and the value is a JSON string. Within the JSON string, the currently supported keys are:",[448,594,597],{"className":595,"code":596,"language":453},[451],"* action  (Dest Domains)\n* nexthop (Force Route)\n",[400,598,596],{"__ignoreMap":456},[600,601,603],"h3",{"id":602},"force-route","Force Route",[384,605,606,607,610],{},"Think of force route as the equivalent of the transport map in Postfix or the smtproutes file in Qmail. Rather than looking up the MX for a host, the ",[395,608,609],{},"nexthop"," value from the entry in the config file is used.",[384,612,613,614,617],{},"The value of \"nexthop\": can be a hostname or an IP, optionally follow by ",[615,616],"port",{},".",[384,619,620],{},"Example:",[448,622,625],{"className":623,"code":624,"language":453},[451],"[domains]\ntest.com = { \"action\": \"continue\", \"nexthop\": \"127.0.0.1:2525\" }\n",[400,626,624],{"__ignoreMap":456},[600,628,630],{"id":629},"destination-domains","Destination Domains",[384,632,633],{},"Allowed destination\u002Frecipient domains. The field within the JSON value used\nby Dest Domains is \"action\": and the possible values are accept, continue, or\ndeny.",[448,635,638],{"className":636,"code":637,"language":453},[451],"* accept   (accept the mail without further checks)\n",[400,639,637],{"__ignoreMap":456},[384,641,620],{},[448,643,646],{"className":644,"code":645,"language":453},[451],"[domains]\ntest.com = { \"action\": \"accept\" }\n",[400,647,645],{"__ignoreMap":456},[384,649,650,651,654,655,658,659,661,662,664,665,667],{},"I think of ",[395,652,653],{},"accept"," as the equivalent of qmail's ",[395,656,657],{},"rcpthosts",", or a misplaced Haraka ",[400,660,402],{}," plugin. The ",[395,663,653],{}," mechanism is another way to tell Haraka that a particular domain is one we accept mail for. The difference between this and the ",[387,666,302],{"href":303}," plugin is that this one also enables relaying.",[448,669,672],{"className":670,"code":671,"language":453},[451],"* continue (mails are subject to further checks)\n",[400,673,671],{"__ignoreMap":456},[384,675,620],{},[448,677,680],{"className":678,"code":679,"language":453},[451],"[domains]\ntest.com = { \"action\": \"continue\" }\n",[400,681,679],{"__ignoreMap":456},[384,683,684,685,688,689,691],{},"Because the default behavior of Dest Routes is to deny, the ",[395,686,687],{},"continue"," option provides an escape, permitting another Haraka plugin to validate the recipient. Like the ",[395,690,653],{}," option, it too enables relaying.",[448,693,696],{"className":694,"code":695,"language":453},[451],"* deny    (mails are rejected)\n",[400,697,695],{"__ignoreMap":456},[384,699,700],{},"This deny option baffles me. The default behavior of Haraka is to reject emails for\nwhich a recipient validation plugin hasn't vouched. Adding it here prevents\nany subsequent recipient validation plugin from getting a chance. It also\nnecessitates the continue option.",[430,702,703],{"id":703},"all",[384,705,706,707,501],{},"Relay all is enabled by setting all=true in the ",[499,708,326],{},[448,710,713],{"className":711,"code":712,"language":453},[451],"[relay]\nall=true     (default: false)\n",[400,714,712],{"__ignoreMap":456},[384,716,717],{},"Relay all is useful for spamtraps to accept all mail.",[384,719,720,721,724],{},"Do NOT use this on a real mail server, unless you really know what you are\ndoing. If you use the all feature with anything that relays mail (such\nas forwarding to a real mail server, or the ",[400,722,723],{},"deliver"," plugin), your mail\nserver is now an open relay.",[384,726,727],{},"This is BAD. Hence the big letters. In short: DO NOT USE THIS FEATURE.",[384,729,730],{},"It is useful for testing and spamtraps, hence its presence.",{"title":456,"searchDepth":732,"depth":732,"links":733},2,[734,735,736,742],{"id":432,"depth":732,"text":433},{"id":493,"depth":732,"text":494},{"id":558,"depth":732,"text":737,"children":738},"Force Route \u002F Destination Domains",[739,741],{"id":602,"depth":740,"text":603},3,{"id":629,"depth":740,"text":630},{"id":703,"depth":732,"text":703},"Haraka relay plugin - Relay outbound mail","md",null,{},{"title":326},{"title":379,"description":743},"ws_r5itaZu_78zdXE5eGhJEhu0MHXH4OOG5Y1RxxBRU",[751,753],{"title":322,"path":323,"stem":324,"description":752,"children":-1},"Haraka redis plugin - Redis plugin",{"title":330,"path":331,"stem":332,"description":754,"children":-1},"Haraka reseed_rng plugin - Reseed the random number generator",1794456872457]