2Fsyslog","8.plugins\u002Fsyslog",{"title":354,"path":355,"stem":356},"tarpit","\u002Fplugins\u002Ftarpit","8.plugins\u002Ftarpit",{"title":358,"path":359,"stem":360},"tls","\u002Fplugins\u002Ftls","8.plugins\u002Ftls",{"title":362,"path":363,"stem":364},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":366,"path":367,"stem":368},"uribl","\u002Fplugins\u002Furibl","8.plugins\u002Furibl",{"title":370,"path":371,"stem":372},"watch","\u002Fplugins\u002Fwatch","8.plugins\u002Fwatch",{"title":374,"path":375,"stem":376},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":378,"title":379,"body":380,"description":572,"extension":573,"links":574,"meta":575,"navigation":576,"path":367,"seo":577,"stem":368,"__hash__":578},"docs\u002F8.plugins\u002Furibl.md","uribl - URI Blacklists plugin for Haraka",{"type":381,"value":382,"toc":566},"minimark",[383,412,415,420,423,426,429,455,458,461,505,508,554,558],[384,385,386,387,394,395,400,401,394,406,411],"p",{},"This plugin extracts URIs and feeds them to RHS based blacklists such as\n",[388,389,393],"a",{"href":390,"rel":391},"http:\u002F\u002Fwww.spamhaus.org\u002Fdbl",[392],"nofollow","DBL"," and ",[388,396,399],{"href":397,"rel":398},"http:\u002F\u002Fspameatingmonkey.com\u002Flists.html#SEM-FRESH",[392],"SEM-FRESH"," and body URI based DNS blacklists such as\n",[388,402,405],{"href":403,"rel":404},"http:\u002F\u002Fwww.surbl.org\u002F",[392],"SURBL",[388,407,410],{"href":408,"rel":409},"http:\u002F\u002Fwww.uribl.com\u002F",[392],"URIBL",".",[384,413,414],{},"This plugin will discard any domain name that does not have a valid TLD\nor any IP address within RFC1918, 127\u002F8 or 169.254\u002F16 (APIPA) and will\nconvert any URI ending in in-addr.arpa into an IP address lookup.",[416,417,419],"h2",{"id":418},"configuration","Configuration",[384,421,422],{},"This plugin reads configuration from uribl.ini.",[384,424,425],{},"The main section defines global settings for all lists and the blacklists\nzones are specified as INI section headings with the configuration for\neach zone within that section.",[384,427,428],{},"The main section can contain the following options:",[430,431,432,443],"ul",{},[433,434,435,436,439,440,442],"li",{},"timeout",[437,438],"br",{},"Default: 30",[437,441],{},"The total timeout in seconds for each group of lookups.  Any group of\nlookups that takes longer than this will be aborted and the session\nwill continue.",[433,444,445,446,448,449,451,452,454],{},"max_uris_per_list",[437,447],{},"Default: 20",[437,450],{},"This option limits the maximum number of unique lookups that will be\nsubmitted for each list after the input has been normalized into the\nquery format required for the list.",[437,453],{},"\nAny lookups greater than the limit will be discarded.",[384,456,457],{},"List sections should be named as the zone of the blacklist and can\ncontain the following options:",[384,459,460],{},"At least one of the following must be set for any queries to be run for\nthe blacklist.",[430,462,463,469,475,481,487,493,499],{},[433,464,465,466,468],{},"rdns = 1 | true | yes | on | enabled",[437,467],{},"Check any rDNS names against the list.",[433,470,471,472,474],{},"helo = 1 | true | yes | on | enabled",[437,473],{},"Check the EHLO\u002FHELO argument against the list.",[433,476,477,478,480],{},"envfrom = 1 | true | yes | on | enabled",[437,479],{},"Check the MAIL FROM domain against the list.",[433,482,483,484,486],{},"from = 1 | true | yes | on | enabled",[437,485],{},"Check the domain portion of the From: header against the list.",[433,488,489,490,492],{},"replyto = 1 | true | yes | on | enabled",[437,491],{},"Check the domain portion of the Reply-To: header against the list.",[433,494,495,496,498],{},"msgid = 1 | true | yes | on | enabled",[437,497],{},"Check the RHS of the Message-Id: header against the list.",[433,500,501,502,504],{},"body = 1 | true | yes | on | enabled",[437,503],{},"Check any URIs found within the body of the message against the list.",[384,506,507],{},"The following are optional for each list:",[430,509,510,516,522,535,541],{},[433,511,512,513,515],{},"custom_msg",[437,514],{},"A custom rejection message that will be returned to the SMTP client\nif the list returns a positive result.  If found within the string\n{uri} will be replaced by the URI value looked up and {zone} will\nbe replaced by the blacklist zone name.",[433,517,518,519,521],{},"validate",[437,520],{},"A regular expression that will be tested against the first A record\nreturned by the list.  If it does not evaluate to true then the positive\nresult will be discarded.  Example: ^(?!127.0.1.255)127. would check\nthat the IP address returned start with 127. and is not 127.0.1.255",[433,523,524,525,527,528,394,531,534],{},"bitmask",[437,526],{},"This is optionally used for lists such as ",[388,529,405],{"href":403,"rel":530},[392],[388,532,410],{"href":408,"rel":533},[392]," that\nreturn bitmask values in the last octet of the returned IP address to\ncombine multiple lists into a single zone.  Using this you may specify\nwhich lists within the zone you want use.",[433,536,537,538,540],{},"no_ip_lookups = 1 | true | yes | on | enabled",[437,539],{},"Specifies that no IP addresses should ever be check against this list.\nThis is required for dbl.spamhaus.org.",[433,542,543,544,546,547,394,550,553],{},"strip_to_domain= 1 | true | yes | on | enabled",[437,545],{},"Specifies that the list requires hostnames be stripped down to the\ndomain boundaries prior to querying the list.  This is required for\nthe ",[388,548,405],{"href":403,"rel":549},[392],[388,551,410],{"href":408,"rel":552},[392]," lists.",[416,555,557],{"id":556},"other-files","Other files",[430,559,560],{},[433,561,562,563,565],{},"uribl.excludes",[437,564],{},"This contains a list of domains that should never be looked up in\nany blacklist as they are known good and will never be listed.\nThis helps to keep useless queries to a minimum.",{"title":567,"searchDepth":568,"depth":568,"links":569},"",2,[570,571],{"id":418,"depth":568,"text":419},{"id":556,"depth":568,"text":557},"Haraka uribl plugin - URI Blacklists","md",null,{},{"title":366},{"title":379,"description":572},"2kw_FH6N05IuO7nS71xmXCTGoRIDWhnAYaSebqq9TFw",[580,582],{"title":362,"path":363,"stem":364,"description":581,"children":-1},"Haraka toobusy plugin - Reject connections when the server is too busy",{"title":370,"path":371,"stem":372,"description":583,"children":-1},"Haraka watch plugin - smtp connections in HTTP browser",1794456866513]