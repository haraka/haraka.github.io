syslog","8.plugins\u002Fsyslog",{"title":354,"path":355,"stem":356},"tarpit","\u002Fplugins\u002Ftarpit","8.plugins\u002Ftarpit",{"title":358,"path":359,"stem":360},"tls","\u002Fplugins\u002Ftls","8.plugins\u002Ftls",{"title":362,"path":363,"stem":364},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":366,"path":367,"stem":368},"uribl","\u002Fplugins\u002Furibl","8.plugins\u002Furibl",{"title":370,"path":371,"stem":372},"watch","\u002Fplugins\u002Fwatch","8.plugins\u002Fwatch",{"title":374,"path":375,"stem":376},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":378,"title":379,"body":380,"description":1004,"extension":1005,"links":1006,"meta":1007,"navigation":1008,"path":343,"seo":1009,"stem":344,"__hash__":1010},"docs\u002F8.plugins\u002Fspf.md","spf - SPF plugin for Haraka",{"type":381,"value":382,"toc":995},"minimark",[383,395,407,412,415,418,441,444,452,455,458,516,523,556,561,604,608,866,870,873,876,932,935,977,984,988,991],[384,385,386,387,394],"p",{},"This plugin implements RFC 4408 Sender Policy Framework (SPF)\nSee the ",[388,389,393],"a",{"href":390,"rel":391},"http:\u002F\u002Fen.wikipedia.org\u002Fwiki\u002FSender_Policy_Framework",[392],"nofollow","Wikipedia article on SPF"," for details.",[384,396,397,398,402,403,406],{},"By default this plugin with only add trace Received-SPF headers to a message.\nTo make it reject mail then you will need to enable the relevant options below.\n",[399,400,401],"code",{},"[deny]helo_fail"," and ",[399,404,405],{},"[deny]mfrom_fail"," are the closest match for the intent\nof SPF but you will need to whitelist any hosts forwarding mail from another\ndomain whilst preserving the original return-path.",[408,409,411],"h2",{"id":410},"configuration","Configuration",[413,414],"hr",{},[384,416,417],{},"This plugin uses spf.ini for configuration and the following options are\navailable:",[419,420,425],"pre",{"className":421,"code":422,"language":423,"meta":424,"style":424},"language-ini shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","[relay]\ncontext=sender   (default: sender)\n","ini","",[399,426,427,435],{"__ignoreMap":424},[428,429,432],"span",{"class":430,"line":431},"line",1,[428,433,434],{},"[relay]\n",[428,436,438],{"class":430,"line":437},2,[428,439,440],{},"context=sender   (default: sender)\n",[384,442,443],{},"On connections with relaying privileges (MSA or mail relay), it is often\ndesirable to evaluate SPF from the context of Haraka's public IP(s), in the\nsame fashion the next mail server will evaluate it when we send to them.\nIn that use case, Haraka should use context=myself.",[419,445,450],{"className":446,"code":448,"language":449},[447],"language-text","* context=sender    evaluate SPF based on the sender (connection.remote.ip)\n* context=myself    evaluate SPF based on Haraka's public IP\n","text",[399,451,448],{"__ignoreMap":424},[384,453,454],{},"The rest of the optional settings (disabled by default) permit deferring or\ndenying mail from senders whose SPF fails the checks.",[384,456,457],{},"Additional settings allow you to control the small things (defaults are shown):",[419,459,461],{"className":421,"code":460,"language":423,"meta":424,"style":424},"; The lookup timeout, in seconds. Better set it to something much lower than this.\nlookup_timeout = 29\n\n; bypass hosts that match these conditions\n[skip]\n; hosts that relay through us\nrelaying = false\n; hosts that are SMTP AUTH'ed\nauth = false\n",[399,462,463,468,473,480,486,492,498,504,510],{"__ignoreMap":424},[428,464,465],{"class":430,"line":431},[428,466,467],{},"; The lookup timeout, in seconds. Better set it to something much lower than this.\n",[428,469,470],{"class":430,"line":437},[428,471,472],{},"lookup_timeout = 29\n",[428,474,476],{"class":430,"line":475},3,[428,477,479],{"emptyLinePlaceholder":478},true,"\n",[428,481,483],{"class":430,"line":482},4,[428,484,485],{},"; bypass hosts that match these conditions\n",[428,487,489],{"class":430,"line":488},5,[428,490,491],{},"[skip]\n",[428,493,495],{"class":430,"line":494},6,[428,496,497],{},"; hosts that relay through us\n",[428,499,501],{"class":430,"line":500},7,[428,502,503],{},"relaying = false\n",[428,505,507],{"class":430,"line":506},8,[428,508,509],{},"; hosts that are SMTP AUTH'ed\n",[428,511,513],{"class":430,"line":512},9,[428,514,515],{},"auth = false\n",[384,517,518,519,522],{},"There's a special setting that would allow the plugin to emit a funny explanation text on SPF DENY, essentially meant to be visible to end-users that will receive the bounce. The text is ",[399,520,521],{},"http:\u002F\u002Fwww.openspf.org\u002FWhy?s=${scope}&id=${sender_id}&ip=${connection.remote.ip}"," and is enabled by:",[419,524,526],{"className":421,"code":525,"language":423,"meta":424,"style":424},"[deny]\nopenspf_text = true\n\n; in case you DENY on failing SPF on hosts that are relaying (but why?)\n[deny_relay]\nopenspf_text = true\n",[399,527,528,533,538,542,547,552],{"__ignoreMap":424},[428,529,530],{"class":430,"line":431},[428,531,532],{},"[deny]\n",[428,534,535],{"class":430,"line":437},[428,536,537],{},"openspf_text = true\n",[428,539,540],{"class":430,"line":475},[428,541,479],{"emptyLinePlaceholder":478},[428,543,544],{"class":430,"line":482},[428,545,546],{},"; in case you DENY on failing SPF on hosts that are relaying (but why?)\n",[428,548,549],{"class":430,"line":488},[428,550,551],{},"[deny_relay]\n",[428,553,554],{"class":430,"line":494},[428,555,537],{},[557,558,560],"h3",{"id":559},"things-to-know","Things to Know",[562,563,564,573,576,579,596],"ul",{},[565,566,567,568,572],"li",{},"Most senders do not publish SPF records for their mail server ",[569,570,571],"em",{},"hostname",",\nwhich means that the SPF HELO test rarely passes. During observation in 2014,\nmore spam senders have valid SPF HELO than ham senders. If you expect very\nlittle from SPF HELO validation, you might still be disappointed.",[565,574,575],{},"Enabling error deferrals will cause excessive delays and perhaps bounced\nmail for senders with broken DNS. Enable this only if you are willing to\ndelay and sometimes lose valid mail.",[565,577,578],{},"Broken SPF records by valid senders are common. Keep that in mind when\nconsidering denial of SPF error results. If you deny on error, budget\ntime for instructing senders on how to correct their SPF records so they\ncan email you.",[565,580,581,582,585,586,590,591,595],{},"The only deny option most sites should consider is ",[399,583,584],{},"mfrom_fail",". That will\nreject messages that explicitely fail SPF tests. SPF failures have a high\ncorrelation with spam. However, up to 10% of ham transits forwarders and\u002For\nemail lists which frequently break SPF. SPF results are best used as inputs\nto other plugins such as DMARC, ",[388,587,338],{"href":588,"rel":589},"http:\u002F\u002Fharaka.github.io\u002Fmanual\u002Fplugins\u002Fspamassassin.html",[392],", and ",[388,592,229],{"href":593,"rel":594},"http:\u002F\u002Fharaka.github.io\u002Fmanual\u002Fplugins\u002Fkarma.html",[392],".",[565,597,598,599],{},"Heed well the implications of SPF, as described in ",[388,600,603],{"href":601,"rel":602},"http:\u002F\u002Ftools.ietf.org\u002Fhtml\u002Frfc4408#section-9.3",[392],"RFC 4408",[557,605,607],{"id":606},"spfini-default-settings","spf.ini default settings",[419,609,611],{"className":421,"code":610,"language":423,"meta":424,"style":424},"lookup_timeout = 29\n\n\n[relay]\ncontext=sender\n\n\n[skip]\nrelaying=false\nauth=false\n\n\n[defer]\nhelo_temperror=false\nmfrom_temperror=false\n\n\n[deny]\nhelo_none=false\nhelo_softfail=false\nhelo_fail=false\nhelo_permerror=false\n\nmfrom_none=false\nmfrom_softfail=false\nmfrom_fail=false\nmfrom_permerror=false\n\nopenspf_text=false\n\n\n; SPF settings used when connection.relaying=true\n[defer_relay]\nhelo_temperror=false\nmfrom_temperror=false\n\n\n[deny_relay]\nhelo_none=false\nhelo_softfail=false\nhelo_fail=false\nhelo_permerror=false\n\nmfrom_none=false\nmfrom_softfail=false\nmfrom_fail=false\nmfrom_permerror=false\n\nopenspf_text=false\n",[399,612,613,617,621,625,629,634,638,642,646,651,657,662,667,673,679,685,690,695,700,706,712,718,724,729,735,741,747,753,758,764,769,774,780,786,791,796,801,806,811,816,821,826,831,836,841,846,851,856,861],{"__ignoreMap":424},[428,614,615],{"class":430,"line":431},[428,616,472],{},[428,618,619],{"class":430,"line":437},[428,620,479],{"emptyLinePlaceholder":478},[428,622,623],{"class":430,"line":475},[428,624,479],{"emptyLinePlaceholder":478},[428,626,627],{"class":430,"line":482},[428,628,434],{},[428,630,631],{"class":430,"line":488},[428,632,633],{},"context=sender\n",[428,635,636],{"class":430,"line":494},[428,637,479],{"emptyLinePlaceholder":478},[428,639,640],{"class":430,"line":500},[428,641,479],{"emptyLinePlaceholder":478},[428,643,644],{"class":430,"line":506},[428,645,491],{},[428,647,648],{"class":430,"line":512},[428,649,650],{},"relaying=false\n",[428,652,654],{"class":430,"line":653},10,[428,655,656],{},"auth=false\n",[428,658,660],{"class":430,"line":659},11,[428,661,479],{"emptyLinePlaceholder":478},[428,663,665],{"class":430,"line":664},12,[428,666,479],{"emptyLinePlaceholder":478},[428,668,670],{"class":430,"line":669},13,[428,671,672],{},"[defer]\n",[428,674,676],{"class":430,"line":675},14,[428,677,678],{},"helo_temperror=false\n",[428,680,682],{"class":430,"line":681},15,[428,683,684],{},"mfrom_temperror=false\n",[428,686,688],{"class":430,"line":687},16,[428,689,479],{"emptyLinePlaceholder":478},[428,691,693],{"class":430,"line":692},17,[428,694,479],{"emptyLinePlaceholder":478},[428,696,698],{"class":430,"line":697},18,[428,699,532],{},[428,701,703],{"class":430,"line":702},19,[428,704,705],{},"helo_none=false\n",[428,707,709],{"class":430,"line":708},20,[428,710,711],{},"helo_softfail=false\n",[428,713,715],{"class":430,"line":714},21,[428,716,717],{},"helo_fail=false\n",[428,719,721],{"class":430,"line":720},22,[428,722,723],{}