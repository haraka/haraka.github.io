Fplugins\u002Fsyslog","8.plugins\u002Fsyslog",{"title":354,"path":355,"stem":356},"tarpit","\u002Fplugins\u002Ftarpit","8.plugins\u002Ftarpit",{"title":358,"path":359,"stem":360},"tls","\u002Fplugins\u002Ftls","8.plugins\u002Ftls",{"title":362,"path":363,"stem":364},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":366,"path":367,"stem":368},"uribl","\u002Fplugins\u002Furibl","8.plugins\u002Furibl",{"title":370,"path":371,"stem":372},"watch","\u002Fplugins\u002Fwatch","8.plugins\u002Fwatch",{"title":374,"path":375,"stem":376},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":378,"title":379,"body":380,"description":718,"extension":719,"links":720,"meta":721,"navigation":722,"path":226,"seo":723,"stem":227,"__hash__":724},"docs\u002F8.plugins\u002Fhelo.checks.md","helo.checks - HELO Checks plugin for Haraka",{"type":381,"value":382,"toc":709},"minimark",[383,387,390,395,398,622,626,658,664,672,677,683,688,694,699,705],[384,385,386],"p",{},"This plugin performs a number of checks on the HELO string.",[384,388,389],{},"HELO strings are very often forged or dubious in spam and so this can be a\nhighly effective and false-positive free anti-spam measure.",[391,392,394],"h2",{"id":393},"usage","Usage",[384,396,397],{},"helo.checks results can be accessed by subsequent plugins:",[399,400,405],"pre",{"className":401,"code":402,"language":403,"meta":404,"style":404},"language-js shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","var h = connection.results.get('helo.checks');\nif (h.pass && h.pass.length > 5) {\n    \u002F\u002F nice job, you passed 6+ tests\n}\nif (h.fail && h.fail.length > 3) {\n    \u002F\u002F yikes, you failed 4+ tests!\n}\nif (connection.results.has('helo.checks','pass', \u002F^forward_dns\u002F) {\n    \u002F\u002F the HELO hostname is valid\n}\n","js","",[406,407,408,457,501,508,514,548,554,559,611,617],"code",{"__ignoreMap":404},[409,410,413,417,421,425,428,431,434,436,440,443,446,449,451,454],"span",{"class":411,"line":412},"line",1,[409,414,416],{"class":415},"spNyl","var",[409,418,420],{"class":419},"sTEyZ"," h ",[409,422,424],{"class":423},"sMK4o","=",[409,426,427],{"class":419}," connection",[409,429,430],{"class":423},".",[409,432,433],{"class":419},"results",[409,435,430],{"class":423},[409,437,439],{"class":438},"s2Zo4","get",[409,441,442],{"class":419},"(",[409,444,445],{"class":423},"'",[409,447,225],{"class":448},"sfazB",[409,450,445],{"class":423},[409,452,453],{"class":419},")",[409,455,456],{"class":423},";\n",[409,458,460,464,467,469,472,475,478,480,483,485,488,491,495,498],{"class":411,"line":459},2,[409,461,463],{"class":462},"s7zQu","if",[409,465,466],{"class":419}," (h",[409,468,430],{"class":423},[409,470,471],{"class":419},"pass ",[409,473,474],{"class":423},"&&",[409,476,477],{"class":419}," h",[409,479,430],{"class":423},[409,481,482],{"class":419},"pass",[409,484,430],{"class":423},[409,486,487],{"class":419},"length ",[409,489,490],{"class":423},">",[409,492,494],{"class":493},"sbssI"," 5",[409,496,497],{"class":419},") ",[409,499,500],{"class":423},"{\n",[409,502,504],{"class":411,"line":503},3,[409,505,507],{"class":506},"sHwdD","    \u002F\u002F nice job, you passed 6+ tests\n",[409,509,511],{"class":411,"line":510},4,[409,512,513],{"class":423},"}\n",[409,515,517,519,521,523,526,528,530,532,535,537,539,541,544,546],{"class":411,"line":516},5,[409,518,463],{"class":462},[409,520,466],{"class":419},[409,522,430],{"class":423},[409,524,525],{"class":419},"fail ",[409,527,474],{"class":423},[409,529,477],{"class":419},[409,531,430],{"class":423},[409,533,534],{"class":419},"fail",[409,536,430],{"class":423},[409,538,487],{"class":419},[409,540,490],{"class":423},[409,542,543],{"class":493}," 3",[409,545,497],{"class":419},[409,547,500],{"class":423},[409,549,551],{"class":411,"line":550},6,[409,552,553],{"class":506},"    \u002F\u002F yikes, you failed 4+ tests!\n",[409,555,557],{"class":411,"line":556},7,[409,558,513],{"class":423},[409,560,562,564,567,569,571,573,576,578,580,582,584,587,589,591,593,595,598,601,604,607,609],{"class":411,"line":561},8,[409,563,463],{"class":462},[409,565,566],{"class":419}," (connection",[409,568,430],{"class":423},[409,570,433],{"class":419},[409,572,430],{"class":423},[409,574,575],{"class":438},"has",[409,577,442],{"class":419},[409,579,445],{"class":423},[409,581,225],{"class":448},[409,583,445],{"class":423},[409,585,586],{"class":423},",",[409,588,445],{"class":423},[409,590,482],{"class":448},[409,592,445],{"class":423},[409,594,586],{"class":423},[409,596,597],{"class":423}," \u002F",[409,599,600],{"class":462},"^",[409,602,603],{"class":448},"forward_dns",[409,605,606],{"class":423},"\u002F",[409,608,497],{"class":419},[409,610,500],{"class":423},[409,612,614],{"class":411,"line":613},9,[409,615,616],{"class":506},"    \u002F\u002F the HELO hostname is valid\n",[409,618,620],{"class":411,"line":619},10,[409,621,513],{"class":423},[391,623,625],{"id":624},"configuration","Configuration",[627,628,629,644],"ul",{},[630,631,632,633,636,637,639,640,643],"li",{},"helo.checks.regexps",[634,635],"br",{},"List of regular expressions to match against the HELO string. The regular\nexpressions are automatically wrapped in ",[406,638,600],{}," and ",[406,641,642],{},"$"," so they always match\nthe entire string.",[630,645,646,647,649,650],{},"helo.checks.ini",[634,648],{},"INI file which controls enabling of certain checks:",[627,651,652],{},[630,653,654,655,657],{},"dns_timeout=30",[634,656],{},"How many seconds to wait for DNS queries to timeout.",[659,660,662],"h3",{"id":661},"check",[409,663,661],{},[399,665,670],{"className":666,"code":668,"language":669},[667],"language-text","* valid\\_hostname=true\n\n  Checks that the HELO has at least one '.' in it and the organizational\n  name is possible (ie, a host within a Public Suffix).\n\n* bare\\_ip=true\n\n  Checks for HELO \u003CIP> where the IP is not surrounded by square brackets.\n  This is an RFC violation so should always be enabled.\n\n* dynamic=true\n\n  Checks to see if all or part the connecting IP address appears within\n  the HELO argument to indicate that the client has a dynamic IP address.\n\n* literal\\_mismatch=1|2|3\n\n  Checks to see if the IP literal used matches the connecting IP address.\n  If set to 1, the full IP must match.  If set to 2, the \u002F24 must match.\n  If set to 3, the \u002F24 may match, or the IP can be private (RFC 1918).\n\n* match\\_re=true\n\n  See above. This is merely an on\u002Foff toggle.\n\n* big\\_company=true\n\n  See below. This is merely an on\u002Foff toggle.\n\n* forward\\_dns=true\n\n  Perform a DNS lookup of the HELO hostname and validate that the IP of\n  the remote is included in the IP(s) of the HELO hostname.\n\n  This test requires that the valid\\_hostname check is also enabled.\n\n* rdns\\_match=true\n\n  Sees if the HELO hostname (or at least the domain) match the rDNS\n  hostname(s).\n\n* host\\_mismatch=true\n\n  If HELO is called multiple times, checks if the hostname differs between\n  EHLO invocations.\n\n* proto\\_mismatch=true\n\n  If EHLO was sent and the host later tries to then send HELO or vice-versa.\n","text",[406,671,668],{"__ignoreMap":404},[659,673,675],{"id":674},"reject",[409,676,674],{},[399,678,681],{"className":679,"code":680,"language":669},[667],"For all of the checks included above, a matching key in the reject section\ncontrols whether messages that fail the test are rejected.\n\nDefaults shown:\n\n[reject]\nhost_mismatch=false\nliteral_mismatch=false\nproto_mismatch=false\nrdns_match=false\ndynamic=false\nbare_ip=false\nvalid_hostname=false\nforward_dns=false\nbig_company=false\n",[406,682,680],{"__ignoreMap":404},[659,684,686],{"id":685},"skip",[409,687,685],{},[399,689,692],{"className":690,"code":691,"language":669},[667],"* private\\_ip=true\n\n  Bypasses checks for clients within RFC1918, Loopback or APIPA IP address ranges.\n\n* relaying\n\n  Bypass checks for clients who have relaying privileges (whitelisted IP,\n  SMTP-AUTH, etc).\n",[406,693,691],{"__ignoreMap":404},[659,695,697],{"id":696},"bigco",[409,698,696],{},[399,700,703],{"className":701,"code":702,"language":669},[667],"  A list of \u003Chelo>=\u003Crdns>[,\u003Crdns>...] to match against. If the HELO matches\n  what's on the left hand side, the reverse-DNS must match one of the\n  entries on the right hand side or the mail is blocked.\n\n  Example:\n\n        yahoo.com=yahoo.com,yahoo.co.jp\n        aol.com=aol.com\n        gmail.com=google.com\n",[406,704,702],{"__ignoreMap":404},[706,707,708],"style",{},"html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":404,"searchDepth":459,"depth":459,"links":710},[711,712],{"id":393,"depth":459,"text":394},{"id":624,"depth":459,"text":625,"children":713},[714,715,716,717],{"id":661,"depth":503,"text":661},{"id":674,"depth":503,"text":674},{"id":685,"depth":503,"text":685},{"id":696,"depth":503,"text":696},"Haraka helo.checks plugin - Rejects messages with invalid HELO\u002FEHLO","md",null,{},{"title":225},{"title":379,"description":718},"dAp0dKiHkBhc1khpelUmZSX4JMzS9OvFGOz6Az55a74",[726,728],{"title":221,"path":222,"stem":223,"description":727,"children":-1},"Haraka data.headers plugin - Header Checks",{"title":229,"path":230,"stem":231,"description":729,"children":-1},"Haraka karma plugin - a scoring engine for Haraka",1794456866513]