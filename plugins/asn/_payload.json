slog","8.plugins\u002Fsyslog",{"title":354,"path":355,"stem":356},"tarpit","\u002Fplugins\u002Ftarpit","8.plugins\u002Ftarpit",{"title":358,"path":359,"stem":360},"tls","\u002Fplugins\u002Ftls","8.plugins\u002Ftls",{"title":362,"path":363,"stem":364},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":366,"path":367,"stem":368},"uribl","\u002Fplugins\u002Furibl","8.plugins\u002Furibl",{"title":370,"path":371,"stem":372},"watch","\u002Fplugins\u002Fwatch","8.plugins\u002Fwatch",{"title":374,"path":375,"stem":376},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":378,"title":379,"body":380,"description":575,"extension":576,"links":577,"meta":578,"navigation":579,"path":117,"seo":580,"stem":118,"__hash__":581},"docs\u002F8.plugins\u002Fasn.md","asn - get AS number of remote IP address plugin for Haraka",{"type":381,"value":382,"toc":565},"minimark",[383,393,405,410,413,431,435,441,451,455,458,477,480,485,488,492,495,500,503,508,516,520,523,526,530,537,544,547,555,559],[384,385,386,390],"ul",{},[387,388,389],"li",{},"Use DNS queries to look up the ASN of the remote IP.",[387,391,392],{},"Inserts a result object with the ASN of the remote host.",[394,395,396,397,404],"p",{},"The AS Number is the ",[398,399,403],"a",{"href":400,"rel":401},"http:\u002F\u002Fen.wikipedia.org\u002Fwiki\u002FAutonomous_System_(Internet)",[402],"nofollow","Autonomous System Number","\nthat represents the bailiwick or sphere of control of a network operator.",[406,407,409],"h2",{"id":408},"faster-lookups","Faster Lookups",[394,411,412],{},"If your mail server is very busy:",[384,414,415,423],{},[387,416,417,418,422],{},"Download the ",[398,419,421],{"href":420},"ftp:\u002F\u002Fftp.routeviews.org\u002Fdnszones\u002F","routeviews ASN zones"," and serve them on a local DNS server. If you use SpamAssassin, this is highly recommended as it looks up ASN using routeviews via DNS.",[387,424,425,426,430],{},"Use instead the ",[427,428,429],"code",{},"connect.geoip"," plugin with the MaxMind backend. It caches the ASN database locally and gets the ASN without network traffic and delays.",[406,432,434],{"id":433},"usage","Usage",[394,436,437,438,440],{},"The AS number can be accessed by plugins that run after ",[427,439,116],{}," like so:",[442,443,448],"pre",{"className":444,"code":446,"language":447},[445],"language-text","var asn = connection.results.get('asn');\nif (asn && asn.asn) {\n    connection.loginfo(plugin, \"hey look, it's ASN: \" + asn.asn);\n}\n","text",[427,449,446],{"__ignoreMap":450},"",[406,452,454],{"id":453},"configuration","Configuration",[394,456,457],{},"The following settings can be set in config\u002Fasn.ini.",[384,459,460,474],{},[387,461,462,463],{},"providers: comma separated list of DNS zones that provide IP to ASN lookups",[384,464,465,468,471],{},[387,466,467],{},"origin.asn.cymru.com",[387,469,470],{},"origin.asn.spameatingmonkey.net",[387,472,473],{},"asn.routeviews.org",[387,475,476],{},"test_ip: (Default:",[394,478,479],{},"An IP address that maps to an ASN (any valid public IP should work)",[384,481,482],{},[387,483,484],{},"timeout (in seconds): (Default: 4)",[394,486,487],{},"How long to wait for DNS results to return.",[406,489,491],{"id":490},"headers","Headers",[394,493,494],{},"Optionally add headers to messages with ASN info.",[384,496,497],{},[387,498,499],{},"asn_header (Default: false)",[394,501,502],{},"add X-Haraka-ASN header with the ASN and if available, netmask.",[384,504,505],{},[387,506,507],{},"provider_header (Default: false)",[394,509,510,511,515],{},"Add X-Haraka-ASN-",[512,513,514],"span",{},"provider"," header for each provider that returned results.",[406,517,519],{"id":518},"theory","Theory",[394,521,522],{},"An ASN is a very good approximation of the IP space under the control\nof a network operator. The theory behind ASN tracking is that good network\noperators police their networks, proactively limit abuse, and are less likely\nto be emitting abuse.",[394,524,525],{},"Not-so-good network operators are likely to emit a greater number of abusive\nconnections, and should be handled with increased scrutiny.",[406,527,529],{"id":528},"research","Research",[394,531,532],{},[398,533,536],{"href":534,"rel":535},"http:\u002F\u002Fweb.archive.org\u002Fweb\u002F20090709150921\u002Fhttp:\u002F\u002Fwww.cc.gatech.edu\u002F~feamster\u002Fpapers\u002Fsnare-usenix09.pdf",[402],"http:\u002F\u002Fwww.cc.gatech.edu\u002F~feamster\u002Fpapers\u002Fsnare-usenix09.pdf",[394,538,539,540,543],{},"\"Performance based on AS number only...The classifier gets a false positive\nrate of 0.76% ",[512,541,542],{},"and"," a 70% detection rate\"",[394,545,546],{},"\"AS numbers are more persistently associated with a sender's\nidentity than the IP address, for two reasons: (1) The spamming mail server\nmight be set up within specific ASes without the network administrator\nshutting it down. (2) Bots tend to aggregate within ASes, since the machines\nin the same ASes are likely to have the same vulnerability. It is not easy for\nspammers to move mail servers or the bot armies to a different AS; therefore,\nAS numbers are robust to indicate malicious hosts.\"",[394,548,549,550],{},"See also: ",[398,551,554],{"href":552,"rel":553},"http:\u002F\u002Fwww.bgpmon.net\u002Fusing-bgp-data-to-find-spammers\u002F",[402],"Using BGP data to find spammers",[406,556,558],{"id":557},"consumers","Consumers",[394,560,561,562,564],{},"The ",[398,563,229],{"href":230}," plugin uses the ASN to maintain\nits network neighborhood reputation.",{"title":450,"searchDepth":566,"depth":566,"links":567},2,[568,569,570,571,572,573,574],{"id":408,"depth":566,"text":409},{"id":433,"depth":566,"text":434},{"id":453,"depth":566,"text":454},{"id":490,"depth":566,"text":491},{"id":518,"depth":566,"text":519},{"id":528,"depth":566,"text":529},{"id":557,"depth":566,"text":558},"Haraka asn plugin - get AS number of remote","md",null,{},{"title":116},{"title":379,"description":575},"SsDtGE1FWJf4npekid_X9uYKUHD8w6d4q3VRTP11aQc",[583,585],{"title":112,"path":113,"stem":114,"description":584,"children":-1},"Haraka aliases plugin - Alias plugin for Haraka",{"title":120,"path":121,"stem":122,"description":586,"children":-1},"Haraka attachment plugin - attachment handling for Haraka",1794456866512]