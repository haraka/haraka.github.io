2Fsyslog","8.plugins\u002Fsyslog",{"title":354,"path":355,"stem":356},"tarpit","\u002Fplugins\u002Ftarpit","8.plugins\u002Ftarpit",{"title":358,"path":359,"stem":360},"tls","\u002Fplugins\u002Ftls","8.plugins\u002Ftls",{"title":362,"path":363,"stem":364},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":366,"path":367,"stem":368},"uribl","\u002Fplugins\u002Furibl","8.plugins\u002Furibl",{"title":370,"path":371,"stem":372},"watch","\u002Fplugins\u002Fwatch","8.plugins\u002Fwatch",{"title":374,"path":375,"stem":376},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":378,"title":379,"body":380,"description":585,"extension":586,"links":587,"meta":588,"navigation":589,"path":166,"seo":590,"stem":167,"__hash__":591},"docs\u002F8.plugins\u002Fclamd.md","clamd - ClamAV plugin for Haraka",{"type":381,"value":382,"toc":570},"minimark",[383,391,394,399,402,407,415,418,425,428,432,435,439,442,446,449,453,456,460,463,468,471,482,485,491,494,500,505,508,545,549,552,555,558,561,564],[384,385,386,387,390],"p",{},"This plug-in implements Anti-Virus scanning with ClamAV using the ",[388,389,165],"strong",{},"\ndaemon.",[384,392,393],{},"The plug-in will reject any message that ClamAV considers to be a virus.\nIf an error occurs (e.g. clamd not running or a timeout), the\nmessage will be deferred with a temporary failure.",[395,396,398],"h2",{"id":397},"configuration","Configuration",[384,400,401],{},"The following options can be defined in clamd.ini;",[403,404,406],"h3",{"id":405},"clamd_socket-default-localhost3310","clamd_socket (default: localhost:3310)",[384,408,409,410,414],{},"N.N.N.N:port, ",[411,412,413],"span",{},"ipv6::literal",":port, host:port or \u002Fpath\u002Fto\u002Fsocket of\nthe clamd daemon.",[384,416,417],{},"Multiple hosts can be listed separated by comma, semi-colon or spaces.",[384,419,420,421,424],{},"If ",[422,423],"port",{}," is omitted it defaults to 3310.",[384,426,427],{},"On connection error or timeout the next host in the list will be tried.\nWhen the host list is exhausted, the message will be deferred with\na temporary failure.",[403,429,431],{"id":430},"randomize_host_order-default-false","randomize_host_order (default: false)",[384,433,434],{},"If this is set then the list of hosts with be randomized before a\nconnection is attempted.",[403,436,438],{"id":437},"only_with_attachments-default-false","only_with_attachments                         (default: false)",[384,440,441],{},"Set this option to only scan messages that contain non-textual\nattachments.  This is a performance optimization, however it will\nprevent ClamAV from detecting threats such as Phishing in plain-text\nor HTML messages.",[403,443,445],{"id":444},"connect_timeout-default-10","connect_timeout                               (default: 10)",[384,447,448],{},"Timeout connection to host after this many seconds.  A timeout will\ncause the next host in the list to be tried.  Once all hosts have\nbeen tried then a temporary failure will be returned.",[403,450,452],{"id":451},"timeout-default-30","timeout                                       (default: 30)",[384,454,455],{},"Post-connection timeout if there is no activity on the socket after\nthis many seconds.  A timeout will cause the message to be rejected\nwith a tempoary failure.",[403,457,459],{"id":458},"max_size-default-26214400","max_size                                      (default: 26214400)",[384,461,462],{},"The maximum size of message that should be sent to clamd in bytes.\nThis option should not be larger than the StreamMaxLength value in\nclamd.conf as clamd will stop scanning once this limit is reached.\nIf the clamd limit is reached the plug-in will log a notice that\nthis has happened and will allow the message though.",[403,464,466],{"id":465},"reject",[411,467,465],{},[384,469,470],{},"An optional reject section can offer control over when to reject connections.\nThe default settings are shown. ClamAV recommends that hits coming from\nSafeBrowsing \u002F Phishing \u002F Heuristics, Potentially Unwanted Applications, and\nUNOFFICIAL be used only for scoring.",[472,473,478],"pre",{"className":474,"code":476,"language":477},[475],"language-text","* virus=true\n* error=true\n","text",[479,480,476],"code",{"__ignoreMap":481},"",[384,483,484],{},"The following reject options are disabled by default in clamd.conf. With a\ndefault ClamAV install, these will have no effect. When an admin enables in\nclamd.conf, Haraka with then, by default, reject such messages. Adjust these\nsettings to suit.",[472,486,489],{"className":487,"code":488,"language":477},[475],"* Broken.Executable=true\n* Structured=true\n* Encrypted=true\n* PUA=true\n* OLE2=true\n* Safebrowsing=true\n* UNOFFICIAL=true\n",[479,490,488],{"__ignoreMap":481},[384,492,493],{},"The following options are enabled by default in clamd but ClamAV suggests\nusing them only for scoring.",[472,495,498],{"className":496,"code":497,"language":477},[475],"* Phishing=false\n",[479,499,497],{"__ignoreMap":481},[395,501,503],{"id":502},"check",[411,504,502],{},[384,506,507],{},"The optional check section can allow skipping ClamAV check for remote connection\nmeeting following criteria.",[509,510,511,522,530,538],"ul",{},[512,513,514,515,518,519,521],"li",{},"authenticated",[516,517],"br",{},"Default: true",[516,520],{},"If true, messages from authenticated users will be scanned.",[512,523,524,525,518,527,529],{},"private_ip",[516,526],{},[516,528],{},"If true, messages from private IPs will be scanned.",[512,531,532,533,518,535,537],{},"local_ip",[516,534],{},[516,536],{},"If true, messages from localhost will be scanned.",[512,539,326,540,518,542,544],{},[516,541],{},[516,543],{},"If true, messages that are to be relayed will be scanned.",[395,546,548],{"id":547},"clamdexcludes","clamd.excludes",[384,550,551],{},"This file can contain a list of virus name patterns that when matched, are\nnot rejected by this plugin. An X-Haraka-Virus: header will be inserted\ncontaining the virus name. This header can then be used for scoring\nin other plugins.",[384,553,554],{},"The format of the file is one pattern per line. Comments are prefixed\nwith #. Matches are case-insensitive.",[384,556,557],{},"Patterns are expressed using wildcards (e.g. * and ?) or\nvia regexp by enclosing the pattern in \u002F\u002F.",[384,559,560],{},"To negate a match (e.g. reject if it matches), prefix the match with !.\nNegative matches are always tested fist.",[384,562,563],{},"Example:",[472,565,568],{"className":566,"code":567,"language":477},[475],"# Always reject test signatures\n!*.TestSig_*\n# Skip all unofficial signatures\n*.UNOFFICIAL\n# Phishing\nHeuristics.Phishing.*\n",[479,569,567],{"__ignoreMap":481},{"title":481,"searchDepth":571,"depth":571,"links":572},2,[573,583,584],{"id":397,"depth":571,"text":398,"children":574},[575,577,578,579,580,581,582],{"id":405,"depth":576,"text":406},3,{"id":430,"depth":576,"text":431},{"id":437,"depth":576,"text":438},{"id":444,"depth":576,"text":445},{"id":451,"depth":576,"text":452},{"id":458,"depth":576,"text":459},{"id":465,"depth":576,"text":465},{"id":502,"depth":571,"text":502},{"id":547,"depth":571,"text":548},"Haraka clamd plugin - ClamAV anti-virus plugin","md",null,{},{"title":165},{"title":379,"description":585},"f431BoM8wbae8YaG4LZc9WxAIqbzEYHNRoZmobf-SrE",[593,595],{"title":161,"path":162,"stem":163,"description":594,"children":-1},"Haraka bounce plugin - Bounces mail to a specific address",{"title":169,"path":170,"stem":171,"description":596,"children":-1},"Haraka daemonize plugin - Daemonize",1794456870760]