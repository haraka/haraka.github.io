ns\u002Fsyslog","8.plugins\u002Fsyslog",{"title":354,"path":355,"stem":356},"tarpit","\u002Fplugins\u002Ftarpit","8.plugins\u002Ftarpit",{"title":358,"path":359,"stem":360},"tls","\u002Fplugins\u002Ftls","8.plugins\u002Ftls",{"title":362,"path":363,"stem":364},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":366,"path":367,"stem":368},"uribl","\u002Fplugins\u002Furibl","8.plugins\u002Furibl",{"title":370,"path":371,"stem":372},"watch","\u002Fplugins\u002Fwatch","8.plugins\u002Fwatch",{"title":374,"path":375,"stem":376},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":378,"title":379,"body":380,"description":722,"extension":723,"links":724,"meta":725,"navigation":726,"path":190,"seo":727,"stem":191,"__hash__":728},"docs\u002F8.plugins\u002Fdns-list.md","dns-list - DNS Blacklists plugin for Haraka",{"type":381,"value":382,"toc":711},"minimark",[383,388,392,396,404,407,410,418,420,431,435,503,507,510,532,535,543,550,553,559,562,568,578,585,593,604,611,618,626,632,639,643,646,665,668,685,707],[384,385,387],"h2",{"id":386},"dns-lists","dns lists",[389,390,391],"p",{},"Looks up the IP address of the remote host in DNS lists. There are several types of DNS based lists:",[393,394,395],"h3",{"id":395},"block",[389,397,398,399,403],{},"Block lists (aka: DNSBL) are designed to be used for blocking mail from any host listed in them. Block lists are the most common DNS list type and lists without a type specified are considered block lists. The default action for block lists is to reject the connection. This can be changed by setting ",[400,401,402],"code",{},"reject=false"," in the zone's settings block.",[393,405,406],{"id":406},"allow",[389,408,409],{},"When the remote IP is found in an allow list, this plugin returns OK for the ehlo, helo, and mail hooks.",[389,411,412,413,417],{},"IMPORTANT! The order of plugins in config\u002Fplugins is important when this feature is used. It should be listed ",[414,415,416],"em",{},"before"," any plugins that you wish to skip, but after any plugins that accept recipients.",[393,419,229],{"id":229},[389,421,422,423,430],{},"Karma lists can have different results for IPs beyond a simple block or allow. See ",[424,425,429],"a",{"href":426,"rel":427},"https:\u002F\u002Fhostkarma.junkemailfilter.com",[428],"nofollow","hostkarma.junkemailfilter.com"," for details.",[384,432,434],{"id":433},"install","INSTALL",[436,437,442],"pre",{"className":438,"code":439,"language":440,"meta":441,"style":441},"language-sh shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","cd \u002Fpath\u002Fto\u002Flocal\u002Fharaka\nnpm install haraka-plugin-dns-list\necho \"dns-list\" >> config\u002Fplugins\nservice haraka restart\n","sh","",[400,443,444,457,470,491],{"__ignoreMap":441},[445,446,449,453],"span",{"class":447,"line":448},"line",1,[445,450,452],{"class":451},"s2Zo4","cd",[445,454,456],{"class":455},"sfazB"," \u002Fpath\u002Fto\u002Flocal\u002Fharaka\n",[445,458,460,464,467],{"class":447,"line":459},2,[445,461,463],{"class":462},"sBMFI","npm",[445,465,466],{"class":455}," install",[445,468,469],{"class":455}," haraka-plugin-dns-list\n",[445,471,473,476,480,482,485,488],{"class":447,"line":472},3,[445,474,475],{"class":451},"echo",[445,477,479],{"class":478},"sMK4o"," \"",[445,481,189],{"class":455},[445,483,484],{"class":478},"\"",[445,486,487],{"class":478}," >>",[445,489,490],{"class":455}," config\u002Fplugins\n",[445,492,494,497,500],{"class":447,"line":493},4,[445,495,496],{"class":462},"service",[445,498,499],{"class":455}," haraka",[445,501,502],{"class":455}," restart\n",[384,504,506],{"id":505},"configure","Configure",[389,508,509],{},"If the default configuration is insufficient, copy the config file from the distribution into your haraka config dir and modify it:",[436,511,513],{"className":438,"code":512,"language":440,"meta":441,"style":441},"cp node_modules\u002Fharaka-plugin-dns-list\u002Fconfig\u002Fdns-list.ini config\u002Fdns-list.ini\n$EDITOR config\u002Fdns-list.ini\n",[400,514,515,526],{"__ignoreMap":441},[445,516,517,520,523],{"class":447,"line":448},[445,518,519],{"class":462},"cp",[445,521,522],{"class":455}," node_modules\u002Fharaka-plugin-dns-list\u002Fconfig\u002Fdns-list.ini",[445,524,525],{"class":455}," config\u002Fdns-list.ini\n",[445,527,528],{"class":447,"line":459},[445,529,531],{"class":530},"sTEyZ","$EDITOR config\u002Fdns-list.ini\n",[389,533,534],{},"dns-lists.ini - INI format with options described below:",[536,537,539,542],"h4",{"id":538},"main-periodic_checks30",[445,540,541],{},"main"," periodic_checks=30",[389,544,545,546,549],{},"Check every DNS zone every ",[400,547,548],{},"N"," minutes. When the value is less than 5, checks will only be run at start-up.",[389,551,552],{},"The checks confirm that lists are responding correctly. When errors are detected, the zone is disabled and will be checked at the next interval. When a zone resumes working correctly it will be enabled.",[536,554,556,558],{"id":555},"main-zones",[445,557,541],{}," zones",[389,560,561],{},"An array or comma separated list of zones to query.",[536,563,565,567],{"id":564},"main-search-default-all",[445,566,541],{}," search: (default: all)",[569,570,571,575],"ul",{},[572,573,574],"li",{},"first: consider first DNS list response conclusive. End processing.",[572,576,577],{},"all: process all DNS list results",[536,579,581,584],{"id":580},"stats-enabletrue",[445,582,583],{},"stats"," enable=true",[389,586,587,588,592],{},"This feature requires the ",[424,589,322],{"href":590,"rel":591},"https:\u002F\u002Fgithub.com\u002Fharaka\u002Fharaka-plugin-redis",[428]," plugin. When enabled, this will record several list statistics to redis:",[569,594,595,598,601],{},[572,596,597],{},"the total number of queries (TOTAL)",[572,599,600],{},"the average response time (AVG_RT)",[572,602,603],{},"the return type (e.g. LISTED or ERROR)",[389,605,606,607,610],{},"to a redis hash where the key is ",[400,608,609],{},"dns-list-stat:zone"," and the hash field is the response type.",[389,612,613,614,617],{},"It will also track the positive response overlap between the lists in another redis hash where the key is ",[400,615,616],{},"dns-list-overlap:zone"," and the hash field is the other list names. Example:",[436,619,624],{"className":620,"code":622,"language":623},[621],"language-text","redis 127.0.0.1:6379> hgetall dns-list-stat:zen.spamhaus.org\n1) \"TOTAL\"\n2) \"23\"\n3) \"ENOTFOUND\"\n4) \"11\"\n5) \"LISTED\"\n6) \"12\"\n7) \"AVG_RT\"\n8) \"45.5\"\n\nredis 127.0.0.1:6379> hgetall dns-list-overlap:zen.spamhaus.org\n1) \"b.barracudacentral.org\"\n2) \"1\"\n3) \"bl.spamcop.net\"\n4) \"1\"\n5) \"TOTAL\"\n6) \"1\"\n","text",[400,625,622],{"__ignoreMap":441},[536,627,629,631],{"id":628},"stats-redis_host",[445,630,583],{}," redis_host",[389,633,634,635,638],{},"In the form of ",[400,636,637],{},"host:port"," this option allows you to specify a different host on which redis runs.",[393,640,642],{"id":641},"per-zone-dns-list-settings","Per-Zone DNS list settings",[389,644,645],{},"The exact name of the DNS zone (as specified above in main.zones) may contain settings about that DNS list.",[569,647,648,654,662],{},[572,649,650,651],{},"type=",[445,652,653],{}," block, allow, karma",[572,655,656,657,661],{},"reject=true (default: true) Reject connections from IPs on block lists. Setting this to false makes dnsbl informational. reject=false is best used in conjunction with plugins like ",[424,658,229],{"href":659,"rel":660},"https:\u002F\u002Fgithub.com\u002Fharaka\u002Fharaka-plugin-karma",[428]," that employ a scoring engine to make choices about message delivery.",[572,663,664],{},"ipv6=true | false",[536,666,667],{"id":667},"dnswl",[436,669,673],{"className":670,"code":671,"language":672,"meta":441,"style":441},"language-ini shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","ok_helo=false\nok_mail=false\n","ini",[400,674,675,680],{"__ignoreMap":441},[445,676,677],{"class":447,"line":448},[445,678,679],{},"ok_helo=false\n",[445,681,682],{"class":447,"line":459},[445,683,684],{},"ok_mail=false\n",[389,686,687,688,693,694,693,699,702,703,706],{},"if DNSBL returns OK on the mail hook, it prevents any subsequent mail hooks in other plugins from running. This might include ",[424,689,692],{"href":690,"rel":691},"https:\u002F\u002Fgithub.com\u002Fharaka\u002Fharaka-plugin-spf",[428],"SPF",", ",[424,695,698],{"href":696,"rel":697},"https:\u002F\u002Fgithub.com\u002Fharaka\u002Fharaka-plugin-known-senders",[428],"known senders",[424,700,229],{"href":659,"rel":701},[428],", recipient plugins, and any other plugins that want to do transaction initialization on ",[400,704,705],{},"hook_mail",". It can be dangerous.",[708,709,710],"style",{},"html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);b