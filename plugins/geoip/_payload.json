2Fsyslog","8.plugins\u002Fsyslog",{"title":354,"path":355,"stem":356},"tarpit","\u002Fplugins\u002Ftarpit","8.plugins\u002Ftarpit",{"title":358,"path":359,"stem":360},"tls","\u002Fplugins\u002Ftls","8.plugins\u002Ftls",{"title":362,"path":363,"stem":364},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":366,"path":367,"stem":368},"uribl","\u002Fplugins\u002Furibl","8.plugins\u002Furibl",{"title":370,"path":371,"stem":372},"watch","\u002Fplugins\u002Fwatch","8.plugins\u002Fwatch",{"title":374,"path":375,"stem":376},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":378,"title":379,"body":380,"description":643,"extension":644,"links":645,"meta":646,"navigation":647,"path":210,"seo":648,"stem":211,"__hash__":649},"docs\u002F8.plugins\u002Fgeoip.md","geoip - GeoIP lookup",{"type":381,"value":382,"toc":641},"minimark",[383,387,392,409,413,416,427,434,478,482,491,497,500,506,512,518,529,533,540,543,550,555,558,563,566,576,579,583,590,596,599,603,606,609,612,616,623,630,634,637],[384,385,386],"p",{},"provide geographic information about mail senders.",[388,389,391],"h1",{"id":390},"synopsis","SYNOPSIS",[384,393,394,395,402,403,408],{},"Use MaxMind's GeoIP databases to report geographic information about senders. This plugin has support for both the ",[396,397,401],"a",{"href":398,"rel":399},"https:\u002F\u002Fgithub.com\u002Frunk\u002Fnode-maxmind",[400],"nofollow","maxmind"," and ",[396,404,407],{"href":405,"rel":406},"https:\u002F\u002Fgithub.com\u002Fbluesmoon\u002Fnode-geoip",[400],"geoip-lite"," node modules.",[388,410,412],{"id":411},"install","INSTALL",[384,414,415],{},"Install the npm geoip module you prefer:",[417,418,423],"pre",{"className":419,"code":421,"language":422},[420],"language-text","npm install maxmind\n  or\nnpm install -g geoip-lite\n","text",[424,425,421],"code",{"__ignoreMap":426},"",[384,428,429,430,433],{},"If both are installed, maxmind will be preferred as it's faster and also provides ASN data. The maxmind module requires manual download of the GeoIP databases. The npm module ",[424,431,432],{},"maxmind-geolite-mirror"," will download the files and keep them up-to-date if you run it periodically.",[417,435,439],{"className":436,"code":437,"language":438,"meta":426,"style":426},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","mkdir -p \u002Fusr\u002Flocal\u002Fshare\u002FGeoIP\nnpm install -g maxmind-geolite-mirror\n\u002Fusr\u002Flocal\u002Fbin\u002Fmaxmind-geolite-mirror\n","bash",[424,440,441,457,472],{"__ignoreMap":426},[442,443,446,450,454],"span",{"class":444,"line":445},"line",1,[442,447,449],{"class":448},"sBMFI","mkdir",[442,451,453],{"class":452},"sfazB"," -p",[442,455,456],{"class":452}," \u002Fusr\u002Flocal\u002Fshare\u002FGeoIP\n",[442,458,460,463,466,469],{"class":444,"line":459},2,[442,461,462],{"class":448},"npm",[442,464,465],{"class":452}," install",[442,467,468],{"class":452}," -g",[442,470,471],{"class":452}," maxmind-geolite-mirror\n",[442,473,475],{"class":444,"line":474},3,[442,476,477],{"class":448},"\u002Fusr\u002Flocal\u002Fbin\u002Fmaxmind-geolite-mirror\n",[388,479,481],{"id":480},"description","DESCRIPTION",[384,483,484,485,490],{},"GeoIP results are stored in connection.notes.geoip and connection.",[396,486,489],{"href":487,"rel":488},"https:\u002F\u002Fgithub.com\u002Fharaka\u002FHaraka\u002Fblob\u002Fmaster\u002Fdocs\u002FResults.md",[400],"results"," .connect.geoip. The following information is typically available:",[417,492,495],{"className":493,"code":494,"language":422},[420],"continent: NA,\ncountry:   US,\n",[424,496,494],{"__ignoreMap":426},[384,498,499],{},"If the GeoIP city database is available, the following may also be available:",[417,501,504],{"className":502,"code":503,"language":422},[420],"region:   CA,\ncity:     San Francisco,\nll:       [37.7484, -122.4156],\ndistance: 1539    \u002F\u002F in kilometers\nrange:    [ 3479299040, 3479299071 ],\n",[424,505,503],{"__ignoreMap":426},[384,507,508,511],{},[424,509,510],{},"connect.geoip"," also adds entries like this to your logs:",[417,513,516],{"className":514,"code":515,"language":422},[420],"[connect.geoip] US\n[connect.geoip] US, WA\n[connect.geoip] US, WA, Seattle\n[connect.geoip] US, WA, Seattle, 1319km\n",[424,517,515],{"__ignoreMap":426},[384,519,520,521,524,525,528],{},"Calculating the distance requires the public IP of this mail server. This may\nbe the IP that Haraka is bound to. If not, make sure that ",[424,522,523],{},"utils.get_public_ip","\ncan figure it out (via STUN or in ",[424,526,527],{},"smtp.ini",").",[388,530,532],{"id":531},"config","CONFIG",[534,535,536],"ul",{},[537,538,539],"li",{},"distance",[384,541,542],{},"Perform the geodesic distance calculations. Calculates the distance \"as the\ncrow flies\" from the remote mail server.",[384,544,545,546,549],{},"This calculation requires a 'from' IP address. This will typically be the\npublic IP of your mail server. If Haraka is bound to a private IP, net_utils\nwill attempt to determine your public IP. If that doesn't work, edit\nconfig\u002Fsmtp.ini and set ",[424,547,548],{},"public_ip",".",[534,551,552],{},[537,553,554],{},"show_city",[384,556,557],{},"show city data in logs and headers. City data is less accurate than country.",[534,559,560],{},[537,561,562],{},"show_region in logs and headers. Regional data are US states, Canadian\nprovinces and such.",[384,564,565],{},"Set a connection result to true if the distance exceeds this many kilometers.",[534,567,568,571],{},[537,569,570],{},"too_far=4000",[537,572,573,575],{},[442,574,116],{},"report_as",[384,577,578],{},"Permits reporting the ASN as another plugin (such as connect.asn).",[388,580,582],{"id":581},"spam-prediction-with-distance","SPAM PREDICTION WITH DISTANCE",[384,584,585],{},[396,586,589],{"href":587,"rel":588},"http:\u002F\u002Fwww.cc.gatech.edu\u002F~feamster\u002Fpapers\u002Fsnare-usenix09.pdf",[400],"Spatio-temporal Network-level Automatic Reputation Engine",[417,591,594],{"className":592,"code":593,"language":422},[420],"\"For ham, 90% of the messages travel about 4,000 km or less. On the\nother hand, for spam, only 28% of messages stay within this range.\"\n",[424,595,593],{"__ignoreMap":426},[384,597,598],{},"Observations in 2014 suggest that geodesic distance continues to be an\nexcellent predictor of spam.",[388,600,602],{"id":601},"limitations","LIMITATIONS",[384,604,605],{},"The distance calculations are more concerned with being fast than\naccurate. The MaxMind location data is collected from whois and is of\nlimited accuracy. MaxMind offers more accurate data for a fee.",[384,607,608],{},"For distance calculations, the earth is considered a perfect sphere. In\nreality, it is not. Accuracy should be within 1%.",[384,610,611],{},"This plugin does not update the GeoIP databases. You may want to.",[388,613,615],{"id":614},"see-also","SEE ALSO",[384,617,618,619],{},"MaxMind: ",[396,620,621],{"href":621,"rel":622},"http:\u002F\u002Fwww.maxmind.com\u002F",[400],[384,624,625,626],{},"Databases: ",[396,627,628],{"href":628,"rel":629},"https:\u002F\u002Fdev.maxmind.com\u002Fgeoip\u002Fgeolite2-free-geolocation-data",[400],[388,631,633],{"id":632},"todo","TODO",[384,635,636],{},"Keep an eye on node-geoip and see if they add ASN support. This would be an\nalternative to connect.asn which uses a DNS lookup to retrieve the ASN.",[638,639,640],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(