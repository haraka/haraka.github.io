ns\u002Fsyslog","8.plugins\u002Fsyslog",{"title":354,"path":355,"stem":356},"tarpit","\u002Fplugins\u002Ftarpit","8.plugins\u002Ftarpit",{"title":358,"path":359,"stem":360},"tls","\u002Fplugins\u002Ftls","8.plugins\u002Ftls",{"title":362,"path":363,"stem":364},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":366,"path":367,"stem":368},"uribl","\u002Fplugins\u002Furibl","8.plugins\u002Furibl",{"title":370,"path":371,"stem":372},"watch","\u002Fplugins\u002Fwatch","8.plugins\u002Fwatch",{"title":374,"path":375,"stem":376},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":378,"title":379,"body":380,"description":712,"extension":713,"links":714,"meta":715,"navigation":716,"path":218,"seo":717,"stem":219,"__hash__":718},"docs\u002F8.plugins\u002Fgreylist.md","Greylist - Greylisting plugin for Haraka",{"type":381,"value":382,"toc":702},"minimark",[383,387,392,397,405,428,433,471,474,477,509,513,516,579,583,586,589,597,603,614,641,646,652,676,680,683,694,697],[384,385,386],"p",{},"Basic greylisting plugin that follows common practices found on internets.",[388,389,391],"h2",{"id":390},"principles-of-work","Principles of work",[393,394,396],"h3",{"id":395},"notation","Notation",[384,398,399,400,404],{},"The so-called ",[401,402,403],"em",{},"tuple"," consists of the following:",[406,407,408,416,422],"ul",{},[409,410,411,412,415],"li",{},"First subdomain of rDNS is stripped off (but no shorter than the domain boundary). This is considered a ",[401,413,414],{},"hostid",".",[409,417,418,419,415],{},"Envelope sender is the ",[401,420,421],{},"sender",[409,423,424,425,415],{},"RCPT TO would supply the ",[401,426,427],{},"recipient",[384,429,430,432],{},[401,431,414],{}," in above notation is chosen unless:",[434,435,436,443,448,456,461,466],"ol",{},[409,437,438,439],{},"The connecting host has no PTR record, a.k.a. reverse DNS (rDNS). ",[440,441,442],"span",{},"gl",[409,444,445,446],{},"The rDNS record contains the first two or last two octets of the IP address. ",[440,447,205],{},[409,449,450,451,453,454],{},"The rDNS record contains the ‘short’, decimal, or hex representation of the full IP address. ",[440,452,205],{}," ",[440,455,442],{},[409,457,458,459],{},"Multiple rDNS records are returned. ",[440,460,442],{},[409,462,463,464],{},"The rDNS record cannot be verified by forward confirmation (e.g. FCrDNS). ",[440,465,205],{},[409,467,468,469],{},"The top-level-domain (TLD) used is not valid. ",[440,470,442],{},[384,472,473],{},"In other cases, it's set to be the remote party's IP address.",[384,475,476],{},"We define the following time periods:",[406,478,479,489,501],{},[409,480,481,484,485,488],{},[401,482,483],{},"black",":  between first connect and start of ",[401,486,487],{},"gray",". Defer.",[409,490,491,493,494,496,497,500],{},[401,492,487],{},":   between ",[401,495,483],{}," and start of ",[401,498,499],{},"white",". Allow. Host must re-try within this window.",[409,502,503,505,506,508],{},[401,504,499],{},":  comes after ",[401,507,487],{},". Allow up until the end of period, then let the record expire in case no connections were made.",[393,510,512],{"id":511},"algorithm","Algorithm",[384,514,515],{},"The greylist algo is as following:",[406,517,518,521,572],{},[409,519,520],{},"Party connects. All FcrDNS & DNSWL checks are run by earlier plugins.",[409,522,523,524,526],{},"Party sends ",[401,525,427],{},[406,527,528],{},[409,529,530,531],{},"If not already whitelisted\n",[406,532,533],{},[409,534,535,536,538,539],{},"Check ",[401,537,403],{}," color (compare current TS against record creation TS)\n",[406,540,541,551,563],{},[409,542,543,545,546],{},[401,544,483],{},"?\n",[406,547,548],{},[409,549,550],{},"Create if no record exists. Defer.",[409,552,553,545,555],{},[401,554,487],{},[406,556,557],{},[409,558,559,560,562],{},"Allow. Promote record to ",[401,561,499],{}," status.",[409,564,565,545,567],{},[401,566,499],{},[406,568,569],{},[409,570,571],{},"Allow. Update record TS.",[409,573,574,575,578],{},"In special case, ",[401,576,577],{},"data"," hook runs above algo for all recipients. If any matched, all inherit the action.",[393,580,582],{"id":581},"db-schema","DB schema",[384,584,585],{},"We store in Redis.",[384,587,588],{},"Key format for greylisting entries:",[406,590,591,594],{},[409,592,593],{},"grey:${hostid}:${sender}:${recipient} - grey record",[409,595,596],{},"white:${hostid} - white record",[384,598,599,600,602],{},"For ",[401,601,499],{},":",[604,605,610],"pre",{"className":606,"code":608,"language":609},[607],"language-text","{ first_connect: TS, whitelisted: TS, updated: TS, lifetime: TTL, tried: Integer, tried_when_greylisted: Integer }\n","text",[611,612,608],"code",{"__ignoreMap":613},"",[384,615,616,617,620,621,624,625,628,629,632,633,636,637,640],{},"Where\n",[401,618,619],{},"first_connect",": TS of first connection (sender)\n",[401,622,623],{},"whitelisted",": basically the TS of this entry creation\n",[401,626,627],{},"updated",": last update TS\n",[401,630,631],{},"lifetime",": seconds for this entry to exist (== TTL)\n",[401,634,635],{},"tried",": number of checks against this entry\n",[401,638,639],{},"tried_when_greylisted",": number of checks while the host was +grey+ (sender).",[384,642,599,643,602],{},[401,644,645],{},"grey",[604,647,650],{"className":648,"code":649,"language":609},[607],"{ created: TS, updated: TS, lifetime: TTL, tried: Integer }\n",[611,651,649],{"__ignoreMap":613},[384,653,616,654,657,658,660,661,663,664,628,666,632,668,670,671,660,673,675],{},[401,655,656],{},"created",": TS of first connection (copied to ",[401,659,619],{}," of ",[401,662,499],{}," after promotion)\n",[401,665,627],{},[401,667,631],{},[401,669,635],{},": number of checks against this entry (copied to ",[401,672,639],{},[401,674,499],{}," after promotion)",[393,677,679],{"id":678},"whitelisting","Whitelisting",[384,681,682],{},"It's possible to whitelist hosts using the following section in greylist.ini config file:",[406,684,685,688,691],{},[409,686,687],{},"ip_whitelist               IP or subnet (prefix notation)",[409,689,690],{},"envelope_whitelist         MAIL FROM (email or domain)",[409,692,693],{},"recipient_whitelist        RCPT TO  (email or domain)",[384,695,696],{},"List of known dynamic hosts, to use the IP instead of the domain:",[406,698,699],{},[409,700,701],{},"special_dynamic_domains    Domain",{"title":613,"searchDepth":703,"depth":703,"links":704},2,[705],{"id":390,"depth":703,"text":391,"children":706},[707,709,710,711],{"id":395,"depth":708,"text":396},3,{"id":511,"depth":708,"text":512},{"id":581,"depth":708,"text":582},{"id":678,"depth":708,"text":679},"Haraka greylist plugin - Delays delivery of mail from new senders","md",null,{},{"title":217},{"title":379,"description":712},"4dPKJkykLZb3h74MwPM8o9t0AgvioIWTtjnAhnkRZ4Y",[720,722],{"title":213,"path":214,"stem":215,"description":721,"children":-1},"Haraka graph plugin - Graphs",{"title":221,"path":222,"stem":223,"description":723,"children":-1},"Haraka data.headers plugin - Header Checks",1794456871504]