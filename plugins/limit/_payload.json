2Fsyslog","8.plugins\u002Fsyslog",{"title":354,"path":355,"stem":356},"tarpit","\u002Fplugins\u002Ftarpit","8.plugins\u002Ftarpit",{"title":358,"path":359,"stem":360},"tls","\u002Fplugins\u002Ftls","8.plugins\u002Ftls",{"title":362,"path":363,"stem":364},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":366,"path":367,"stem":368},"uribl","\u002Fplugins\u002Furibl","8.plugins\u002Furibl",{"title":370,"path":371,"stem":372},"watch","\u002Fplugins\u002Fwatch","8.plugins\u002Fwatch",{"title":374,"path":375,"stem":376},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":378,"title":379,"body":380,"description":557,"extension":558,"links":559,"meta":560,"navigation":561,"path":234,"seo":562,"stem":235,"__hash__":563},"docs\u002F8.plugins\u002Flimit.md","limit - Limits plugin for Haraka",{"type":381,"value":382,"toc":543},"minimark",[383,387,390,394,406,409,414,420,423,434,437,443,446,459,463,476,479,485,496,501,505,512,523,527,530,540],[384,385,386],"p",{},"Apply several types of limits to SMTP connections.",[384,388,389],{},"Each limit type has a max value that can be defined in limit.ini. The default is empty \u002F disabled until a value has been set.",[391,392,393],"h2",{"id":393},"concurrency",[384,395,396,397,401,402,405],{},"When ",[398,399,400],"code",{},"[concurrency]max"," is defined, it limits the maximum number of simultaneous connections per IP address. Connection attempts in excess of the limit are delayed for ",[398,403,404],{},"disconnect_delay"," seconds (default: 3) before being disconnected.",[384,407,408],{},"This works best in conjunction with a history \u002F reputation database, so that\none can assign very low concurrency (1) to bad or unknown senders and higher\nlimits for reputable mail servers.",[410,411,413],"h3",{"id":412},"history","History",[384,415,416,417,419],{},"History: when enabled, the ",[398,418,412],{}," setting is the name of a plugin that stores IP history \u002F reputation results. The result store must have a positive value for good connections and negative integers for poor \u002F undesirable connections. Karma is one such plugin.",[391,421,422],{"id":422},"recipients",[384,424,396,425,428,429,433],{},[398,426,427],{},"[recipients]max"," is defined, each connection is limited to that number of recipients. The limit is imposed against ",[430,431,432],"strong",{},"all"," recipient attempts. Attempts in excess of the limit are issued a temporary failure.",[391,435,436],{"id":436},"unrecognized_commands",[384,438,396,439,442],{},[398,440,441],{},"[unrecognized_commands]max"," is set, a connection that exceeeds the limit is disconnected.",[384,444,445],{},"Unrecognized commands are normally SMTP verbs invalidly issued by the client.\nExamples:",[447,448,449,453,456],"ul",{},[450,451,452],"li",{},"issuing AUTH when we didn't advertise AUTH extension",[450,454,455],{},"issuing STARTTLS when we didn't advertise STARTTLS",[450,457,458],{},"invalid SMTP verbs",[410,460,462],{"id":461},"limitations","Limitations",[384,464,465,466,468,469,472,473,475],{},"The unrecognized_command hook is used by the ",[398,467,358],{}," and ",[398,470,471],{},"auth"," plugins, so\nrunning this plugin before those would result in valid operations getting\ncounted against that connections limits. The solution is simple: list\n",[398,474,233],{}," in config\u002Fplugins after those.",[391,477,478],{"id":478},"errors",[384,480,396,481,484],{},[398,482,483],{},"[errors]max"," is set, a connection that exceeeds the limit is disconnected. Errors that count against this limit include:",[447,486,487,490,493],{},[450,488,489],{},"issuing commands out of turn (MAIL before EHLO, RCPT before MAIL, etc)",[450,491,492],{},"attempting MAIL on port 465\u002F587 without AUTH",[450,494,495],{},"MAIL or RCPT addresses that fail to parse",[497,498,500],"h1",{"id":499},"error-handling","Error Handling",[391,502,504],{"id":503},"too-high-counters","Too high counters",[384,506,507,508,511],{},"If the NoSQL store is Redis and Haraka is restarted or crashes while active\nconnections are open, the concurrency counters might be inflated. This is\nhandled by the ",[509,510,393],"span",{},"reset setting (default: 10m), which:",[447,513,514,517,520],{},[450,515,516],{},"ssc: sets collection expiration time",[450,518,519],{},"redis: empties the concurrency hash",[450,521,522],{},"RAM: empties the in-memory hash of all keys",[391,524,526],{"id":525},"too-low-counters","Too low counters",[384,528,529],{},"Because the redis and RAM objects are emptied periodically, connections that\nare open while the collections are emptied will be too low. When\nthat happens, log messages like these might be emitted:",[531,532,537],"pre",{"className":533,"code":535,"language":536},[534],"language-text","resetting 0 to 1\nresetting -1 to 1\n","text",[398,538,535],{"__ignoreMap":539},"",[384,541,542],{},"This is a harmless error condition that is repaired automatically.",{"title":539,"searchDepth":544,"depth":544,"links":545},2,[546,550,551,554,555,556],{"id":393,"depth":544,"text":393,"children":547},[548],{"id":412,"depth":549,"text":413},3,{"id":422,"depth":544,"text":422},{"id":436,"depth":544,"text":436,"children":552},[553],{"id":461,"depth":549,"text":462},{"id":478,"depth":544,"text":478},{"id":503,"depth":544,"text":504},{"id":525,"depth":544,"text":526},"Haraka limit plugin - Limits the number of messages per connection","md",null,{},{"title":233},{"title":379,"description":557},"uFpx65PKF4ZmagVM2-Pg44sffr7v2Bd_RcuePwbiYRE",[565,567],{"title":229,"path":230,"stem":231,"description":566,"children":-1},"Haraka karma plugin - a scoring engine for Haraka",{"title":237,"path":238,"stem":239,"description":568,"children":-1},"Haraka mail_from.is_resolvable plugin - Rejects messages with unresolvable mail_from domains",1794456871596]