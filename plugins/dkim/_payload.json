435,185],{"class":409},[399,437,438],{"class":432},"\"",[399,440,441],{"class":432}," >>",[399,443,444],{"class":409}," config\u002Fplugins\n",[399,446,448,451,454],{"class":401,"line":447},4,[399,449,450],{"class":416},"service",[399,452,453],{"class":409}," haraka",[399,455,456],{"class":409}," restart\n",[458,459,461],"h3",{"id":460},"configuration","Configuration",[463,464,465],"p",{},"If the default configuration is not sufficient, copy the config file from the distribution into your haraka config dir and then modify it:",[389,467,469],{"className":391,"code":468,"language":393,"meta":394,"style":394},"cp node_modules\u002Fharaka-plugin-dkim\u002Fconfig\u002Fdkim.ini config\u002Fdkim.ini\n$EDITOR config\u002Fdkim.ini\n",[396,470,471,482],{"__ignoreMap":394},[399,472,473,476,479],{"class":401,"line":402},[399,474,475],{"class":416},"cp",[399,477,478],{"class":409}," node_modules\u002Fharaka-plugin-dkim\u002Fconfig\u002Fdkim.ini",[399,480,481],{"class":409}," config\u002Fdkim.ini\n",[399,483,484],{"class":401,"line":413},[399,485,487],{"class":486},"sTEyZ","$EDITOR config\u002Fdkim.ini\n",[384,489,491],{"id":490},"signing","SIGNING",[463,493,494,495,500],{},"This plugin implements the ",[496,497,499],"a",{"href":498},"dkimcore.org","DKIM Core specification",".",[458,502,5],{"id":503},"getting-started",[463,505,506],{},"Generate a DKIM selector and keys for your domain:",[389,508,510],{"className":391,"code":509,"language":393,"meta":394,"style":394},"cd \u002Fpath\u002Fto\u002Fharaka\u002Fconfig\u002Fdkim\n.\u002Fdkim_key_gen.sh example.org\n",[396,511,512,519],{"__ignoreMap":394},[399,513,514,516],{"class":401,"line":402},[399,515,406],{"class":405},[399,517,518],{"class":409}," \u002Fpath\u002Fto\u002Fharaka\u002Fconfig\u002Fdkim\n",[399,520,521,524],{"class":401,"line":413},[399,522,523],{"class":416},".\u002Fdkim_key_gen.sh",[399,525,526],{"class":409}," example.org\n",[463,528,529],{},"Within the config\u002Fdkim\u002F${domain} directory will be 4 files:",[389,531,533],{"className":391,"code":532,"language":393,"meta":394,"style":394},"ls config\u002Fdkim\u002Fexample.org\u002F\ndns private public selector\n",[396,534,535,543],{"__ignoreMap":394},[399,536,537,540],{"class":401,"line":402},[399,538,539],{"class":416},"ls",[399,541,542],{"class":409}," config\u002Fdkim\u002Fexample.org\u002F\n",[399,544,545,548,551,554],{"class":401,"line":413},[399,546,547],{"class":416},"dns",[399,549,550],{"class":409}," private",[399,552,553],{"class":409}," public",[399,555,556],{"class":409}," selector\n",[463,558,559,560,563,564,567],{},"The selector file contains the DNS label where the DKIM public key is published. The ",[396,561,562],{},"private"," and ",[396,565,566],{},"public"," files contain the DKIM keys.",[463,569,570,571,573],{},"The ",[396,572,547],{}," file contains a formatted record of the public key suitable for copy\u002Fpasting into your domains zone file. It also has suggestions for DKIM, SPF, and DMARC policy records.",[463,575,576],{},"The DKIM DNS record will look like this:",[389,578,583],{"className":579,"code":581,"language":582},[580],"language-text","may2013._domainkey TXT \"v=DKIM1;p=[public key stripped of whitespace];\"\n","text",[396,584,581],{"__ignoreMap":394},[463,586,587],{},"The values in the address have the following meaning:",[389,589,592],{"className":590,"code":591,"language":582},[580],"hash: h=[ sha1 | sha256 ]\ntest; t=[ s | s:y ]\ngranularity: g=[ ]\nnotes: n=[ ]\nservices: s=[email]\nkeytypes: [ rsa ]\n",[396,593,591],{"__ignoreMap":394},[384,595,597],{"id":596},"key-size","Key size",[463,599,600,601,604],{},"The default key size created by ",[396,602,603],{},"dkim_key_gen.sh"," is 2048. That is considered secure as of mid-2024.",[606,607,609],"h1",{"id":608},"what-to-sign","What to sign",[463,611,612,613,617,618,621],{},"The DKIM signing key for messages from example.org ",[614,615,616],"em",{},"should"," be signed with\na DKIM key for example.org. Failing to do so will result in messages not\nhaving an ",[614,619,620],{},"aligned"," DKIM signature. For DMARC enabled domains, this will\nlikely result in deliverability problems.",[463,623,624],{},"For correct alignment, Haraka signs each message with that domains DKIM key.\nFor an alternative, see the legacy Single Domain Configuration below.",[606,626,461],{"id":627},"configuration-1",[463,629,630,631,500],{},"DKIM signing is configured in the sign section of ",[396,632,633],{},"dkim.ini",[389,635,639],{"className":636,"code":637,"language":638,"meta":394,"style":394},"language-ini shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","[sign]\nenabled = [ 1 | true | yes ], default=false\nheaders = list, of; headers (REQUIRED)\n\n; for single domain configuration\nselector = name\ndomain = name\n","ini",[396,640,641,646,651,656,662,668,674],{"__ignoreMap":394},[399,642,643],{"class":401,"line":402},[399,644,645],{},"[sign]\n",[399,647,648],{"class":401,"line":413},[399,649,650],{},"enabled = [ 1 | true | yes ], default=false\n",[399,652,653],{"class":401,"line":426},[399,654,655],{},"headers = list, of; headers (REQUIRED)\n",[399,657,658],{"class":401,"line":447},[399,659,661],{"emptyLinePlaceholder":660},true,"\n",[399,663,665],{"class":401,"line":664},5,[399,666,667],{},"; for single domain configuration\n",[399,669,671],{"class":401,"line":670},6,[399,672,673],{},"selector = name\n",[399,675,677],{"class":401,"line":676},7,[399,678,679],{},"domain = name\n",[681,682,683],"ul",{},[684,685,686],"li",{},"headers: the list of headers that should be signed, separated by commas, colons or semi-colons. Signing prevents tampering with the specified headers. The 'From' header is required by the RFC and will be added if missing.",[384,688,690],{"id":689},"single-domain-configuration","Single Domain Configuration",[463,692,693,694,697],{},"To sign all messages with a single DKIM key, you must set the selector and domain in dkim.ini. You must also save your DKIM private key in the file ",[396,695,696],{},"dkim.private.key"," in the Haraka config directory.",[681,699,700,703],{},[684,701,702],{},"selector - Set this to the selector name published in DNS under the _domainkey sub-domain of the domain referenced below.",[684,704,705,706],{},"domain - Set this to the domain name that will be used to sign messages which don't match a per-domain DKIM key. The DNS TXT entry for:",[707,708,709,710],"selector",{},"\n._domainkey.\n",[711,712],"domain",{},[463,714,715],{},"Test that your DKIM key is published properly with a DNS request like this:",[389,717,719],{"className":391,"code":718,"language":393,"meta":394,"style":394},"drill TXT $SELECTOR._domainkey.$DOMAIN\ndig TXT $SELECTOR._domainkey.$DOMAIN +short\n",[396,720,721,738],{"__ignoreMap":394},[399,722,723,726,729,732,735],{"class":401,"line":402},[399,724,725],{"class":416},"drill",[399,727,728],{"class":409}," TXT",[399,730,731],{"class":486}," $SELECTOR",[399,733,734],{"class":409},"._domainkey.",[399,736,737],{"class":486},"$DOMAIN\n",[399,739,740,743,745,747,749,752],{"class":401,"line":413},[399,741,742],{"class":416},"dig",[399,744,728],{"class":409},[399,746,731],{"class":486},[399,748,734],{"class":409},[399,750,751],{"class":486},"$DOMAIN ",[399,753,754],{"class":409},"+short\n",[458,756,758],{"id":757},"example-dns-query","Example DNS query",[389,760,762],{"className":391,"code":761,"language":393,"meta":394,"style":394},"export SELECTOR=mar2013\nexport DOMAIN=simerson.net\n$ dig TXT $SELECTOR._domainkey.$DOMAIN +short\n\"v=DKIM1;p=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAoyUzGOTSOmakY8BcxXgi0mN\u002FnFegLBPs7aaGQUtjHfa8yUrt9T2j6GSXgdjLuG3R43WjePQv3RHzc+bwwOkdw0XDOXiztn5mhrlaflbVr5PMSTrv64\u002FcpFQKLtgQx8Vgqp7Dh3jw13rLomRTqJFgMrMHdhIibZEa69gtuAfDqoeXo6QDSGk5JuBAeRHEH27FriHulg5ob\" \"4F4lmh7fMFVsDGkQEF6jaIVYqvRjDyyQed3R3aTJX3fpb3QrtRqvfn\u002FLAf+3kzW58AjsERpsNCSTD2RquxbnyoR\u002F1wdGKb8cUlD\u002FEXvqtvpVnOzHeSeMEqex3kQI8HOGsEehWZlKd+GqwIDAQAB\"\n",[396,763,764,779,791,809],{"__ignoreMap":394},[399,765,766,770,773,776],{"class":401,"line":402},[399,767,769],{"class":768},"spNyl","export",[399,771,772],{"class":486}," SELECTOR",[399,774,775],{"class":432},"=",[399,777,778],{"class":486},"mar2013\n",[399,780,781,783,786,788],{"class":401,"line":413},[399,782,769],{"class":768},[399,784,785],{"class":486}," DOMAIN",[399,787,775],{"class":432},[399,789,790],{"class":486},"simerson.net\n",[399,792,793,796,799,801,803,805,807],{"class":401,"line":426},[399,794,795],{"class":416},"$",[399,797,798],{"class":409}," dig",[399,800,728],{"class":409},[399,802,731],{"class":486},[399,804,734],{"class":409},[399,806,751],{"class":486},[399,808,754],{"class":409},[399,810,811,814,816,819],{"class":401,"line":447},[399,812,813],{"class":416},"\"v=DKIM1;p=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAoyUzGOTSOmakY8BcxXgi0mN\u002FnFegLBPs7aaGQUtjHfa8yUrt9T2j6GSXgdjLuG3R43WjePQv3RHzc+bwwOkdw0XDOXiztn5mhrlaflbVr5PMSTrv64\u002FcpFQKLtgQx8Vgqp7Dh3jw13rLomRTqJFgMrMHdhIibZEa69gtuAfDqoeXo6QDSGk5JuBAeRHEH27FriHulg5ob\"",[399,815,433],{"class":432},[399,817,818],{"class":409},"4F4lmh7fMFVsDGkQEF6jaIVYqvRjDyyQed3R3aTJX3fpb3QrtRqvfn\u002FLAf+3kzW58AjsERpsNCSTD2RquxbnyoR\u002F1wdGKb8cUlD\u002FEXvqtvpVnOzHeSeMEqex3kQI8HOGsEehWZlKd+GqwIDAQAB",[399,820,821],{"class":432},"\"\n",[606,823,825],{"id":824},"dkim-verify","DKIM VERIFY",[463,827,828],{},"Verify DKIM signatures as defined by RFC 6376 and add an Authentication-Results header as appropriate.",[384,830,461],{"id":831},"configuration-2",[389,833,835],{"className":636,"code":834,"language":638,"meta":394,"style":394},"[verify]\n; allowed_time_skew = (How far can we stretch on time matching, in secs. Useful when clock is skewed.)\n; sigerror_log_level =\n",[396,836,837,842,847],{"__ignoreMap":394},[399,838,839],{"class":401,"line":402},[399,840,841],{},"[verify]\n",[399,843,844],{"class":401,"line":413},[399,845,846],{},"; allowed_time_skew = (How far can we stretch on time matching, in secs. Useful when clock is skewed.)\n",[399,848,849],{"class":401,"line":426},[399,850,851],{},"; sigerror_log_level =\n",[384,853,855],{"id":854},"testing","Testing",[463,857,858],{},"This plugin provides a command-line test tool that can be used to\ndebug DKIM issues or to check results.",[389,860,863],{"className":861,"code":862,"language":582},[580],"# dkimverify \u003C message\nidentity=\"@gmail.com\" domain=\"gmail.com\" result=pass\n",[396,864,862],{"__ignoreMap":394},[463,866,867,868,871],{},"You can add ",[396,869,870],{},"--debug"," to the option arguments to see a full trace of the processing.",[384,873,875],{"id":874},"notes","Notes",[463,877,878],{},"This plugin and underlying library do not currently support DKIM body length limits (l=).",[880,881,882],"style",{},"html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-sty