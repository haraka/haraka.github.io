eck]\n",[396,429,431],{"class":423,"line":430},2,[396,432,433],{},"reject_all=false\n",[396,435,437],{"class":423,"line":436},3,[396,438,439],{},"single_recipient=true\n",[396,441,443],{"class":423,"line":442},4,[396,444,445],{},"empty_return_path=true\n",[396,447,449],{"class":423,"line":448},5,[396,450,451],{},"bad_rcpt=true\n",[396,453,455],{"class":423,"line":454},6,[396,456,457],{},"bounce_spf=true\n",[396,459,461],{"class":423,"line":460},7,[396,462,463],{},"non_local_msgid=true\n",[396,465,467],{"class":423,"line":466},8,[396,468,470],{"emptyLinePlaceholder":469},true,"\n",[396,472,474],{"class":423,"line":473},9,[396,475,476],{},"[reject]\n",[396,478,480],{"class":423,"line":479},10,[396,481,439],{},[396,483,485],{"class":423,"line":484},11,[396,486,445],{},[396,488,490],{"class":423,"line":489},12,[396,491,492],{},"bounce_spf=false\n",[396,494,496],{"class":423,"line":495},13,[396,497,498],{},"non_local_msgid=false\n",[388,500,502],{"id":501},"features","Features",[504,505,506],"h3",{"id":506},"reject_all",[384,508,509,510,513],{},"When enabled, blocks all bounce messages using the simple rule of checking\nfor ",[401,511,512],{},"MAIL FROM:\u003C>",".",[384,515,516],{},"It is generally a bad idea to block all bounces. This option can be useful\nfor mail servers at domains with frequent spoofing and few or no human users.",[504,518,519],{"id":519},"single_recipient",[384,521,522],{},"Valid bounces have a single recipient. Assure that the message really is a\nbounce by enforcing bounces to be addressed to a single recipient.",[384,524,525],{},"This check is skipped for relays or hosts with a private IP, this is because\nMicrosoft Exchange distribution lists will send messages to list members with\na null return-path when the 'Do not send delivery reports' option is enabled\n(yes, really...).",[504,527,528],{"id":528},"empty_return_path",[384,530,531],{},"Valid bounces should have an empty return path. Test for the presence of the\nReturn-Path header in bounces and disallow.",[504,533,534],{"id":534},"bad_rcpt",[384,536,537,538,513],{},"Disallow bounces to email addresses listed in ",[401,539,540],{},"config\u002Fbounce_bad_rcpt",[384,542,543,544,548,549,554,555,559],{},"Include email addresses in that file that should ",[545,546,547],"em",{},"never"," receive bounce\nmessages. Examples of email addresses that should be listed are:\nautoresponders, ",[550,551,553],"a",{"href":552},"mailto:do-not-reply@example.com","do-not-reply@example.com",", ",[550,556,558],{"href":557},"mailto:dmarc-feedback@example.com","dmarc-feedback@example.com",", and\nany other email addresses used solely for machine generated messages.",[504,561,562],{"id":562},"bounce_spf",[384,564,565],{},"Parses the message body and any MIME parts for Received: headers and\nstrips out the IP addresses of each Received hop and then checks what\nthe SPF result would have been if bounced message had been sent by that\nhop.",[384,567,568],{},"If no 'Pass' result is found, then this test will fail.\nIf SPF returns 'None', 'TempError' or 'PermError' then the test will\nbe skipped.",[570,571,572],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":418,"searchDepth":430,"depth":430,"links":574},[575,576],{"id":390,"depth":430,"text":391},{"id":501,"depth":430,"text":502,"children":577},[578,579,580,581,582],{"id":506,"depth":436,"text":506},{"id":519,"depth":436,"text":519},{"id":528,"depth":436,"text":528},{"id":534,"depth":436,"text":534},{"id":562,"depth":436,"text":562},"Haraka bounce plugin - Bounces mail to a specific address","md",null,{},{"title":161},{"title":379,"description":583},"yLWH-bPEXisyeSX5T3b6bnfV_UDCtsmiADfF-ue68Dw",[591,593],{"title":157,"path":158,"stem":159,"description":592,"children":-1},"Haraka block_me plugin - Blocks mail from a specific IP address",{"title":165,"path":166,"stem":167,"description":594,"children":-1},"Haraka clamd plugin - ClamAV anti-virus plugin",1794456870595]