gins\u002Ftls",{"title":210,"path":211,"stem":212},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":214,"path":215,"stem":216},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":218,"title":219,"body":220,"description":329,"extension":330,"links":331,"meta":332,"navigation":333,"path":183,"seo":334,"stem":184,"__hash__":335},"docs\u002F8.plugins\u002Fqueue\u002Fsmtp_proxy.md","queue\u002Fsmtp_proxy - Deliver mail to the proxy MTA",{"type":221,"value":222,"toc":324},"minimark",[223,227,234,239],[224,225,226],"p",{},"This plugin delivers to another mail server. This is a common setup when you\nwant to have a mail server with a solid pedigree of outbound delivery to\nother hosts, and inbound delivery to users.",[224,228,229,230,233],{},"In comparison to ",[231,232,178],"code",{},", this plugin makes a connection at\nMAIL FROM time to the ongoing SMTP server. This can be a benefit in that\nyou get any SMTP-time filtering that the ongoing server provides, in\nparticular one important facility to some setups is recipient filtering.\nHowever be aware that other than connect and HELO-time filtering, you will\nhave as many connections to your ongoing SMTP server as you have to Haraka.",[235,236,238],"h2",{"id":237},"configuration","Configuration",[240,241,242],"ul",{},[243,244,245,246,249,250,259,261,262],"li",{},"smtp_proxy.ini",[247,248],"br",{},"Configuration is stored in this file in the following keys:",[240,251,252],{},[243,253,254,255],{},"enable_outbound=",[256,257,258],"span",{},"true",[247,260],{},"SMTP proxy outbound messages (set to false to enable Haraka's\nseparate Outbound mail routing (MX based delivery)).",[240,263,264,270,276,282,288,294,303,312,318],{},[243,265,266,267,269],{},"host=HOST",[247,268],{},"The host to connect to.",[243,271,272,273,275],{},"port=PORT",[247,274],{},"The port to connect to.",[243,277,278,279,281],{},"connect_timeout=SECONDS",[247,280],{},"The maximum amount of time to wait when creating a new connection\nto the host.  Default if unspecified is 30 seconds.",[243,283,284,285,287],{},"timeout=SECONDS",[247,286],{},"The amount of seconds to let a backend connection live idle in the\nproxy pool.  This should always be less than the global plugin timeout,\nwhich should in turn be less than the connection timeout.",[243,289,290,291,293],{},"max_connections=NUMBER",[247,292],{},"Maximum number of connections to create at any given time.",[243,295,296,297,300,302],{},"enable_tls=",[256,298,299],{},"true|yes|1",[247,301],{},"Enable TLS with the forward host (if supported). TLS uses options from\nthe tls plugin.",[243,304,305,306,309,311],{},"auth_type=",[256,307,308],{},"plain|login",[247,310],{},"Enable PLAIN or LOGIN SMTP AUTH.  This is required to enable AUTH.",[243,313,314,315,317],{},"auth_user=USERNAME",[247,316],{},"SMTP AUTH username to use.",[243,319,320,321,323],{},"auth_pass=PASSWORD",[247,322],{},"SMTP AUTH password to use.",{"title":325,"searchDepth":326,"depth":326,"links":327},"",2,[328],{"id":237,"depth":326,"text":238},"Haraka queue\u002Fsmtp_proxy plugin - Deliver mail to the proxy MTA","md",null,{},{"title":182},{"title":219,"description":329},"OaJi3nLJzFUIlYdEJ4Z_F7zQOZV6ZIjixNgj-37JN2M",[337,339],{"title":178,"path":179,"stem":180,"description":338,"children":-1},"Haraka queue\u002Fsmtp_forward plugin - Forward mail to another SMTP server",{"title":186,"path":187,"stem":188,"description":340,"children":-1},"Haraka rcpt_to.in_host_list plugin - Check if recipient is in host_list",1794458078411]