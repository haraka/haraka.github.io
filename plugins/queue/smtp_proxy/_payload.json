og","\u002Fplugins\u002Fsyslog","8.plugins\u002Fsyslog",{"title":354,"path":355,"stem":356},"tarpit","\u002Fplugins\u002Ftarpit","8.plugins\u002Ftarpit",{"title":358,"path":359,"stem":360},"tls","\u002Fplugins\u002Ftls","8.plugins\u002Ftls",{"title":362,"path":363,"stem":364},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":366,"path":367,"stem":368},"uribl","\u002Fplugins\u002Furibl","8.plugins\u002Furibl",{"title":370,"path":371,"stem":372},"watch","\u002Fplugins\u002Fwatch","8.plugins\u002Fwatch",{"title":374,"path":375,"stem":376},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":378,"title":379,"body":380,"description":489,"extension":490,"links":491,"meta":492,"navigation":493,"path":299,"seo":494,"stem":300,"__hash__":495},"docs\u002F8.plugins\u002Fqueue\u002Fsmtp_proxy.md","queue\u002Fsmtp_proxy - Deliver mail to the proxy MTA",{"type":381,"value":382,"toc":484},"minimark",[383,387,394,399],[384,385,386],"p",{},"This plugin delivers to another mail server. This is a common setup when you\nwant to have a mail server with a solid pedigree of outbound delivery to\nother hosts, and inbound delivery to users.",[384,388,389,390,393],{},"In comparison to ",[391,392,294],"code",{},", this plugin makes a connection at\nMAIL FROM time to the ongoing SMTP server. This can be a benefit in that\nyou get any SMTP-time filtering that the ongoing server provides, in\nparticular one important facility to some setups is recipient filtering.\nHowever be aware that other than connect and HELO-time filtering, you will\nhave as many connections to your ongoing SMTP server as you have to Haraka.",[395,396,398],"h2",{"id":397},"configuration","Configuration",[400,401,402],"ul",{},[403,404,405,406,409,410,419,421,422],"li",{},"smtp_proxy.ini",[407,408],"br",{},"Configuration is stored in this file in the following keys:",[400,411,412],{},[403,413,414,415],{},"enable_outbound=",[416,417,418],"span",{},"true",[407,420],{},"SMTP proxy outbound messages (set to false to enable Haraka's\nseparate Outbound mail routing (MX based delivery)).",[400,423,424,430,436,442,448,454,463,472,478],{},[403,425,426,427,429],{},"host=HOST",[407,428],{},"The host to connect to.",[403,431,432,433,435],{},"port=PORT",[407,434],{},"The port to connect to.",[403,437,438,439,441],{},"connect_timeout=SECONDS",[407,440],{},"The maximum amount of time to wait when creating a new connection\nto the host.  Default if unspecified is 30 seconds.",[403,443,444,445,447],{},"timeout=SECONDS",[407,446],{},"The amount of seconds to let a backend connection live idle in the\nproxy pool.  This should always be less than the global plugin timeout,\nwhich should in turn be less than the connection timeout.",[403,449,450,451,453],{},"max_connections=NUMBER",[407,452],{},"Maximum number of connections to create at any given time.",[403,455,456,457,460,462],{},"enable_tls=",[416,458,459],{},"true|yes|1",[407,461],{},"Enable TLS with the forward host (if supported). TLS uses options from\nthe tls plugin.",[403,464,465,466,469,471],{},"auth_type=",[416,467,468],{},"plain|login",[407,470],{},"Enable PLAIN or LOGIN SMTP AUTH.  This is required to enable AUTH.",[403,473,474,475,477],{},"auth_user=USERNAME",[407,476],{},"SMTP AUTH username to use.",[403,479,480,481,483],{},"auth_pass=PASSWORD",[407,482],{},"SMTP AUTH password to use.",{"title":485,"searchDepth":486,"depth":486,"links":487},"",2,[488],{"id":397,"depth":486,"text":398},"Haraka queue\u002Fsmtp_proxy plugin - Deliver mail to the proxy MTA","md",null,{},{"title":298},{"title":379,"description":489},"OaJi3nLJzFUIlYdEJ4Z_F7zQOZV6ZIjixNgj-37JN2M",[497,499],{"title":294,"path":295,"stem":296,"description":498,"children":-1},"Haraka queue\u002Fsmtp_forward plugin - Forward mail to another SMTP server",{"title":302,"path":303,"stem":304,"description":500,"children":-1},"Haraka rcpt_to.in_host_list plugin - Check if recipient is in host_list",1794456874594]