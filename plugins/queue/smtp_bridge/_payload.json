lugins\u002Ftls",{"title":210,"path":211,"stem":212},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":214,"path":215,"stem":216},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":218,"title":219,"body":220,"description":326,"extension":327,"links":328,"meta":329,"navigation":330,"path":175,"seo":331,"stem":176,"__hash__":332},"docs\u002F8.plugins\u002Fqueue\u002Fsmtp_bridge.md","queue\u002Fsmtp_bridge - Deliver mail to the local MTA",{"type":221,"value":222,"toc":323},"minimark",[223,227,234,244,249,256,259,294,305,308,319],[224,225,226],"p",{},"This plugin delivers to another SMTP server, bridging the authentication\ndetails and post data from the initial connection.",[224,228,229,230,233],{},"This plugin is meant to be used with the plugin ",[231,232,113],"code",{},".",[224,235,236,237,239,240,243],{},"It is different than ",[231,238,182],{}," or ",[231,241,242],{},"queue\u002Fsmpt_forward"," because\nit doesn't use the AUTH details from a configuration file. This plugins\nsimply post the data from the original connection to the remote SMTP server\nusing the original AUTH details.",[245,246,248],"h2",{"id":247},"configuration","Configuration",[224,250,251,252,255],{},"Configuration is stored in ",[231,253,254],{},"config\u002Fsmtp_bridge.ini"," and uses the INI\nstyle formatting.",[224,257,258],{},"The configuration of this plugin is simple:",[260,261,266],"pre",{"className":262,"code":263,"language":264,"meta":265,"style":265},"language-ini shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","host=localhost\n#port=\n#auth_type=\n#priority=10\n","ini","",[231,267,268,276,282,288],{"__ignoreMap":265},[269,270,273],"span",{"class":271,"line":272},"line",1,[269,274,275],{},"host=localhost\n",[269,277,279],{"class":271,"line":278},2,[269,280,281],{},"#port=\n",[269,283,285],{"class":271,"line":284},3,[269,286,287],{},"#auth_type=\n",[269,289,291],{"class":271,"line":290},4,[269,292,293],{},"#priority=10\n",[295,296,297],"ul",{},[298,299,300,301,304],"li",{},"host: the host where you will be authenticating and posting,\nfor example ",[231,302,303],{},"smtp.host.tld",". This is the only setting required.",[224,306,307],{},"If needed you can also set",[295,309,310,313,316],{},[298,311,312],{},"port: default to empty and Haraka will use 25.",[298,314,315],{},"auth_type: default to empty and Haraka will try to pick an appropriate method.",[298,317,318],{},"priority: default to 10.",[320,321,322],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":265,"searchDepth":278,"depth":278,"links":324},[325],{"id":247,"depth":278,"text":248},"Haraka queue\u002Fsmtp_bridge plugin 