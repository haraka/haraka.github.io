gins\u002Ftls",{"title":210,"path":211,"stem":212},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":214,"path":215,"stem":216},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":218,"title":219,"body":220,"description":584,"extension":585,"links":586,"meta":587,"navigation":588,"path":171,"seo":589,"stem":172,"__hash__":590},"docs\u002F8.plugins\u002Fqueue\u002Fquarantine.md","quarantine - Quarantine mail",{"type":221,"value":222,"toc":580},"minimark",[223,227,230,233,236,239,242,245,250,253,264,268,271,337,340,384,387,411,414,417,445,448,451,454,526,529,576],[224,225,226],"p",{},"This plugin will save a message (in message\u002Frfc822 format) to a specified\ndirectory, which will be created automatically if it does not already exist,\na dated sub-folder is also added to the end of the path specified in YYYYMMDD\nformat.",[224,228,229],{},"It is designed to be used by other plugins which request the message be\nquarantined by setting a connection or transaction note that this plugin\nchecks.",[224,231,232],{},"NOTE: this plugin simply saves a copy of the message.  It does not reject or\ndiscard the message and relies on another plugin to perform this function.",[224,234,235],{},"It uses the 'queue' hook, so that it runs after all the 'data_post' plugins\nand should be listed in 'config\u002Fplugins' to run before your queue hooks that\nperform actual deliveries.",[224,237,238],{},"To ensure that only completely written files are present in the quarantine,\nthe files are written to a temporary directory first and then hardlinked to\nthe final destination before the temporary file is deleted.",[224,240,241],{},"The temporary directory is 'quarantine_path\u002Ftmp' which defaults to:\n\u002Fvar\u002Fspool\u002Fharaka\u002Fquarantine\u002Ftmp.",[224,243,244],{},"Upon start-up, any files present in the temporary directory are deleted\nsyncronously prior to any messages being accepted.",[246,247,249],"h2",{"id":248},"configuration","Configuration",[224,251,252],{},"This plugin looks for 'quarantine.ini' in the config directory.",[254,255,256],"ul",{},[257,258,259,260,263],"li",{},"quarantine_path                   (default: \u002Fvar\u002Fspool\u002Fharaka\u002Fquarantine)",[261,262],"br",{},"The default base path to save the quarantine files to.  It will be created\nif it does not already exist.",[246,265,267],{"id":266},"usage","Usage",[224,269,270],{},"If you wish to keep a copy of the message in your plugin, simply either:",[272,273,278],"pre",{"className":274,"code":275,"language":276,"meta":277,"style":277},"language-javascript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","connection.notes.quarantine = [ 1 | true | 'sub\u002Fdirectory\u002Fpath' ];\n","javascript","",[279,280,281],"code",{"__ignoreMap":277},[282,283,286,290,294,297,299,302,305,308,312,315,319,321,324,328,331,334],"span",{"class":284,"line":285},"line",1,[282,287,289],{"class":288},"sTEyZ","connection",[282,291,293],{"class":292},"sMK4o",".",[282,295,296],{"class":288},"notes",[282,298,293],{"class":292},[282,300,301],{"class":288},"quarantine ",[282,303,304],{"class":292},"=",[282,306,307],{"class":288}," [ ",[282,309,311],{"class":310},"sbssI","1",[282,313,314],{"class":292}," |",[282,316,318],{"class":317},"sfNiH"," true",[282,320,314],{"class":292},[282,322,323],{"class":292}," '",[282,325,327],{"class":326},"sfazB","sub\u002Fdirectory\u002Fpath",[282,329,330],{"class":292},"'",[282,332,333],{"class":288}," ]",[282,335,336],{"class":292},";\n",[224,338,339],{},"or",[272,341,343],{"className":274,"code":342,"language":276,"meta":277,"style":277},"connection.transaction.notes.quarantine = [ 1 | true | 'sub\u002Fdirectory\u002Fpath' ];\n",[279,344,345],{"__ignoreMap":277},[282,346,347,349,351,354,356,358,360,362,364,366,368,370,372,374,376,378,380,382],{"class":284,"line":285},[282,348,289],{"class":288},[282,350,293],{"class":292},[282,352,353],{"class":288},"transaction",[282,355,293],{"class":292},[282,357,296],{"class":288},[282,359,293],{"class":292},[282,361,301],{"class":288},[282,363,304],{"class":292},[282,365,307],{"class":288},[282,367,311],{"class":310},[282,369,314],{"class":292},[282,371,318],{"class":317},[282,373,314],{"class":292},[282,375,323],{"class":292},[282,377,327],{"class":326},[282,379,330],{"class":292},[282,381,333],{"class":288},[282,383,336],{"class":292},[224,385,386],{},"e.g.",[272,388,390],{"className":274,"code":389,"language":276,"meta":277,"style":277},"connection.notes.quarantine = 1;\n",[279,391,392],{"__ignoreMap":277},[282,393,394,396,398,400,402,404,406,409],{"class":284,"line":285},[282,395,289],{"class":288},[282,397,293],{"class":292},[282,399,296],{"class":288},[282,401,293],{"class":292},[282,403,301],{"class":288},[282,405,304],{"class":292},[282,407,408],{"class":310}," 1",[282,410,336],{"class":292},[224,412,413],{},"would save the message to '\u002Fvar\u002Fspool\u002Fquarantine\u002Fharaka\u002FYYYYMMDD\u002FUUID' where\nYYYMMDD and UUID are expanded to current date and transaction UUID.",[224,415,416],{},"and",[272,418,420],{"className":274,"code":419,"language":276,"meta":277,"style":277},"connection.notes.quarantine = 'corpus';\n",[279,421,422],{"__ignoreMap":277},[282,423,424,426,428,430,432,434,436,438,441,443],{"class":284,"line":285},[282,425,289],{"class":288},[282,427,293],{"class":292},[282,429,296],{"class":288},[282,431,293],{"class":292},[282,433,301],{"class":288},[282,435,304],{"class":292},[282,437,323],{"class":292},[282,439,440],{"class":326},"corpus",[282,442,330],{"class":292},[282,444,336],{"class":292},[224,446,447],{},"would save the message to '\u002Fvar\u002Fspool\u002Fquarantine\u002Fharaka\u002Fcorpus\u002FYYYYMMDD\u002FUUID'.",[224,449,450],{},"Note: you can specify 'corpus\u002Ffoo' or 'corpus\u002Ffoo\u002Fbar' and the directories will\nbe automatically created.  Do not add any leading or trailing slashes.",[224,452,453],{},"By default - after the message is quarantined, the plugin will tell Haraka to\ncontinue to the next plugin.  You can specify a different action like DENY or\nOK and supply an optional message using the following notes:",[272,455,457],{"className":274,"code":456,"language":276,"meta":277,"style":277},"connection.notes.quarantine_action = [ OK, 'Message quarantined' ];\nconnection.transaction.notes.quarantine_action = [ DENY, 'Message rejected' ];\n",[279,458,459,491],{"__ignoreMap":277},[282,460,461,463,465,467,469,472,474,477,480,482,485,487,489],{"class":284,"line":285},[282,462,289],{"class":288},[282,464,293],{"class":292},[282,466,296],{"class":288},[282,468,293],{"class":292},[282,470,471],{"class":288},"quarantine_action ",[282,473,304],{"class":292},[282,475,476],{"class":288}," [ OK",[282,478,479],{"class":292},",",[282,481,323],{"class":292},[282,483,484],{"class":326},"Message quarantined",[282,486,330],{"class":292},[282,488,333],{"class":288},[282,490,336],{"class":292},[282,492,494,496,498,500,502,504,506,508,510,513,515,517,520,522,524],{"class":284,"line":493},2,[282,495,289],{"class":288},[282,497,293],{"class":292},[282,499,353],{"class":288},[282,501,293],{"class":292},[282,503,296],{"class":288},[282,505,293],{"class":292},[282,507,471],{"class":288},[282,509,304],{"class":292},[282,511,512],{"class":288}," [ DENY",[282,514,479],{"class":292},[282,516,323],{"class":292},[282,518,519],{"class":326},"Message rejected",[282,521,330],{"class":292},[282,523,333],{"class":288},[282,525,336],{"class":292},[224,527,528],{},"If you don't want to supply a specific message back to the client you can\nalso just specify a return code:",[272,530,532],{"className":274,"code":531,"language":276,"meta":277,"style":277},"connection.notes.quarantine_action = OK;\nconnection.transaction.notes.quarantine_action = DENY;\n",[279,533,534,553],{"__ignoreMap":277},[282,535,536,538,540,542,544,546,548,551],{"class":284,"line":285},[282,537,289],{"class":288},[282,539,293],{"class":292},[282,541,296],{"class":2