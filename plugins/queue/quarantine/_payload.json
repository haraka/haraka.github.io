og","\u002Fplugins\u002Fsyslog","8.plugins\u002Fsyslog",{"title":354,"path":355,"stem":356},"tarpit","\u002Fplugins\u002Ftarpit","8.plugins\u002Ftarpit",{"title":358,"path":359,"stem":360},"tls","\u002Fplugins\u002Ftls","8.plugins\u002Ftls",{"title":362,"path":363,"stem":364},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":366,"path":367,"stem":368},"uribl","\u002Fplugins\u002Furibl","8.plugins\u002Furibl",{"title":370,"path":371,"stem":372},"watch","\u002Fplugins\u002Fwatch","8.plugins\u002Fwatch",{"title":374,"path":375,"stem":376},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":378,"title":379,"body":380,"description":744,"extension":745,"links":746,"meta":747,"navigation":748,"path":279,"seo":749,"stem":280,"__hash__":750},"docs\u002F8.plugins\u002Fqueue\u002Fquarantine.md","quarantine - Quarantine mail",{"type":381,"value":382,"toc":740},"minimark",[383,387,390,393,396,399,402,405,410,413,424,428,431,497,500,544,547,571,574,577,605,608,611,614,686,689,736],[384,385,386],"p",{},"This plugin will save a message (in message\u002Frfc822 format) to a specified\ndirectory, which will be created automatically if it does not already exist,\na dated sub-folder is also added to the end of the path specified in YYYYMMDD\nformat.",[384,388,389],{},"It is designed to be used by other plugins which request the message be\nquarantined by setting a connection or transaction note that this plugin\nchecks.",[384,391,392],{},"NOTE: this plugin simply saves a copy of the message.  It does not reject or\ndiscard the message and relies on another plugin to perform this function.",[384,394,395],{},"It uses the 'queue' hook, so that it runs after all the 'data_post' plugins\nand should be listed in 'config\u002Fplugins' to run before your queue hooks that\nperform actual deliveries.",[384,397,398],{},"To ensure that only completely written files are present in the quarantine,\nthe files are written to a temporary directory first and then hardlinked to\nthe final destination before the temporary file is deleted.",[384,400,401],{},"The temporary directory is 'quarantine_path\u002Ftmp' which defaults to:\n\u002Fvar\u002Fspool\u002Fharaka\u002Fquarantine\u002Ftmp.",[384,403,404],{},"Upon start-up, any files present in the temporary directory are deleted\nsyncronously prior to any messages being accepted.",[406,407,409],"h2",{"id":408},"configuration","Configuration",[384,411,412],{},"This plugin looks for 'quarantine.ini' in the config directory.",[414,415,416],"ul",{},[417,418,419,420,423],"li",{},"quarantine_path                   (default: \u002Fvar\u002Fspool\u002Fharaka\u002Fquarantine)",[421,422],"br",{},"The default base path to save the quarantine files to.  It will be created\nif it does not already exist.",[406,425,427],{"id":426},"usage","Usage",[384,429,430],{},"If you wish to keep a copy of the message in your plugin, simply either:",[432,433,438],"pre",{"className":434,"code":435,"language":436,"meta":437,"style":437},"language-javascript shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","connection.notes.quarantine = [ 1 | true | 'sub\u002Fdirectory\u002Fpath' ];\n","javascript","",[439,440,441],"code",{"__ignoreMap":437},[442,443,446,450,454,457,459,462,465,468,472,475,479,481,484,488,491,494],"span",{"class":444,"line":445},"line",1,[442,447,449],{"class":448},"sTEyZ","connection",[442,451,453],{"class":452},"sMK4o",".",[442,455,456],{"class":448},"notes",[442,458,453],{"class":452},[442,460,461],{"class":448},"quarantine ",[442,463,464],{"class":452},"=",[442,466,467],{"class":448}," [ ",[442,469,471],{"class":470},"sbssI","1",[442,473,474],{"class":452}," |",[442,476,478],{"class":477},"sfNiH"," true",[442,480,474],{"class":452},[442,482,483],{"class":452}," '",[442,485,487],{"class":486},"sfazB","sub\u002Fdirectory\u002Fpath",[442,489,490],{"class":452},"'",[442,492,493],{"class":448}," ]",[442,495,496],{"class":452},";\n",[384,498,499],{},"or",[432,501,503],{"className":434,"code":502,"language":436,"meta":437,"style":437},"connection.transaction.notes.quarantine = [ 1 | true | 'sub\u002Fdirectory\u002Fpath' ];\n",[439,504,505],{"__ignoreMap":437},[442,506,507,509,511,514,516,518,520,522,524,526,528,530,532,534,536,538,540,542],{"class":444,"line":445},[442,508,449],{"class":448},[442,510,453],{"class":452},[442,512,513],{"class":448},"transaction",[442,515,453],{"class":452},[442,517,456],{"class":448},[442,519,453],{"class":452},[442,521,461],{"class":448},[442,523,464],{"class":452},[442,525,467],{"class":448},[442,527,471],{"class":470},[442,529,474],{"class":452},[442,531,478],{"class":477},[442,533,474],{"class":452},[442,535,483],{"class":452},[442,537,487],{"class":486},[442,539,490],{"class":452},[442,541,493],{"class":448},[442,543,496],{"class":452},[384,545,546],{},"e.g.",[432,548,550],{"className":434,"code":549,"language":436,"meta":437,"style":437},"connection.notes.quarantine = 1;\n",[439,551,552],{"__ignoreMap":437},[442,553,554,556,558,560,562,564,566,569],{"class":444,"line":445},[442,555,449],{"class":448},[442,557,453],{"class":452},[442,559,456],{"class":448},[442,561,453],{"class":452},[442,563,461],{"class":448},[442,565,464],{"class":452},[442,567,568],{"class":470}," 1",[442,570,496],{"class":452},[384,572,573],{},"would save the message to '\u002Fvar\u002Fspool\u002Fquarantine\u002Fharaka\u002FYYYYMMDD\u002FUUID' where\nYYYMMDD and UUID are expanded to current date and transaction UUID.",[384,575,576],{},"and",[432,578,580],{"className":434,"code":579,"language":436,"meta":437,"style":437},"connection.notes.quarantine = 'corpus';\n",[439,581,582],{"__ignoreMap":437},[442,583,584,586,588,590,592,594,596,598,601,603],{"class":444,"line":445},[442,585,449],{"class":448},[442,587,453],{"class":452},[442,589,456],{"class":448},[442,591,453],{"class":452},[442,593,461],{"class":448},[442,595,464],{"class":452},[442,597,483],{"class":452},[442,599,600],{"class":486},"corpus",[442,602,490],{"class":452},[442,604,496],{"class":452},[384,606,607],{},"would save the message to '\u002Fvar\u002Fspool\u002Fquarantine\u002Fharaka\u002Fcorpus\u002FYYYYMMDD\u002FUUID'.",[384,609,610],{},"Note: you can specify 'corpus\u002Ffoo' or 'corpus\u002Ffoo\u002Fbar' and the directories will\nbe automatically created.  Do not add any leading or trailing slashes.",[384,612,613],{},"By default - after the message is quarantined, the plugin will tell Haraka to\ncontinue to the next plugin.  You can specify a different action like DENY or\nOK and supply an optional message using the following notes:",[432,615,617],{"className":434,"code":616,"language":436,"meta":437,"style":437},"connection.notes.quarantine_action = [ OK, 'Message quarantined' ];\nconnection.transaction.notes.quarantine_action = [ DENY, 'Message rejected' ];\n",[439,618,619,651],{"__ignoreMap":437},[442,620,621,623,625,627,629,632,634,637,640,642,645,647,649],{"class":444,"line":445},[442,622,449],{"class":448},[442,624,453],{"class":452},[442,626,456],{"class":448},[442,628,453],{"class":452},[442,630,631],{"class":448},"quarantine_action ",[442,633,464],{"class":452},[442,635,636],{"class":448}," [ OK",[442,638,639],{"class":452},",",[442,641,483],{"class":452},[442,643,644],{"class":486},"Message quarantined",[442,646,490],{"class":452},[442,648,493],{"class":448},[442,650,496],{"class":452},[442,652,654,656,658,660,662,664,666,668,670,673,675,677,680,682,684],{"class":444,"line":653},2,[442,655,449],{"class":448},[442,657,453],{"class":452},[442,659,513],{"class":448},[442,661,453],{"class":452},[442,663,456],{"class":448},[442,665,453],{"class":452},[442,667,631],{"class":448},[442,669,464],{"class":452},[442,671,672],{"class":448}," [ DENY",[442,674,639],{"class":452},[442,676,483],{"class":452},[442,678,679],{"class":486},"Message rejected",[442,681,490],{"class":452},[442,683,493],{"class":448},[442,685,496],{"class":452},[384,687,688],{},"If you don't want to supply a specific message back to the client you can\nalso just specify a return code:",[432,690,692],{"className":434,"code":691,"language":436,"meta":437,"style":437},"connection.notes.quarantine_action = OK;\nconnection.transaction.notes.quarantine_action = DENY;\n",[439,693,694,713],{"__ignoreMap":437},[442,695,696,698,700,702,704,706,708,711],{"class":444,"line":445},[442,697,449],{"class":448},[442,699,453],{"class":452},[442,701,456],{"class":448},[442,703,453],{"class":452},[442,705,631],{"class":448},[442,707,464],{"class":452},[442,709,710],{"class":448}," OK",[442,712,496],{"class":452},[442,714,715,717,719,721,723,725,727,729,731,734],{"class":444,"line":653},[442,716,449],{"class":448},[442,718,453],{"class":452},[442,720,513],{"class":448},[442,722,453],{"class":452},[442,724,456],{"class":448},[442,726,453],{"class":452},[442,728,631],{"class":448},[442,730,464],{"class":452},[442,732,733],{"class":448}," DENY",[442,735,496],{"class":452},[737,738,739],"style",{},"html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sfNiH, html code.shiki .sfNiH{--shiki-light:#FF5370;--shiki-default:#FF9CAC;--shiki-dark:#FF9CAC}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .defa