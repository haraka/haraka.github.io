51,"stem":352},"syslog","\u002Fplugins\u002Fsyslog","8.plugins\u002Fsyslog",{"title":354,"path":355,"stem":356},"tarpit","\u002Fplugins\u002Ftarpit","8.plugins\u002Ftarpit",{"title":358,"path":359,"stem":360},"tls","\u002Fplugins\u002Ftls","8.plugins\u002Ftls",{"title":362,"path":363,"stem":364},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":366,"path":367,"stem":368},"uribl","\u002Fplugins\u002Furibl","8.plugins\u002Furibl",{"title":370,"path":371,"stem":372},"watch","\u002Fplugins\u002Fwatch","8.plugins\u002Fwatch",{"title":374,"path":375,"stem":376},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":378,"title":379,"body":380,"description":386,"extension":1277,"links":1278,"meta":1279,"navigation":1280,"path":93,"seo":1281,"stem":94,"__hash__":1282},"docs\u002F7.tutorials\u002Fmigrating_from_v1_to_v2.md","Migrating from Haraka v1.x to v2.x",{"type":381,"value":382,"toc":1272},"minimark",[383,387,390,399,415,420,427,433,437,444,447,462,966,969,1014,1021,1028,1032,1039,1118,1121,1169,1175,1178,1265,1268],[384,385,386],"p",{},"Haraka v2.x contains two significant changes to the v1.x API related to\nstreams.",[384,388,389],{},"Streams are an abstraction over a data flow that is provided by Node core\nand is used throughout node to \"pipe\" data between two places or more. This\nmakes programming very easy, and is hence why we started using them in Haraka\nstarting with version 2.0.0.",[384,391,392,393],{},"For more information about the Stream API, see\n",[394,395,396],"a",{"href":396,"rel":397},"http:\u002F\u002Fnodejs.org\u002Fapi\u002Fstream.html",[398],"nofollow",[384,400,401,402,406,407,410,411,414],{},"It's important to note that if you are using standard Haraka plugins then\nit's very unlikely you will need to change anything. Though you may want\nto configure ",[403,404,405],"code",{},"spool_dir"," and ",[403,408,409],{},"spool_after"," in ",[403,412,413],{},"config\u002Fsmtp.ini",". However if\nyou have written custom plugins, continue reading.",[416,417,419],"h2",{"id":418},"changes-to-look-for","Changes To Look For",[384,421,422,423,426],{},"Firstly, the incoming data in an email (the email body) is now stored in an\nobject which you can treat as a ReadableStream. To find if this is relevant\nfor you, look for instances of ",[403,424,425],{},"data_lines"," in your plugins.",[384,428,429,430,426],{},"Secondly, if you parse the mail body, attachments are now provided as a\nstream, rather than custom start\u002Fdata\u002Fend events. To find if this is relevant\nfor you, look for instances of ",[403,431,432],{},"attachment_hooks",[416,434,436],{"id":435},"fixing-data_lines-plugins","Fixing data_lines plugins",[384,438,439,440,443],{},"Any plugins now working on each line of data will need to change to using a\nstream. The stream is called ",[403,441,442],{},"transaction.message_stream",".",[384,445,446],{},"These changes may be complicated if you are iterating over each line and\ndoing something with the strings therein. However if you are piping the data\nto an application or over a network, your code will become significantly\nsimpler (and a lot faster).",[384,448,449,450,453,454,457,458,461],{},"In v1.x Haraka populated the ",[403,451,452],{},"transaction.data_lines"," array for each line of\ndata received.  If you were writing the data to a socket then you had to handle backpressure manually by checking the return of ",[403,455,456],{},"write()"," and adding\n",[403,459,460],{},"on('drain')"," handlers like so:",[463,464,469],"pre",{"className":465,"code":466,"language":467,"meta":468,"style":468},"language-js shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","let data_marker = 0;\nlet in_data = false;\nlet end_pending = true;\nconst send_data = function () {\n    in_data = true;\n    let wrote_all = true;\n    while (wrote_all && (data_marker \u003C connection.transaction.data_lines.length)) {\n        var line = connection.transaction.data_lines[data_marker];\n        data_marker++;\n        wrote_all = socket.write(Buffer.from(line.replace(\u002F^\\.\u002F, '..').replace(\u002F\\r?\\n\u002Fg, '\\r\\n')), 'binary');\n        if (!wrote_all) return;\n    }\n    \u002F\u002F we get here if wrote_all still true, and we got to end of data_lines\n    if (end_pending) {\n        end_pending = false;\n        \u002F\u002F Finished...\n        socket.send_command('dot');\n    }\n};\nsocket.on('drain', function () {\n    if (end_pending && in_data) {\n        setImmediate(function () { send_data() });\n    }\n});\n","js","",[403,470,471,495,511,526,546,559,574,622,653,662,775,796,802,809,824,836,842,866,871,877,905,923,952,957],{"__ignoreMap":468},[472,473,476,480,484,488,492],"span",{"class":474,"line":475},"line",1,[472,477,479],{"class":478},"spNyl","let",[472,481,483],{"class":482},"sTEyZ"," data_marker ",[472,485,487],{"class":486},"sMK4o","=",[472,489,491],{"class":490},"sbssI"," 0",[472,493,494],{"class":486},";\n",[472,496,498,500,503,505,509],{"class":474,"line":497},2,[472,499,479],{"class":478},[472,501,502],{"class":482}," in_data ",[472,504,487],{"class":486},[472,506,508],{"class":507},"sfNiH"," false",[472,510,494],{"class":486},[472,512,514,516,519,521,524],{"class":474,"line":513},3,[472,515,479],{"class":478},[472,517,518],{"class":482}," end_pending ",[472,520,487],{"class":486},[472,522,523],{"class":507}," true",[472,525,494],{"class":486},[472,527,529,532,535,537,540,543],{"class":474,"line":528},4,[472,530,531],{"class":478},"const",[472,533,534],{"class":482}," send_data ",[472,536,487],{"class":486},[472,538,539],{"class":478}," function",[472,541,542],{"class":486}," ()",[472,544,545],{"class":486}," {\n",[472,547,549,552,555,557],{"class":474,"line":548},5,[472,550,551],{"class":482},"    in_data",[472,553,554],{"class":486}," =",[472,556,523],{"class":507},[472,558,494],{"class":486},[472,560,562,565,568,570,572],{"class":474,"line":561},6,[472,563,564],{"class":478},"    let",[47