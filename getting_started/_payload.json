3},"currency_code","CAD",[408,425],{"type":426,"src":427,"border":428,"name":429,"title":430,"alt":431},"image","https:\u002F\u002Fwww.paypalobjects.com\u002Fen_US\u002Fi\u002Fbtn\u002Fbtn_donate_LG.gif",0,"submit","PayPal - The safer, easier way to pay online!","Donate with PayPal button",[433,434],"img",{"alt":435,"border":428,"src":436,"width":437,"height":437},"","https:\u002F\u002Fwww.paypal.com\u002Fen_US\u002Fi\u002Fscr\u002Fpixel.gif",1,[439,440,406,444,406,451,406,457],"div",{"className":441},[442,443],"flex","space-x-4",[395,445,447],{"href":446},"#",[433,448],{"alt":449,"src":450},"Tests","https:\u002F\u002Fgithub.com\u002Fharaka\u002FHaraka\u002Fworkflows\u002FHaraka%20Tests\u002Fbadge.svg",[395,452,453],{"href":446},[433,454],{"alt":455,"src":456},"Tests - Windows","https:\u002F\u002Fgithub.com\u002Fharaka\u002FHaraka\u002Fworkflows\u002FHaraka%20Tests%20-%20Windows\u002Fbadge.svg",[395,458,465],{"href":459,"rel":460,"target":464},"https:\u002F\u002Fcodecov.io\u002Fgithub\u002Fharaka\u002FHaraka?branch=master",[461,462,463],"nofollow","noopener","noreferrer","_blank",[433,466],{"dataVF58a9f50":435,"alt":467,"src":468},"Coverage Status","https:\u002F\u002Fcodecov.io\u002Fgithub\u002Fharaka\u002FHaraka\u002Fcoverage.svg",[388,470,471,472,477],{},"Haraka is a highly scalable ",[395,473,476],{"href":474,"rel":475},"http:\u002F\u002Fnodejs.org",[461],"node.js"," email server with a modular\nplugin architecture. Haraka can serve thousands of concurrent connections\nand deliver thousands of messages per second. Haraka and plugins are written\nin asynchronous JS and are very fast.",[388,479,480,481,486,487,492,493,498,499,503],{},"Haraka has very good spam protection (see ",[395,482,485],{"href":483,"rel":484},"https:\u002F\u002Fgithub.com\u002Fharaka\u002FHaraka\u002Fblob\u002Fmaster\u002FPlugins.md",[461],"plugins",") and works\nwell as a filtering ",[395,488,491],{"href":489,"rel":490},"http:\u002F\u002Fen.wikipedia.org\u002Fwiki\u002FMessage_transfer_agent",[461],"MTA",". It also works well as a ",[395,494,497],{"href":495,"rel":496},"http:\u002F\u002Fen.wikipedia.org\u002Fwiki\u002FMail_submission_agent",[461],"MSA"," running on\nport 587 with auth and ",[395,500,185],{"href":501,"rel":502},"https:\u002F\u002Fharaka.github.io\u002Fplugins\u002Fdkim\u002F",[461]," plugins enabled.",[388,505,506,507,512,513,517],{},"Haraka makes no attempt to be a mail store (like Exchange or Postfix\u002FExim\u002FQmail),\na ",[395,508,511],{"href":509,"rel":510},"https:\u002F\u002Fen.wikipedia.org\u002Fwiki\u002FMail_delivery_agent",[461],"LDA",", nor an IMAP server (like Dovecot or Courier). Haraka is\ntypically used ",[514,515,516],"strong",{},"with"," such systems.",[388,519,520,521,525,526,529],{},"Haraka has a scalable outbound mail delivery engine built in. Mail\nmarked as ",[522,523,524],"code",{},"relaying"," (such as via an ",[522,527,528],{},"auth"," plugin) is automatically\nqueued for outbound delivery.",[531,532,534],"h3",{"id":533},"getting-help","Getting Help",[536,537,538,546],"ul",{},[539,540,541,545],"li",{},[395,542,544],{"href":543},"mailto:haraka-sub@harakamail.com","Join the mailing list"," (implemented as a Haraka plugin)",[539,547,548],{},[395,549,552],{"href":550,"rel":551},"https:\u002F\u002Fgithub.com\u002Fharaka\u002FHaraka\u002Fissues",[461],"GitHub Issues",[531,554,556],{"id":555},"screencast","Screencast",[558,559],"iframe",{"className":560,"src":564,"title":565,"allowFullScreen":566},[561,562,563],"w-full","aspect-video","rounded-md","https:\u002F\u002Fwww.youtube-nocookie.com\u002Fembed\u002F6twKXMAsPsw","Haraka screencast",true,[531,568,570],{"id":569},"why-use-haraka","Why Use Haraka?",[388,572,573],{},"Haraka's plugin architecture provides an easily extensible MTA that\ncomplements traditional MTAs that excel at managing mail stores but do\nnot have sufficient filtering.",[388,575,576,577,580,581,584],{},"The plugin system makes it easy to code new features. A typical example\nis providing qmail-like extended addresses to an Exchange system,\nwhereby you could receive mail as ",[522,578,579],{},"user-anyword@domain.com",", and yet\nstill have it correctly routed to ",[522,582,583],{},"user@domain.com",". This is a few lines of\ncode in Haraka.",[388,586,587,588,593,594,599,600,605,606,611],{},"Plugins are provided for running mail through ",[395,589,592],{"href":590,"rel":591},"https:\u002F\u002Fharaka.github.io\u002Fplugins\u002Fspamassassin\u002F",[461],"SpamAssassin",", validating\n",[395,595,598],{"href":596,"rel":597},"https:\u002F\u002Fharaka.github.io\u002Fplugins\u002Fhelo.checks\u002F",[461],"HELO"," names, checking ",[395,601,604],{"href":602,"rel":603},"https:\u002F\u002Fharaka.github.io\u002Fplugins\u002Fdnsbl\u002F",[461],"DNS Blocklists",", and ",[395,607,610],{"href":608,"rel":609},"https:\u002F\u002Fgithub.com\u002Fharaka\u002FHaraka\u002Ftree\u002Fmaster\u002Fplugins",[461],"many others",".",[531,613,615],{"id":614},"installing-haraka","Installing Haraka",[388,617,618,619,622,623,627],{},"Haraka requires ",[395,620,476],{"href":474,"rel":621},[461]," to run. Install Haraka with [npm]",[624,625,626],"span",{},"2",":",[629,630,631,656,674],"code-group",{},[632,633,638],"pre",{"className":634,"code":635,"filename":636,"language":637,"meta":435,"style":435},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","npm install -g Haraka\n","npm","bash",[522,639,640],{"__ignoreMap":435},[624,641,643,646,650,653],{"class":642,"line":437},"line",[624,644,636],{"class":645},"sBMFI",[624,647,649],{"class":648},"sfazB"," install",[624,651,652],{"class":648}," -g",[624,654,655],{"class":648}," Haraka\n",[632,657,660],{"className":634,"code":658,"filename":659,"language":637,"meta":435,"style":435},"yarn add global Haraka\n","yarn",[522,661,662],{"__ignoreMap":435},[624,663,664,666,669,672],{"class":642,"line":437},[624,665,659],{"class":645},[624,667,668],{"class":648}," add",[624,670,671],{"class":648}," global",[624,673,655],{"class":648},[632,675,678],{"className":634,"code":676,"filename":677,"language":637,"meta":435,"style":435},"pnpm add -g Haraka\n","pnpm",[522,679,680],{"__ignoreMap":435},[624,681,682,684,686,688],{"class":642,"line":437},[624,683,677],{"class":645},[624,685,668],{"class":648},[624,687,652],{"class":648},[624,689,655],{"class":648},[691,692,693],"note",{},"If the command gives \"nobody\" errors run the next command",[629,695,696],{},[632,697,699],{"className":634,"code":698,"filename":636,"language":637,"meta":435,"style":435},"npm -g config set user root\nnpm install -g Haraka\n",[522,700,701,719],{"__ignoreMap":435},[624,702,703,705,707,710,713,716],{"class":642,"line":437},[624,704,636],{"class":645},[624,706,652],{"class":648},[624,708,709],{"class":648}," config",[624,711,712],{"class":648}," set",[624,714,715],{"class":648}," user",[624,717,718],{"class":648}," root\n",[624,720,722,724,726,728],{"class":642,"line":721},2,[624,723,636],{"class":645},[624,725,649],{"class":648},[624,727,652],{"class":648},[624,729,655],{"class":648},[388,731,732,733,735],{},"After installation, use the ",[522,734,385],{}," binary to set up the service.",[531,737,739],{"id":738},"running-haraka","Running Haraka",[388,741,742],{},"First, create the service:",[632,744,748],{"className":745,"code":746,"language":747,"meta":435,"style":435},"language-sh shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","haraka -i \u002Fpath\u002Fto\u002Fharaka_test\n","sh",[522,749,750],{"__ignoreMap":435},[624,751,752],{"class":642,"line":437},[624,753,746],{},[388,755,756,757,760,761,764,765,768,769,611],{},"That creates the directory ",[522,758,759],{},"haraka_test"," with ",[522,762,763],{},"config"," and ",[522,766,767],{},"plugin","\ndirectories within. It also sets the host name used by Haraka\nto the output of ",[522,770,771],{},"hostname",[388,773,774,775,777,778,781,782,784,785,788,789,791],{},"If ",[522,776,771],{}," is not correct, edit ",[522,779,780],{},"config\u002Fhost_list",". For example,\nto receive mail addressed to ",[522,783,583],{},", add ",[522,786,787],{},"domain.com"," to the\n",[522,790,780],{}," file.",[388,793,794],{},"Finally, start Haraka using root permissions:",[632,796,798],{"className":745,"code":797,"language":747,"meta":435,"style":435},"haraka -c \u002Fpath\u002Fto\u002Fharaka_test\n",[522,799,800],{"__ignoreMap":435},[624,801,802],{"class":642,"line":437},[624,803,797],{},[388,805,806],{},"And it will run.",[531,808,810],{"id":809},"configure-haraka","Configure Haraka",[388,812,813,814,817,818,820,821,824,825,611],{},"To choose which plugins run, edit ",[522,815,816],{},"config\u002Fplugins",". Plugins control the\noverall behaviour of Haraka. By default, only messages to domains listed\nin ",[522,819,780],{}," will be accepted and then delivered via the\n",[522,822,823],{},"smtp-forward"," plugin. Configure the destination in ",[522,826,827],{},"config\u002Fsmtp_forward.ini",[531,829,831],{"id":830},"read-the-fine-manual","Read the Fine Manual",[632,833,835],{"className":745,"code":834,"language":747,"meta":435,"style":435},"haraka -h plugins\u002F$name\n",[522,836,837],{"__ignoreMap":435},[624,838,839],{"class":642,"line":437},[624,840,834],{},[388,842,843,844,846],{},"The docs detail how each plugin is configured. After editing\n",[522,845,816],{},", restart Haraka and enjoy!",[531,848,850],{"id":849},"running-from-git","Running from git",[388,852,853],{},"If you are unable to use npm to install Haraka, you can run from git by\nfollowing these steps:",[388,855,856],{},"First clone the repository:",[632,858,860],{"className":745,"code":859,"language":747,"meta":435,"style":435},"git clone https:\u002F\u002Fgithub.com\u002Fharaka\u002FHaraka.git\ncd Haraka\n",[522,861,862,867],{"__ignoreMap":435},[624,863,864],{"class":642,"line":437},[624,865,866],{},"git clone https:\u002F\u002Fgithub.com\u002Fharaka\u002FHaraka.git\n",[624,868,869],{"class":642,"line":721},[624,870,871],{},"cd Haraka\n",[388,873,874],{},"Install Haraka's node.js dependencies locally:",[632,876,878],{"className":745,"code":877,"language":747,"meta":435,"style":435},"npm install\n",[522,879,880],{"__ignoreMap":435},[624,881,882],{"class":642,"line":437},[624,883,877],{},[388,885,886,887,764,889,892],{},"Edit ",[522,888,816],{},[522,890,891],{},"config\u002Fsmtp.ini"," to specify the plugins and\nconfig you want.",[388,894,895],{},"Finally run Haraka:",[632,897,899],{"className":745,"code":898,"language":747,"meta":435,"style":435},"node haraka.js\n",[522,900,901],{"__ignoreMap":435},[624,902,903],{"class":642,"line":437},[624,904,898],{},[531,906,908],{"id":907},"license-and-author","License and Author",[388,910,911,912,917],{},"Haraka is MIT licensed - see the ",[395,913,916],{"href":914,"rel":915},"https:\u002F\u002Fgithub.com\u002Fharaka\u002FHaraka\u002Fblob\u002Fmaster\u002FLICENSE",[461],"LICENSE"," file for details.",[388,919,920,921,926,927,611],{},"Haraka is a project started by ",[395,922,925],{"href":923,"rel":924},"https:\u002F\u002Fgithub.com\u002Fbaudehlo",[461],"Matt Sergeant",", a 10 year veteran of the email\nand anti-spam world. Previous projects have been the project leader for\nSpamAssassin and a hacker on ",[395,928,931],{"href":929,"rel":930},"https:\u002F\u002Fgithub.com\u002Fsmtpd\u002Fqpsmtpd\u002F",[461],"Qpsmtpd",[933,934,935],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-defau