itle":210,"path":211,"stem":212},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":214,"path":215,"stem":216},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":218,"title":5,"body":219,"description":786,"extension":787,"links":788,"meta":789,"navigation":401,"path":6,"seo":790,"stem":7,"__hash__":791},"docs\u002F1.getting_started.md",{"type":220,"value":221,"toc":772},"minimark",[222,227,231,238,278,303,312,339,353,365,370,388,392,402,406,409,420,447,451,464,526,530,566,572,576,579,590,608,628,631,640,643,647,664,668,677,683,687,690,693,708,711,720,729,732,741,745,754,768],[223,224,226],"h2",{"id":225},"haraka","Haraka",[228,229,230],"p",{},"A modern, high performance, flexible SMTP server.",[228,232,233,234,237],{},"Haraka is an open source SMTP server written in Node.js which provides extremely high performance coupled with a flexible plugin system allowing Javascript programmers full access to change the behaviour of the server. It is used heavily in some high traffic sites - see the ",[235,236,17],"a",{"href":18}," page for testimonials.",[239,240,246,247,246,253,246,257,246,260,246,264,246,272],"form",{"action":241,"method":242,"target":243,"className":244},"https:\u002F\u002Fwww.paypal.com\u002Fcgi-bin\u002Fwebscr","post","_top",[245],"h-10","\n    ",[248,249],"input",{"type":250,"name":251,"value":252},"hidden","cmd","_donations",[248,254],{"type":250,"name":255,"value":256},"business","helpme+paypal@gmail.com",[248,258],{"type":250,"name":259,"value":226},"item_name",[248,261],{"type":250,"name":262,"value":263},"currency_code","CAD",[248,265],{"type":266,"src":267,"border":268,"name":269,"title":270,"alt":271},"image","https:\u002F\u002Fwww.paypalobjects.com\u002Fen_US\u002Fi\u002Fbtn\u002Fbtn_donate_LG.gif",0,"submit","PayPal - The safer, easier way to pay online!","Donate with PayPal button",[273,274],"img",{"alt":275,"border":268,"src":276,"width":277,"height":277},"","https:\u002F\u002Fwww.paypal.com\u002Fen_US\u002Fi\u002Fscr\u002Fpixel.gif",1,[279,280,246,284,246,291],"div",{"className":281},[282,283],"flex","space-x-4",[235,285,287],{"href":286},"https:\u002F\u002Fgithub.com\u002Fharaka\u002FHaraka\u002Factions\u002Fworkflows\u002Fci.yml",[273,288],{"alt":289,"src":290},"Tests","https:\u002F\u002Fgithub.com\u002Fharaka\u002FHaraka\u002Factions\u002Fworkflows\u002Fci.yml\u002Fbadge.svg",[235,292,299],{"href":293,"rel":294,"target":298},"https:\u002F\u002Fcodecov.io\u002Fgithub\u002Fharaka\u002FHaraka?branch=master",[295,296,297],"nofollow","noopener","noreferrer","_blank",[273,300],{"dataVF58a9f50":275,"alt":301,"src":302},"Coverage Status","https:\u002F\u002Fcodecov.io\u002Fgithub\u002Fharaka\u002FHaraka\u002Fcoverage.svg",[228,304,305,306,311],{},"Haraka is a highly scalable ",[235,307,310],{"href":308,"rel":309},"http:\u002F\u002Fnodejs.org",[295],"node.js"," email server with a modular\nplugin architecture. Haraka can serve thousands of concurrent connections\nand deliver thousands of messages per second. Haraka and plugins are written\nin asynchronous JS and are very fast.",[228,313,314,315,320,321,326,327,332,333,338],{},"Haraka has very good spam protection (see ",[235,316,319],{"href":317,"rel":318},"https:\u002F\u002Fgithub.com\u002Fharaka\u002FHaraka\u002Fblob\u002Fmaster\u002FPlugins.md",[295],"plugins",") and works\nwell as a filtering ",[235,322,325],{"href":323,"rel":324},"http:\u002F\u002Fen.wikipedia.org\u002Fwiki\u002FMessage_transfer_agent",[295],"MTA",". It also works well as a ",[235,328,331],{"href":329,"rel":330},"http:\u002F\u002Fen.wikipedia.org\u002Fwiki\u002FMail_submission_agent",[295],"MSA"," running on\nport 587 with auth and ",[235,334,337],{"href":335,"rel":336},"https:\u002F\u002Fgithub.com\u002Fharaka\u002Fharaka-plugin-dkim",[295],"dkim"," plugins enabled.",[228,340,341,342,347,348,352],{},"Haraka makes no attempt to be a mail store (like Exchange or Postfix\u002FExim\u002FQmail),\na ",[235,343,346],{"href":344,"rel":345},"https:\u002F\u002Fen.wikipedia.org\u002Fwiki\u002FMail_delivery_agent",[295],"LDA",", nor an IMAP server (like Dovecot or Courier). Haraka is\ntypically used ",[349,350,351],"strong",{},"with"," such systems.",[228,354,355,356,360,361,364],{},"Haraka has a scalable outbound mail delivery engine built in. Mail\nmarked as ",[357,358,359],"code",{},"relaying"," (such as via an ",[357,362,363],{},"auth"," plugin) is automatically\nqueued for outbound delivery.",[366,367,369],"h3",{"id":368},"getting-help","Getting Help",[371,372,373,381],"ul",{},[374,375,376,380],"li",{},[235,377,379],{"href":378},"mailto:haraka-sub@harakamail.com","Join the mailing list"," (implemented as a Haraka plugin)",[374,382,383],{},[235,384,387],{"href":385,"rel":386},"https:\u002F\u002Fgithub.com\u002Fharaka\u002FHaraka\u002Fissues",[295],"GitHub Issues",[366,389,391],{"id":390},"screencast","Screencast",[393,394],"iframe",{"className":395,"src":399,"title":400,"allowFullScreen":401},[396,397,398],"w-full","aspect-video","rounded-md","https:\u002F\u002Fwww.youtube-nocookie.com\u002Fembed\u002F6twKXMAsPsw","Haraka screencast",true,[366,403,405],{"id":404},"why-use-haraka","Why Use Haraka?",[228,407,408],{},"Haraka's plugin architecture provides an easily extensible MTA that\ncomplements traditional MTAs that excel at managing mail stores but do\nnot have sufficient filtering.",[228,410,411,412,415,416,419],{},"The plugin system makes it easy to code new features. A typical example\nis providing qmail-like extended addresses to an Exchange system,\nwhereby you could receive mail as ",[357,413,414],{},"user-anyword@domain.com",", and yet\nstill have it correctly routed to ",[357,417,418],{},"user@domain.com",". This is a few lines of\ncode in Haraka.",[228,421,422,423,428,429,434,435,440,441,446],{},"Plugins are provided for running mail through ",[235,424,427],{"href":425,"rel":426},"https:\u002F\u002Fgithub.com\u002Fharaka\u002Fharaka-plugin-spamassassin",[295],"SpamAssassin",", validating\n",[235,430,433],{"href":431,"rel":432},"https:\u002F\u002Fgithub.com\u002Fharaka\u002Fharaka-plugin-helo.checks",[295],"HELO"," names, checking ",[235,436,439],{"href":437,"rel":438},"https:\u002F\u002Fgithub.com\u002Fharaka\u002Fharaka-plugin-dns-list",[295],"DNS Blocklists",", and ",[235,442,445],{"href":443,"rel":444},"https:\u002F\u002Fgithub.com\u002Fharaka\u002FHaraka\u002Ftree\u002Fmaster\u002Fplugins",[295],"many others",".",[366,448,450],{"id":449},"installing-haraka","Installing Haraka",[228,452,453,454,457,458,463],{},"Haraka requires ",[235,455,310],{"href":308,"rel":456},[295]," to run. Install Haraka with ",[235,459,462],{"href":460,"rel":461},"https:\u002F\u002Fwww.npmjs.com\u002Fpackage\u002FHaraka",[295],"npm",":",[465,466,467,492,510],"code-group",{},[468,469,473],"pre",{"className":470,"code":471,"filename":462,"language":472,"meta":275,"style":275},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","npm install -g Haraka\n","bash",[357,474,475],{"__ignoreMap":275},[476,477,479,482,486,489],"span",{"class":478,"line":277},"line",[476,480,462],{"class":481},"sBMFI",[476,483,485],{"class":484},"sfazB"," install",[476,487,488],{"class":484}," -g",[476,490,491],{"class":484}," Haraka\n",[468,493,496],{"className":470,"code":494,"filename":495,"language":472,"meta":275,"style":275},"yarn add global Haraka\n","yarn",[357,497,498],{"__ignoreMap":275},[476,499,500,502,505,508],{"class":478,"line":277},[476,501,495],{"class":481},[476,503,504],{"class":484}," add",[476,506,507],{"class":484}," global",[476,509,491],{"class":484},[468,511,514],{"className":470,"code":512,"filename":513,"language":472,"meta":275,"style":275},"pnpm add -g Haraka\n","pnpm",[357,515,516],{"__ignoreMap":275},[476,517,518,520,522,524],{"class":478,"line":277},[476,519,513],{"class":481},[476,521,504],{"class":484},[476,523,488],{"class":484},[476,525,491],{"class":484},[527,528,529],"note",{},"If the command gives \"nobody\" errors run the next command",[465,531,532],{},[468,533,535],{"className":470,"code":534,"filename":462,"language":472,"meta":275,"style":275},"npm -g config set user root\nnpm install -g Haraka\n",[357,536,537,555],{"__ignoreMap":275},[476,538,539,541,543,546,549,552],{"class":478,"line":277},[476,540,462],{"class":481},[476,542,488],{"class":484},[476,544,545],{"class":484}," config",[476,547,548],{"class":484}," set",[476,550,551],{"class":484}," user",[476,553,554],{"class":484}," root\n",[476,556,558,560,562,564],{"class":478,"line":557},2,[476,559,462],{"class":481},[476,561,485],{"class":484},[476,563,488],{"class":484},[476,565,491],{"class":484},[228,567,568,569,571],{},"After installation, use the ",[357,570,225],{}," binary to set up the service.",[366,573,575],{"id":574},"running-haraka","Running Haraka",[228,577,578],{},"First, create the service:",[468,580,584],{"className":581,"code":582,"language":583,"meta":275,"style":275},"language-sh shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","haraka -i \u002Fpath\u002Fto\u002Fharaka_test\n","sh",[357,585,586],{"__ignoreMap":275},[476,587,588],{"class":478,"line":277},[476,589,582],{},[228,591,592,593,596,597,600,601,604,605,446],{},"That creates the directory ",[357,594,595],{},"haraka_test"," with ",[357,598,599],{},"config"," and ",[357,602,603],{},"plugin","\ndirectories within. It also sets the host name used by Haraka\nto the output of ",[357,606,607],{},"hostname",[228,609,610,611,613,614,617,618,620,621,624,625,627],{},"If ",[357,612,607],{}," is not correct, edit ",[357,615,616],{},"config\u002Fhost_list",". For example,\nto receive mail addressed to ",[357,619,418],{},", add ",[357,622,623],{},"domain.com"," to the\n",[357,626,616],{}," file.",[228,629,630],{},"Finally, start Haraka using root permissions:",[468,632,634],{"className":581,"code":633,"language":583,"meta":275,"style":275},"haraka -c \u002Fpath\u002Fto\u002Fharaka_test\n",[357,635,636],{"__ignoreMap":275},[476,637,638],{"class":478,"line":277},[476,639,633],{},[228,641,642],{},"And it will run.",[366,644,646],{"id":645},"configure-haraka","Configure Haraka",[228,648,649,650,653,654,656,657,660,661,446],{},"To choose which plugins run, edit ",[357,651,652],{},"config\u002Fplugins",". Plugins control the\noverall behaviour of Haraka. By default, only messages to domains listed\nin ",[357,655,616],{}," will be accepted and then delivered via the\n",[357,658,659],{},"smtp-forward"," plugin. Configure the destination in ",[357,662,663],{},"config\u002Fsmtp_forward.ini",[366,665,667],{"id":666},"read-the-fine-manual","Read the Fine Manual",[468,669,671],{"className":581,"code":670,"language":583,"meta":275,"style":275},"haraka -h plugins\u002F$name\n",[357,672,673],{"__ignoreMap":275},[476,674,675],{"class":478,"line":277},[476,676,670],{},[228,678,679,680,682],{},"The docs detail how each plugin is configured. After editing\n",[357,681,652],{},", restart Haraka and enjoy!",[366,684,686],{"id":685},"running-from-git","Running from git",[228,688,689],{},"If you are unable to use npm to install Haraka, you can run from git by\nfollowing these steps:",[228,691,692],{},"First clone the repository:",[468,694,696],{"className":581,"code":695,"language":583,"meta":275,"style":275},"git clone https:\u002F\u002Fgithub.com\u002Fharaka\u002FHaraka.git\ncd Haraka\n",[357,697,698,703],{"__ignoreMap":275},[476,699,700],{"class":478,"line":277},[476,701,702],{},"git clone https:\u002F\u002Fgithub.com\u002Fharaka\u002FHaraka.git\n",[476,704,705],{"class":478,"line":557},[476,706,707],{},"cd Haraka\n",[228,709,710],{},"Install Haraka's node.js dependencies locally:",[468,712,714],{"className":581,"code":713,"language":583,"meta":275,"style":275},"npm install\n",[357,715,716],{"__ignoreMap":275},[476,717,718],{"class":478,"line":277},[476,719,713],{},[228,721,722,723,600,725,728],{},"Edit ",[357,724,652],{},[357,726,727],{},"config\u002Fsmtp.ini"," to specify the plugins and\nconfig you want.",[228,730,731],{},"Finally run Haraka:",[468,733,735],{"className":581,"code":734,"language":583,"meta":275,"style":275},"node haraka.js\n",[357,736,737],{"__ignoreMap":275},[476,738,739],{"class":478,"line":277},[476,740,734],{},[366,742,744],{"id":743},"license-and-author","License and Author",[228,746,747,748,753],{},"Haraka is MIT licensed - see the ",[235,749,752],{"href":750,"rel":751},"https:\u002F\u002Fgithub.com\u002Fharaka\u002FHaraka\u002Fblob\u002Fmaster\u002FLICENSE",[295],"LICENSE"," file for details.",[228,755,756,757,762,763,446],{},"Haraka is a project started by ",[235,758,761],{"href":759,"rel":760},"https:\u002F\u002Fgithub.com\u002Fbaudehlo",[295],"Matt Sergeant",", a 10 year veteran of the email\nand anti-spam world. Previous projects have been the project leader for\nSpamAssassin and a hacker on ",[235,764,767],{"href":765,"rel":766},"https:\u002F\u002Fgithub.com\u002Fsmtpd\u002Fqpsmtpd\u002F",[295],"Qpsmtpd",[769,770,771],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight