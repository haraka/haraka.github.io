itle":210,"path":211,"stem":212},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":214,"path":215,"stem":216},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":218,"title":5,"body":219,"description":784,"extension":785,"links":786,"meta":787,"navigation":401,"path":6,"seo":788,"stem":7,"__hash__":789},"docs\u002F1.getting_started.md",{"type":220,"value":221,"toc":770},"minimark",[222,227,231,238,278,303,312,339,353,365,370,388,392,402,406,409,420,445,449,462,524,528,564,570,574,577,588,606,626,629,638,641,645,662,666,675,681,685,688,691,706,709,718,727,730,739,743,752,766],[223,224,226],"h2",{"id":225},"haraka","Haraka",[228,229,230],"p",{},"A modern, high performance, flexible SMTP server.",[228,232,233,234,237],{},"Haraka is an open source SMTP server written in Node.js which provides extremely high performance coupled with a flexible plugin system allowing Javascript programmers full access to change the behaviour of the server. It is used heavily in some high traffic sites - see the ",[235,236,17],"a",{"href":18}," page for testimonials.",[239,240,246,247,246,253,246,257,246,260,246,264,246,272],"form",{"action":241,"method":242,"target":243,"className":244},"https:\u002F\u002Fwww.paypal.com\u002Fcgi-bin\u002Fwebscr","post","_top",[245],"h-10","\n    ",[248,249],"input",{"type":250,"name":251,"value":252},"hidden","cmd","_donations",[248,254],{"type":250,"name":255,"value":256},"business","helpme+paypal@gmail.com",[248,258],{"type":250,"name":259,"value":226},"item_name",[248,261],{"type":250,"name":262,"value":263},"currency_code","CAD",[248,265],{"type":266,"src":267,"border":268,"name":269,"title":270,"alt":271},"image","https:\u002F\u002Fwww.paypalobjects.com\u002Fen_US\u002Fi\u002Fbtn\u002Fbtn_donate_LG.gif",0,"submit","PayPal - The safer, easier way to pay online!","Donate with PayPal button",[273,274],"img",{"alt":275,"border":268,"src":276,"width":277,"height":277},"","https:\u002F\u002Fwww.paypal.com\u002Fen_US\u002Fi\u002Fscr\u002Fpixel.gif",1,[279,280,246,284,246,291],"div",{"className":281},[282,283],"flex","space-x-4",[235,285,287],{"href":286},"https:\u002F\u002Fgithub.com\u002Fharaka\u002FHaraka\u002Factions\u002Fworkflows\u002Fci.yml",[273,288],{"alt":289,"src":290},"Tests","https:\u002F\u002Fgithub.com\u002Fharaka\u002FHaraka\u002Factions\u002Fworkflows\u002Fci.yml\u002Fbadge.svg",[235,292,299],{"href":293,"rel":294,"target":298},"https:\u002F\u002Fcodecov.io\u002Fgithub\u002Fharaka\u002FHaraka?branch=master",[295,296,297],"nofollow","noopener","noreferrer","_blank",[273,300],{"dataVF58a9f50":275,"alt":301,"src":302},"Coverage Status","https:\u002F\u002Fcodecov.io\u002Fgithub\u002Fharaka\u002FHaraka\u002Fcoverage.svg",[228,304,305,306,311],{},"Haraka is a highly scalable ",[235,307,310],{"href":308,"rel":309},"http:\u002F\u002Fnodejs.org",[295],"node.js"," email server with a modular\nplugin architecture. Haraka can serve thousands of concurrent connections\nand deliver thousands of messages per second. Haraka and plugins are written\nin asynchronous JS and are very fast.",[228,313,314,315,320,321,326,327,332,333,338],{},"Haraka has very good spam protection (see ",[235,316,319],{"href":317,"rel":318},"https:\u002F\u002Fgithub.com\u002Fharaka\u002FHaraka\u002Fblob\u002Fmaster\u002FPlugins.md",[295],"plugins",") and works\nwell as a filtering ",[235,322,325],{"href":323,"rel":324},"http:\u002F\u002Fen.wikipedia.org\u002Fwiki\u002FMessage_transfer_agent",[295],"MTA",". It also works well as a ",[235,328,331],{"href":329,"rel":330},"http:\u002F\u002Fen.wikipedia.org\u002Fwiki\u002FMail_submission_agent",[295],"MSA"," running on\nport 587 with auth and ",[235,334,337],{"href":335,"rel":336},"https:\u002F\u002Fgithub.com\u002Fharaka\u002Fharaka-plugin-dkim",[295],"dkim"," plugins enabled.",[228,340,341,342,347,348,352],{},"Haraka makes no attempt to be a mail store (like Exchange or Postfix\u002FExim\u002FQmail),\na ",[235,343,346],{"href":344,"rel":345},"https:\u002F\u002Fen.wikipedia.org\u002Fwiki\u002FMail_delivery_agent",[295],"LDA",", nor an IMAP server (like Dovecot or Courier). Haraka is\ntypically used ",[349,350,351],"strong",{},"with"," such systems.",[228,354,355,356,360,361,364],{},"Haraka has a scalable outbound mail delivery engine built in. Mail\nmarked as ",[357,358,359],"code",{},"relaying"," (such as via an ",[357,362,363],{},"auth"," plugin) is automatically\nqueued for outbound delivery.",[366,367,369],"h3",{"id":368},"getting-help","Getting Help",[371,372,373,381],"ul",{},[374,375,376,380],"li",{},[235,377,379],{"href":378},"mailto:haraka-sub@harakamail.com","Join the mailing list"," (implemented as a Haraka plugin)",[374,382,383],{},[235,384,387],{"href":385,"rel":386},"https:\u002F\u002Fgithub.com\u002Fharaka\u002FHaraka\u002Fissues",[295],"GitHub Issues",[366,389,391],{"id":390},"screencast","Screencast",[393,394],"iframe",{"className":395,"src":399,"title":400,"allowFullScreen":401},[396,397,398],"w-full","aspect-video","rounded-md","https:\u002F\u002Fwww.youtube-nocookie.com\u002Fembed\u002F6twKXMAsPsw","Haraka screencast",true,[366,403,405],{"id":404},"why-use-haraka","Why Use Haraka?",[228,407,408],{},"Haraka's plugin architecture provides an easily extensible MTA that\ncomplements traditional MTAs that excel at managing mail stores but do\nnot have sufficient filtering.",[228,410,411,412,415,416,419],{},"The plugin system makes it easy to code new features. A typical example\nis providing qmail-like extended addresses to an Exchange system,\nwhereby you could receive mail as ",[357,413,414],{},"user-anyword@domain.com",", and yet\nstill have it correctly routed to ",[357,417,418],{},"user@domain.com",". This is a few lines of\ncode in Haraka.",[228,421,422,423,428,429,434,435,440,441,444],{},"Plugins are provided for running mail through ",[235,424,427],{"href":425,"rel":426},"https:\u002F\u002Fgithub.com\u002Fharaka\u002Fharaka-plugin-spamassassin",[295],"SpamAssassin",", validating\n",[235,430,433],{"href":431,"rel":432},"https:\u002F\u002Fgithub.com\u002Fharaka\u002Fharaka-plugin-helo.checks",[295],"HELO"," names, checking ",[235,436,439],{"href":437,"rel":438},"https:\u002F\u002Fgithub.com\u002Fharaka\u002Fharaka-plugin-dns-list",[295],"DNS Blocklists",", and ",[235,442,443],{"href":104},"many others",".",[366,446,448],{"id":447},"installing-haraka","Installing Haraka",[228,450,451,452,455,456,461],{},"Haraka requires ",[235,453,310],{"href":308,"rel":454},[295]," to run. Install Haraka with ",[235,457,460],{"href":458,"rel":459},"https:\u002F\u002Fwww.npmjs.com\u002Fpackage\u002FHaraka",[295],"npm",":",[463,464,465,490,508],"code-group",{},[466,467,471],"pre",{"className":468,"code":469,"filename":460,"language":470,"meta":275,"style":275},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","npm install -g Haraka\n","bash",[357,472,473],{"__ignoreMap":275},[474,475,477,480,484,487],"span",{"class":476,"line":277},"line",[474,478,460],{"class":479},"sBMFI",[474,481,483],{"class":482},"sfazB"," install",[474,485,486],{"class":482}," -g",[474,488,489],{"class":482}," Haraka\n",[466,491,494],{"className":468,"code":492,"filename":493,"language":470,"meta":275,"style":275},"yarn add global Haraka\n","yarn",[357,495,496],{"__ignoreMap":275},[474,497,498,500,503,506],{"class":476,"line":277},[474,499,493],{"class":479},[474,501,502],{"class":482}," add",[474,504,505],{"class":482}," global",[474,507,489],{"class":482},[466,509,512],{"className":468,"code":510,"filename":511,"language":470,"meta":275,"style":275},"pnpm add -g Haraka\n","pnpm",[357,513,514],{"__ignoreMap":275},[474,515,516,518,520,522],{"class":476,"line":277},[474,517,511],{"class":479},[474,519,502],{"class":482},[474,521,486],{"class":482},[474,523,489],{"class":482},[525,526,527],"note",{},"If the command gives \"nobody\" errors run the next command",[463,529,530],{},[466,531,533],{"className":468,"code":532,"filename":460,"language":470,"meta":275,"style":275},"npm -g config set user root\nnpm install -g Haraka\n",[357,534,535,553],{"__ignoreMap":275},[474,536,537,539,541,544,547,550],{"class":476,"line":277},[474,538,460],{"class":479},[474,540,486],{"class":482},[474,542,543],{"class":482}," config",[474,545,546],{"class":482}," set",[474,548,549],{"class":482}," user",[474,551,552],{"class":482}," root\n",[474,554,556,558,560,562],{"class":476,"line":555},2,[474,557,460],{"class":479},[474,559,483],{"class":482},[474,561,486],{"class":482},[474,563,489],{"class":482},[228,565,566,567,569],{},"After installation, use the ",[357,568,225],{}," binary to set up the service.",[366,571,573],{"id":572},"running-haraka","Running Haraka",[228,575,576],{},"First, create the service:",[466,578,582],{"className":579,"code":580,"language":581,"meta":275,"style":275},"language-sh shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","haraka -i \u002Fpath\u002Fto\u002Fharaka_test\n","sh",[357,583,584],{"__ignoreMap":275},[474,585,586],{"class":476,"line":277},[474,587,580],{},[228,589,590,591,594,595,598,599,602,603,444],{},"That creates the directory ",[357,592,593],{},"haraka_test"," with ",[357,596,597],{},"config"," and ",[357,600,601],{},"plugin","\ndirectories within. It also sets the host name used by Haraka\nto the output of ",[357,604,605],{},"hostname",[228,607,608,609,611,612,615,616,618,619,622,623,625],{},"If ",[357,610,605],{}," is not correct, edit ",[357,613,614],{},"config\u002Fhost_list",". For example,\nto receive mail addressed to ",[357,617,418],{},", add ",[357,620,621],{},"domain.com"," to the\n",[357,624,614],{}," file.",[228,627,628],{},"Finally, start Haraka using root permissions:",[466,630,632],{"className":579,"code":631,"language":581,"meta":275,"style":275},"haraka -c \u002Fpath\u002Fto\u002Fharaka_test\n",[357,633,634],{"__ignoreMap":275},[474,635,636],{"class":476,"line":277},[474,637,631],{},[228,639,640],{},"And it will run.",[366,642,644],{"id":643},"configure-haraka","Configure Haraka",[228,646,647,648,651,652,654,655,658,659,444],{},"To choose which plugins run, edit ",[357,649,650],{},"config\u002Fplugins",". Plugins control the\noverall behaviour of Haraka. By default, only messages to domains listed\nin ",[357,653,614],{}," will be accepted and then delivered via the\n",[357,656,657],{},"smtp-forward"," plugin. Configure the destination in ",[357,660,661],{},"config\u002Fsmtp_forward.ini",[366,663,665],{"id":664},"read-the-fine-manual","Read the Fine Manual",[466,667,669],{"className":579,"code":668,"language":581,"meta":275,"style":275},"haraka -h plugins\u002F$name\n",[357,670,671],{"__ignoreMap":275},[474,672,673],{"class":476,"line":277},[474,674,668],{},[228,676,677,678,680],{},"The docs detail how each plugin is configured. After editing\n",[357,679,650],{},", restart Haraka and enjoy!",[366,682,684],{"id":683},"running-from-git","Running from git",[228,686,687],{},"If you are unable to use npm to install Haraka, you can run from git by\nfollowing these steps:",[228,689,690],{},"First clone the repository:",[466,692,694],{"className":579,"code":693,"language":581,"meta":275,"style":275},"git clone https:\u002F\u002Fgithub.com\u002Fharaka\u002FHaraka.git\ncd Haraka\n",[357,695,696,701],{"__ignoreMap":275},[474,697,698],{"class":476,"line":277},[474,699,700],{},"git clone https:\u002F\u002Fgithub.com\u002Fharaka\u002FHaraka.git\n",[474,702,703],{"class":476,"line":555},[474,704,705],{},"cd Haraka\n",[228,707,708],{},"Install Haraka's node.js dependencies locally:",[466,710,712],{"className":579,"code":711,"language":581,"meta":275,"style":275},"npm install\n",[357,713,714],{"__ignoreMap":275},[474,715,716],{"class":476,"line":277},[474,717,711],{},[228,719,720,721,598,723,726],{},"Edit ",[357,722,650],{},[357,724,725],{},"config\u002Fsmtp.ini"," to specify the plugins and\nconfig you want.",[228,728,729],{},"Finally run Haraka:",[466,731,733],{"className":579,"code":732,"language":581,"meta":275,"style":275},"node haraka.js\n",[357,734,735],{"__ignoreMap":275},[474,736,737],{"class":476,"line":277},[474,738,732],{},[366,740,742],{"id":741},"license-and-author","License and Author",[228,744,745,746,751],{},"Haraka is MIT licensed - see the ",[235,747,750],{"href":748,"rel":749},"https:\u002F\u002Fgithub.com\u002Fharaka\u002FHaraka\u002Fblob\u002Fmaster\u002FLICENSE",[295],"LICENSE"," file for details.",[228,753,754,755,760,761,444],{},"Haraka is a project started by ",[235,756,759],{"href":757,"rel":758},"https:\u002F\u002Fgithub.com\u002Fbaudehlo",[295],"Matt Sergeant",", a 10 year veteran of the email\nand anti-spam world. Previous projects have been the project leader for\nSpamAssassin and a hacker on ",[235,762,765],{"href":763,"rel":764},"https:\u002F\u002Fgithub.com\u002Fsmtpd\u002Fqpsmtpd\u002F",[295],"Qpsmtpd",[767,768,769],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span 