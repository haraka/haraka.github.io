210,"path":211,"stem":212},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":214,"path":215,"stem":216},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":218,"title":26,"body":219,"description":225,"extension":319,"links":320,"meta":321,"navigation":322,"path":27,"seo":323,"stem":28,"__hash__":324},"docs\u002F6.core\u002F1.Address.md",{"type":220,"value":221,"toc":314},"minimark",[222,226,231,238,241,246,249,254,257,262,265,270,278,283,286,291,294,298,301,304],[223,224,225],"p",{},"The Address object is an interface to reading email addresses passed in at\nSMTP time. As such it parses all the formats in RFC-2821 and 2822, and\nsupports correctly escaping email addresses.",[227,228,230],"h2",{"id":229},"api","API",[232,233,234],"ul",{},[235,236,237],"li",{},"new Address (user, host)",[223,239,240],{},"Create a new address object for user@host",[232,242,243],{},[235,244,245],{},"new Address (email)",[223,247,248],{},"Creates a new address object by parsing the email address. Will throw an\nexception if the address cannot be parsed.",[232,250,251],{},[235,252,253],{},"address.user",[223,255,256],{},"Access the local part of the email address",[232,258,259],{},[235,260,261],{},"address.host",[223,263,264],{},"Access the domain part of the email adress",[232,266,267],{},[235,268,269],{},"address.format()",[223,271,272,273,277],{},"Provides the email address in the appropriate ",[274,275,276],"code",{},"\u003Cuser@host>"," format. And\ndeals correctly with the null sender and local names.",[232,279,280],{},[235,281,282],{},"address.toString()",[223,284,285],{},"Same as format().",[232,287,288],{},[235,289,290],{},"address.address",[223,292,293],{},"Provides the email address in 'user@host' format.",[227,295,297],{"id":296},"advanced-usage","Advanced Usage",[223,299,300],{},"It is possible to mess with the regular expressions used to match addresses\nfor stricter or less strict matching.",[223,302,303],{},"To change the behaviour mess with the following variables:",[305,306,311],"pre",{"className":307,"code":309,"language":310},[308],"language-text","var adr = require('.\u002Faddress');\n\u002F\u002F Now change one of the following. Note they are RegExp objects NOT strings.\nadr.atom_expr;\nadr.address_literal_expr;\nadr.subdomain_expr;\nadr.domain_expr;\nadr.qtext_expr;\nadr.text_expr;\n\u002F\u002F Don't forget to recompile:\nadr.compile_re();\n","text",[274,312,309],{"__ignoreMap":313},"",{"title":313,"searchDepth":315,"depth":315,"links":316},2,[317,318],{"id":229,"depth":315,"text":230},{"id":296,"depth":315,"text":297},"md",null,{"_path":27},true,{"title":26,"description":225},"2Xv2hwIq9i8_VztOfP_eijpKF9UxBuajxdw4OvFkLnE",[326,328],{"title":17,"path":18,"stem":19,"description":327,"children":-1},"Large Scale Haraka Users",{"title":30,"path":31,"stem":32,"description":329,"children":-1},"This module provides network utility functions.",1794458075252]