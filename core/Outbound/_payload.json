002Fsyslog","8.plugins\u002Fsyslog",{"title":354,"path":355,"stem":356},"tarpit","\u002Fplugins\u002Ftarpit","8.plugins\u002Ftarpit",{"title":358,"path":359,"stem":360},"tls","\u002Fplugins\u002Ftls","8.plugins\u002Ftls",{"title":362,"path":363,"stem":364},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":366,"path":367,"stem":368},"uribl","\u002Fplugins\u002Furibl","8.plugins\u002Furibl",{"title":370,"path":371,"stem":372},"watch","\u002Fplugins\u002Fwatch","8.plugins\u002Fwatch",{"title":374,"path":375,"stem":376},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":378,"title":379,"body":380,"description":1801,"extension":1802,"links":1803,"meta":1804,"navigation":1805,"path":39,"seo":1806,"stem":40,"__hash__":1807},"docs\u002F6.core\u002F12.Outbound.md","Outbound Mail with Haraka",{"type":381,"value":382,"toc":1781},"minimark",[383,387,405,411,418,423,428,437,440,447,450,457,460,487,511,534,541,547,554,565,572,575,582,585,592,621,625,628,632,639,642,648,669,673,680,734,738,742,761,765,771,774,781,785,790,807,820,824,829,843,850,860,864,869,883,894,900,904,909,915,922,978,982,985,992,1006,1010,1023,1026,1030,1037,1047,1073,1076,1080,1083,1090,1540,1554,1557,1583,1590,1625,1632,1710,1762,1777],[384,385,386],"p",{},"A default installation of Haraka will queue outbound mail for delivery in the queue directory. Those mails will be delivered to the appropriate MX record for that domain. Mails are queued onto your disk, and will deal appropriately with temporary failures to retry delivery later.",[384,388,389,390,394,395,398,399,401,402,404],{},"Outbound mails are defined as those that have set the ",[391,392,393],"code",{},"connection.relaying"," flag to ",[391,396,397],{},"true"," via a plugin. The simplest way of doing that is to use SMTP AUTH, and have the client authenticate. For example using the ",[391,400,145],{}," plugin. The ",[391,403,326],{}," plugin provides common ways to set it and it is simple to write a custom plugin to do this.",[384,406,407,408,410],{},"For statistics on outbound mail use the ",[391,409,253],{}," plugin. See the documentation for that plugin for details.",[384,412,413,414,417],{},"To flush the outbound queue (for temporary failed mails) hit the Haraka master process with the SIGHUP signal (via the ",[391,415,416],{},"kill"," command line tool).",[419,420,422],"h2",{"id":421},"outbound-configuration-files","Outbound Configuration Files",[424,425,427],"h3",{"id":426},"outboundini","outbound.ini",[429,430,431],"ul",{},[432,433,434],"li",{},[391,435,436],{},"disabled",[384,438,439],{},"Default: false. Allows one to temporarily disable outbound delivery, while still receiving and queuing emails. This can be changed while Haraka is running.",[429,441,442],{},[432,443,444],{},[391,445,446],{},"concurrency_max",[384,448,449],{},"Default: 100. Specifies the maximum concurrent connections to make. Note that if using cluster (multiple CPUs) this will be multiplied by the number of CPUs that you have.",[429,451,452],{},[432,453,454],{},[391,455,456],{},"enable_tls",[384,458,459],{},"Default: true. Switch to false to disable TLS for outbound mail.",[384,461,462,463,466,467,470,471,474,475,478,479,486],{},"This uses the same ",[391,464,465],{},"tls_key.pem"," and ",[391,468,469],{},"tls_cert.pem"," files that the ",[391,472,473],{},"TLS"," plugin uses, along with other values in ",[391,476,477],{},"tls.ini",". See the ",[480,481,485],"a",{"href":482,"rel":483},"https:\u002F\u002Fharaka.github.io\u002Fplugins\u002Ftls",[484],"nofollow","TLS plugin docs"," for more information.",[384,488,489,490,492,493,496,497,496,500,466,503,506,507,510],{},"Within ",[391,491,477],{}," you can specify global options for the values ",[391,494,495],{},"ciphers",", ",[391,498,499],{},"minVersion",[391,501,502],{},"requestCert",[391,504,505],{},"rejectUnauthorized",", alternatively you can provide separate values by putting them under a key: ",[391,508,509],{},"[outbound]",", such as:",[512,513,518],"pre",{"className":514,"code":515,"language":516,"meta":517,"style":517},"language-ini shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","[outbound]\nciphers=!DES\n","ini","",[391,519,520,528],{"__ignoreMap":517},[521,522,525],"span",{"class":523,"line":524},"line",1,[521,526,527],{},"[outbound]\n",[521,529,531],{"class":523,"line":530},2,[521,532,533],{},"ciphers=!DES\n",[429,535,536],{},[432,537,538],{},[391,539,540],{},"always_split",[384,542,543,544,546],{},"Default: false. By default, Haraka groups message recipients by domain so that messages with multiple recipients at the same domain get sent in a single SMTP session. When ",[391,545,540],{}," is enabled, each recipient gets a queue entry and delivery in its own SMTP session. This carries a performance penalty but enables more flexibility in mail delivery and bounce handling.",[429,548,549],{},[432,550,551],{},[391,552,553],{},"received_header",[384,555,556,557,560,561,564],{},"Default: \"Haraka outbound\". If this text is any string except ",[558,559,436],"em",{},", the string is attached as a ",[391,562,563],{},"Received"," header to all outbound mail just before it is queued.",[429,566,567],{},[432,568,569],{},[391,570,571],{},"connect_timeout",[384,573,574],{},"Timeout for connecting to remote servers. Default: 30s",[429,576,577],{},[432,578,579],{},[391,580,581],{},"local_mx_ok",[384,583,584],{},"Default: false. By default, outbound to a local IP is disabled, to avoid creating mail loops. Set this to true if you want to allow outbound to local IPs. This could be useful if you want to deliver mail to private IPs or localhost on another port.",[429,586,587],{},[432,588,589],{},[391,590,591],{},"temp_fail_intervals",[384,593,594,595,496,598,496,601,604,605,608,609,612,613,616,617,620],{},"Set this to specify the delay intervals to use between trying to re-send an email that has a temporary failure condition.  The setting is a comma separated list of time spans and multipliers.  The time span is a number followed by ",[391,596,597],{},"s",[391,599,600],{},"m",[391,602,603],{},"h",", or ",[391,606,607],{},"d"," to represent seconds, minutes, hours, and days, respectively.  The multiplier is an asterisk followed by an integer representing the number of times to repeat the interval. For example, the entry ",[391,610,611],{},"1m, 5m*2, 1h*3"," results in an array of delay times of\n",[391,614,615],{},"[60,300,300,3600,3600,3600]"," in seconds.  The email will be bounced when the array runs out of intervals (the 7th failure in this case).  Set this to ",[391,618,619],{},"none"," to bounce the email on the first temporary failure.",[424,622,624],{"id":623},"outboundbounce_message","outbound.bounce_message",[384,626,627],{},"See \"Bounce Messages\" below for details.",[419,629,631],{"id":630},"the-hmail-object","The HMail Object",[384,633,634,635,638],{},"Many hooks (see below) pass in a ",[391,636,637],{},"hmail"," object.",[384,640,641],{},"You likely won't ever need to call methods on this object, so they are left undocumented here.",[384,643,644,645,647],{},"The attributes of an ",[391,646,637],{}," object that may be of use are:",[429,649,650,653,656,659,666],{},[432,651,652],{},"path - the full path to the queue file",[432,654,655],{},"filename - the filename within the queue dir",[432,657,658],{},"num_failures - the number of times this mail has been temp failed",[432,660,661,662,665],{},"notes - notes you can store on a hmail object (similar to ",[391,663,664],{},"transaction.notes",") to allow you to pass information between outbound hooks",[432,667,668],{},"todo - see below",[419,670,672],{"id":671},"the-todo-object","The ToDo Object",[384,674,675,676,679],{},"The ",[391,677,678],{},"todo"," object contains information about how to deliver this mail. Keys you may be interested in are:",[429,681,682,696,704,710,725,728,731],{},[432,683,684,685,688,695],{},"rcpt_to - an Array of ",[391,686,687],{},"Address",[689,690,691],"sup",{},[480,692,694],{"href":693},"#fn1","1"," objects - the rfc.5821 recipients of this mail",[432,697,698,699,703],{},"mail_from - an Address",[689,700,701],{},[480,702,694],{"href":693}," object - the rfc.5821 sender of this mail",[432,705,706,707,709],{},"domain - the domain this mail is going to (see ",[391,708,540],{}," above)",[432,711,712,713],{},"notes - the original transaction.notes for this mail, also contains the following useful keys:\n",[429,714,715,722],{},[432,716,717,718,721],{},"outbound_ip - the IP address to bind to (do not set manually, use the ",[391,719,720],{},"get_mx"," hook)",[432,723,724],{},"outbound_helo - the EHLO domain to use (again, do not set manually)",[432,726,727],{},"queue_time - the epoch milliseconds time when this mail was queued",[432,729,730],{},"uuid - the original transaction.uuid",[432,732,733],{},"force_tls - if true, this mail will be sent over TLS or defer",[419,735,737],{"id":736},"outbound-mail-hooks","Outbound Mail Hooks",[424,739,741],{"id":740},"the-queue_outbound-hook","The queue_outbound hook",[384,743,744,745,748,749,752,753,756,757,760],{},"The first hook that is called prior to queueing an outbound mail is the ",[391,746,747],{},"queue_outbound"," hook. Only if all these hooks return ",[391,750,751],{},"CONT"," (or if there are no hooks) will the mail be queued for outbound delivery. A return of ",[391,754,755],{},"OK"," will indicate that the mail has been queued in some custom manner for outbound delivery. Any of the ",[391,758,759],{},"DENY"," return codes will cause the message to be appropriately rejected.",[424,762,764],{"id":763},"the-send_email-hook","The send_email hook",[384,766,767,768],{},"Parameters: ",[391,769,770],{},"next, hmail",[384,772,773],{},"Called just as the email is about to be sent.",[384,775,776,777,780],{},"Respond with ",[391,778,779],{},"next(DELAY, delay_seconds)"," to defer sending the email at this time.",[424,782,784],{"id":783},"the-get_mx-hook","The get_mx hook",[384,786,767,787],{},[391,788,789],{},"next, hmail, domain",[384,791,792,793,795,796,799,800,802,803,806],{},"Upon starting delivery the ",[391,794,720],{}," hook is called, with the parameter set to the domain in question (for example a mail to ",[391,797,798],{},"user@example.com"," will call the ",[391,801,720],{}," hook with ",[391,804,805],{},"(next, hmail, domain)"," as parameters). This is to allow you to implement a custom handler to find MX records. For most installations there is no reason to implement this hook - Haraka will find the MX records via DNS.",[384,808,809,810,813,814,819],{},"The MX is sent via next(OK, mx). ",[391,811,812],{},"mx"," is a ",[480,815,818],{"href":816,"rel":817},"https:\u002F\u002Fgithub.com\u002Fharaka\u002Fharaka-net-utils?tab=readme-ov-file#harakamx",[484],"HarakaMx"," object, an array of HarakaMx objects, or any suitable HarakaMx input.",[424,821,823],{"id":822},"the-deferred-hook","The deferred hook",[384,825,767,826],{},[391,827,828],{},"next, hmail, {delay: ..., err: ...}",[384,830,831,832,835,836,466,839,842],{},"If the mail is temporarily deferred, the ",[391,833,834],{},"deferred"," hook is called. The hook parameter is an object with keys: ",[391,837,838],{},"delay",[391,840,841],{},"err",", which explain the delay (in seconds) and error message.",[384,844,845,846,849],{},"If you want to stop at this point, and drop the mail completely, then you can call ",[391,847,848],{},"next(OK)",".",[384,851,852,853,856,857,849],{},"If you want to change the delay, then call ",[391,854,855],{},"next(DENYSOFT, delay_in_seconds)",". Using this you can define a custom delay algorithm indexed by ",[391,858,859],{},"hmail.num_failures",[424,861,863],{"id":862},"the-bounce-hook","The bounce hook",[384,865,767,866],{},[391,867,868],{},"next, hmail, error",[384,870,871,872,874,875,878,879,882],{},"If the mail completely bounces then the ",[391,873,161],{}," hook is called. This is ",[558,876,877],{},"not"," called if the mail is issued a temporary failure (a 4xx error code). The hook parameter is the error message received from the remote end as an ",[391,880,881],{},"Error"," object. The object may also have the following properties:",[429,884,885,888,891],{},[432,886,887],{},"mx - the MX object that caused the bounce",[432,889,890],{},"deferred_rcpt - the deferred recipients that eventually bounced",[432,892,893],{},"bounced_rcpt - the bounced recipients",[384,895,896,897,899],{},"If you do not wish to have a bounce message sent to the originating sender of the email then you can return ",[391,898,755],{}," from this hook to stop it from sending a bounce message.",[424,901,903],{"id":902},"the-delivered-hook","The delivered hook",[384,905,767,906],{},[391,907,908],{},"next, hmail, params",[384,910,911,912],{},"Params is a list of: ",[391,913,914],{},"[host, ip, response, delay, port, mode, ok_recips, secured]",[384,916,917,918,921],{},"When mails are successfully delivered to the remote end then the ",[391,919,920],{},"delivered"," hook is called. The return codes from this hook have no effect, so it is only useful for logging the fact that a successful delivery occurred.",[429,923,924,930,936,942,947,953,959,972],{},[432,925,926,929],{},[391,927,928],{},"host"," - Hostname of the MX that the message was delivered to,",[432,931,932,935],{},[391,933,934],{},"ip"," - IP address of the host that the message was delivered to,",[432,937,938,941],{},[391,939,940],{},"response"," - Variable contains the SMTP response text returned by the host that received the message and will typically contain the remote queue ID and",[432,943,944,946],{},[391,945,838],{}," - Time taken between the queue file being created and the  message being delivered.",[432,948,949,952],{},[391,950,951],{},"port"," - Port number that the message was delivered to.",[432,954,955,958],{},[391,956,957],{},"mode"," - Shows whether SMTP or LMTP was used to deliver the mail.",[432,960,961,964,965,967,971],{},[391,962,963],{},"ok_recips"," - an ",[391,966,687],{},[689,968,969],{},[480,970,694],{"href":693}," array containing all of the recipients that were successfully delivered to.",[432,973,974,977],{},[391,975,976],{},"secured"," - A boolean denoting if the connection used TLS or not.",[419,979,981],{"id":980},"outbound-ip-address","Outbound IP address",[384,983,984],{},"Normally the OS will decide which IP address will be used for outbound  connections using the IP routing table.",[384,986,987,988,991],{},"There are instances where you may want to separate outbound traffic on different IP addresses based on sender, domain or some other identifier. To do this, the IP address that you want to use ",[558,989,990],{},"must"," be bound to an interface (or alias) on the local system.",[384,993,994,995,998,999,1002,1003,1005],{},"As described above, the outbound IP can be set using the ",[391,996,997],{},"bind"," parameter and also the outbound helo for the IP can be set using the ",[391,1000,1001],{},"bind_ehlo"," parameter returned by the ",[391,1004,720],{}," hook.",[419,1007,1009],{"id":1008},"auth","AUTH",[384,1011,1012,1013,1015,1016,466,1019,1022],{},"If you wish to use AUTH for a particular domain or domains, or you wish to force all mail to an outbound service or smart host that requires authentication then you can use the ",[391,1014,720],{}," hook documented above to do this by supplying both ",[391,1017,1018],{},"auth_user",[391,1020,1021],{},"auth_pass"," properties in an MX object.",[384,1024,1025],{},"If AUTH properties are supplied and the remote end does not offer AUTH or there are no compatible AUTH methods, then the message will be sent without AUTH and a warning will be logged.",[419,1027,1029],{"id":1028},"bounce-messages","Bounce Messages",[384,1031,1032,1033,1036],{},"The contents of the bounce message are configured by a file called ",[391,1034,1035],{},"config\u002Foutbound.bounce_message",". If you look at this file you will see it contains several template entries wrapped in curly brackets. These will be populated as follows:",[384,1038,1039,1040,1043,1044,849],{},"Optional: Possibility to add HTML code (with optional image) to the bounce message is possible by adding the files ",[391,1041,1042],{},"config\u002Foutbound.bounce_message_html",". An image can be attached to the mail by using ",[391,1045,1046],{},"config\u002Foutbound.bounce_message_image",[429,1048,1049,1052,1055,1061,1064,1067,1070],{},[432,1050,1051],{},"pid - the current process id",[432,1053,1054],{},"date - the current date when the bounce occurred",[432,1056,1057,1058],{},"me - the contents of ",[391,1059,1060],{},"config\u002Fme",[432,1062,1063],{},"from - the originating sender of the message",[432,1065,1066],{},"msgid - a uuid for the mail",[432,1068,1069],{},"to - the end recipient of the message, or the first recipient if it was to\nmultiple people",[432,1071,1072],{},"reason - the text from the remote server indicating why it bounced",[384,1074,1075],{},"Following the bounce message itself will be a copy of the entire original message.",[419,1077,1079],{"id":1078},"creating-a-mail-internally-for-outbound-delivery","Creating a mail internally for outbound delivery",[384,1081,1082],{},"Sometimes it is necessary to generate a new mail from within a plugin.",[384,1084,1085,1086,1089],{},"To do that, you can use the ",[391,1087,1088],{},"outbound"," module directly:",[512,1091,1095],{"className":1092,"code":1093,"language":1094,"meta":517,"style":517},"language-js shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","const outbound = require('.\u002Foutbound');\n\nconst to = 'user@example.com';\nconst from = 'sender@example.com';\n\nconst contents = [\n    \"From: \" + from,\n    \"To: \" + to,\n    \"MIME-Version: 1.0\",\n    \"Content-type: text\u002Fplain; charset=us-ascii\",\n    \"Subject: Some subject here\",\n    \"\",\n    \"Some email body here\",\n    \"\"].join(\"\\n\");\n\nconst outnext = (code, msg) => {\n    switch (code) {\n        case DENY:  this.logerror(\"Sending mail failed: \" + msg);\n                    break;\n        case OK:    this.loginfo(\"mail sent\");\n                    next();\n                    break;\n        default:    this.logerror(\"Unrecognized return code from sending email: \" + msg);\n                    next();\n    }\n}\n\noutbound.send_email(from, to, contents, outnext)\n","js",[391,1096,1097,1133,1139,1158,1177,1182,1195,1216,1233,1245,1257,1269,1277,1289,1315,1320,1350,1368,1403,1411,1440,1451,1458,1487,1496,1502,1508,1513],{"__ignoreMap":517},[521,1098,1099,1103,1107,1111,1115,1118,1121,1125,1127,1130],{"class":523,"line":524},[521,1100,1102],{"class":1101},"spNyl","const",[521,1104,1106],{"class":1105},"sTEyZ"," outbound ",[521,1108,1110],{"class":1109},"sMK4o","=",[521,1112,1114],{"class":1113},"s2Zo4"," require",[521,1116,1117],{"class":1105},"(",[521,1119,1120],{"class":1109},"'",[521,1122,1124],{"class":1123},"sfazB",".\u002Foutbound",[521,1126,1120],{"class":1109},[521,1128,1129],{"class":1105},")",[521,1131,1132],{"class":1109},";\n",[521,1134,1135],{"class":523,"line":530},[521,1136,1138],{"emptyLinePlaceholder":1137},true,"\n",[521,1140,1142,1144,1147,1149,1152,1154,1156],{"class":523,"line":1141},3,[521,1143,1102],{"class":1101},[521,1145,1146],{"class":1105}," to ",[521,1148,1110],{"class":1109},[521,1150,1151],{"class":1109}," '",[521,1153,798],{"class":1123},[521,1155,1120],{"class":1109},[521,1157,1132],{"class":1109},[521,1159,1161,1163,1166,1168,1170,1173,1175],{"class":523,"line":1160},4,[521,1162,1102],{"class":1101},[521,1164,1165],{"class":1105}," from ",[521,1167,1110],{"class":1109},[521,1169,1151],{"class":1109},[521,1171,1172],{"class":1123},"sender@example.com",[521,1174,1120],{"class":1109},[521,1176,1132],{"class":1109},[521,1178,1180],{"class":523,"line":1179},5,[521,1181,1138],{"emptyLinePlaceholder":1137},[521,1183,1185,1187,1190,1192],{"class":523,"line":1184},6,[521,1186,1102],{"class":1101},[521,1188,1189],{"class":1105},"