2Fsyslog","8.plugins\u002Fsyslog",{"title":354,"path":355,"stem":356},"tarpit","\u002Fplugins\u002Ftarpit","8.plugins\u002Ftarpit",{"title":358,"path":359,"stem":360},"tls","\u002Fplugins\u002Ftls","8.plugins\u002Ftls",{"title":362,"path":363,"stem":364},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":366,"path":367,"stem":368},"uribl","\u002Fplugins\u002Furibl","8.plugins\u002Furibl",{"title":370,"path":371,"stem":372},"watch","\u002Fplugins\u002Fwatch","8.plugins\u002Fwatch",{"title":374,"path":375,"stem":376},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":378,"title":379,"body":380,"description":473,"extension":474,"links":475,"meta":476,"navigation":477,"path":75,"seo":478,"stem":76,"__hash__":479},"docs\u002F6.core\u002F7.HAProxy.md","HAProxy PROXY protocol extension support",{"type":381,"value":382,"toc":470},"minimark",[383,392,395,398,406,416,419,430,433,436,446,453,464],[384,385,386,387,391],"p",{},"Haraka natively supports the PROXY protocol ",[388,389,390],"span",{},"1",".",[384,393,394],{},"This allows an upstream proxy to pass IP address and port of the client which\nHaraka will use instead of the socket IP address (which is of the proxy).\nThis allows DNSBLs and access control lists to operate on the proxied address.",[384,396,397],{},"Support is disabled by default and if HAProxy or other attempts to send a\nPROXY command then Haraka will return a DENYSOFTDISCONNECT error.\nDENYSOFT is used to prevent configuration errors from rejecting valid mail.",[384,399,400,401,405],{},"To enable support for PROXY you must create a ",[402,403,404],"code",{},"haproxy_hosts"," configuration\nfile which should contain a list of IP addresses of the HAProxy hosts\nthat should be allowed to send the PROXY command. A range of IP\naddresses can be specified by it's CIDR network address.",[384,407,408,409,411,412,415],{},"When a host connects to Haraka that matches an IP address present in the\n",[402,410,404],{}," file - a banner is not sent, instead Haraka waits for the\nPROXY command to be sent before proceeding.  The connection will timeout\nwith ",[402,413,414],{},"421 PROXY timed out"," if the command is not sent within 30 seconds.",[384,417,418],{},"NOTE: because Haraka does not send a banner when a listed HAProxy host\nconnects you must set check-send-proxy to ensure that the service checks\nsend a PROXY command before they run.",[384,420,421,423,424],{},[388,422,390],{}," ",[425,426,427],"a",{"href":427,"rel":428},"http:\u002F\u002Fhaproxy.1wt.eu\u002Fdownload\u002F1.5\u002Fdoc\u002Fproxy-protocol.txt",[429],"nofollow",[384,431,432],{},"HAProxy supports the PROXY protocol in version 1.5 or later however there\nare patches available to add support for 1.4.",[384,434,435],{},"Here is an example listener section for haproxy.cfg:",[437,438,443],"pre",{"className":439,"code":441,"language":442},[440],"language-text","listen smtp :25\n        mode tcp\n        option tcplog\n        option smtpchk\n        balance roundrobin\n        server smtp1 ip.of.haraka.server1:25 check-send-proxy check inter 10s send-proxy\n        server smtp2 ip.of.haraka.server2:25 check-send-proxy check inter 10s send-proxy\n        server smtp3 ip.of.haraka.server3:25 check-send-proxy check inter 10s send-proxy\n        server smtp4 ip.of.haraka.server4:25 check-send-proxy check inter 10s send-proxy\n        server smtp5 ip.of.haraka.server5:25 check-send-proxy check inter 10s send-proxy\n","text",[402,444,441],{"__ignoreMap":445},"",[384,447,448,449,452],{},"The important part is ",[402,450,451],{},"send-proxy"," which causes HAProxy to send the PROXY\nextension on connection.",[384,454,455,456,459,460,463],{},"When using ",[402,457,458],{},"option smtpchk"," you will see CONNRESET errors reported in the Haraka logs as\nsmtpchk drops the connection before the HELO response is still being written.\nYou can use the ",[402,461,462],{},"option tcp-check"," instead to provide a better service check by having\nthe check wait for the banner, send QUIT and then check the response:",[437,465,468],{"className":466,"code":467,"language":442},[440],"    option tcp-check\n    tcp-check expect rstring ^220\\ \n    tcp-check send QUIT\\r\\n\n    tcp-check expect rstring ^221\\ \n",[402,469,467],{"__ignoreMap":445},{"title":445,"searchDepth":471,"depth":471,"links":472},2,[],"Haraka natively supports the PROXY protocol 1.","md",null,{"_path":75},{"title":74},{"title":379,"description":473},"9T3a7O5MDfXkaOhefUYE7mXArYHgIXe8mKbrw2hlyKs",[481,483],{"title":70,"path":71,"stem":72,"description":482,"children":-1},"This content has moved to haraka-dsn.",{"title":78,"path":79,"stem":80,"description":484,"children":-1},"Logging conventions within Haraka",1794456869685]