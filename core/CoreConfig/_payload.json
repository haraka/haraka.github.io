ns\u002Fsyslog","8.plugins\u002Fsyslog",{"title":354,"path":355,"stem":356},"tarpit","\u002Fplugins\u002Ftarpit","8.plugins\u002Ftarpit",{"title":358,"path":359,"stem":360},"tls","\u002Fplugins\u002Ftls","8.plugins\u002Ftls",{"title":362,"path":363,"stem":364},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":366,"path":367,"stem":368},"uribl","\u002Fplugins\u002Furibl","8.plugins\u002Furibl",{"title":370,"path":371,"stem":372},"watch","\u002Fplugins\u002Fwatch","8.plugins\u002Fwatch",{"title":374,"path":375,"stem":376},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":378,"title":66,"body":379,"description":558,"extension":559,"links":560,"meta":561,"navigation":562,"path":67,"seo":563,"stem":68,"__hash__":564},"docs\u002F6.core\u002F5.CoreConfig.md",{"type":380,"value":381,"toc":554},"minimark",[382,390,393,400,406,411,414],[383,384,385,386,389],"p",{},"See ",[387,388,34],"a",{"href":35},".",[383,391,392],{},"The Haraka core reads some configuration files to determine a few actions:",[394,395,396],"ul",{},[397,398,399],"li",{},"smtp.yaml or smtp.json",[383,401,402,403,405],{},"If either of these files exist then they are loaded first.\nThis file is designed to use the JSON\u002FYAML file overrides documented in\n",[387,404,58],{"href":59}," to optionally provide the entire configuration in a single file.",[394,407,408],{},[397,409,410],{},"plugins",[383,412,413],{},"The list of plugins to load",[394,415,416,472,478,525,545,548],{},[397,417,418,419,422,423],{},"smtp.ini",[420,421],"br",{},"Keys:",[394,424,425,428,436,439,442,445,448,451,454,457,460,463,466,469],{},[397,426,427],{},"listen_host, port - the host and port to listen on (default: ::0 and 25)",[397,429,430,431,435],{},"listen - (default: ",[432,433,434],"span",{},"::0",":25) Comma separated IP:Port addresses to listen on",[397,437,438],{},"inactivity_time - how long to let clients idle in seconds (default: 300)",[397,440,441],{},"nodes - specifies how many processes to fork. The string \"cpus\" will fork as many children as there are CPUs (default: 1, which enables cluster mode with a single process)",[397,443,444],{},"user - optionally a user to drop privileges to. Can be a string or UID.",[397,446,447],{},"group - optionally a group to drop privileges to. Can be a string or GID.",[397,449,450],{},"ignore_bad_plugins - If a plugin fails to compile by default Haraka will stop at load time.\nIf, however, you wish to continue on without that plugin's facilities, then\nset this config option",[397,452,453],{},"daemonize - enable this to cause Haraka to fork into the background on start-up (default: 0)",[397,455,456],{},"daemon_log_file - (default: \u002Fvar\u002Flog\u002Fharaka.log) where to redirect stdout\u002Fstderr when daemonized",[397,458,459],{},"daemon_pid_file - (default: \u002Fvar\u002Frun\u002Fharaka.pid) where to write a PID file to",[397,461,462],{},"spool_dir - (default: none) directory to create temporary spool files in",[397,464,465],{},"spool_after - (default: -1) if message exceeds this size in bytes, then spool the message to disk\nspecify -1 to disable spooling completely or 0 to force all messages to be spooled to disk.",[397,467,468],{},"graceful_shutdown - (default: false) enable this to wait for sockets on shutdown instead of closing them quickly",[397,470,471],{},"force_shutdown_timeout - (default: 30) number of seconds to wait for a graceful shutdown",[397,473,474,475,477],{},"me",[420,476],{},"A name to use for this server. Used in received lines and elsewhere. Setup\nby default to be your hostname.",[397,479,480,481,483,484],{},"connection.ini",[420,482],{},"See inline comments in connection.ini for the following settings:",[394,485,486,489,492,495,498,501,504,507,510,513,516,519,522],{},[397,487,488],{},"haproxy.hosts_ipv4",[397,490,491],{},"haproxy.hosts_ipv6",[397,493,494],{},"headers.*",[397,496,497],{},"max.bytes",[397,499,500],{},"max.line_length",[397,502,503],{},"max.data_line_length",[397,505,506],{},"max.mime_parts",[397,508,509],{},"message.greeting",[397,511,512],{},"message.close",[397,514,515],{},"smtputf8",[397,517,518],{},"strict_rfc1869",[397,520,521],{},"uuid.deny_chars",[397,523,524],{},"uuid.banner_bytes",[397,526,527,528,530,531,533,534,538,539,541,542],{},"plugin_timeout",[420,529],{},"Seconds to allow a plugin to run before the next hook is called automatically\ndefault: 30",[420,532],{},"Note also that each plugin can have a ",[535,536,537],"code",{},"config\u002F\u003Cplugin_name>.timeout","\nfile specifying a per-plugin timeout.  In this file you can set a timeout of 0 to mean that this plugin's hooks never time out.  Use this with care.",[420,540],{},"If the plugin is in a sub-directory of plugins, then you must create this file\nin the equivalent path e.g. the queue\u002Fsmtp_forward would need a timeout file in ",[535,543,544],{},"config\u002Fqueue\u002Fsmtp_forward.timeout",[397,546,547],{},"outbound.ini",[397,549,550,551,553],{},"outbound.bounce_message",[420,552],{},"The bounce message if delivery of the message fails. The default is normally fine. Bounce messages contain a number of template replacement values which are best discovered by looking at the source code.",{"title":555,"searchDepth":556,"depth":556,"links":557},"",2,[],"See Logging.","md",null,{"_path":67},true,{"title":66,"description":558},"ONmlzM75GrEA1u8paHPLVjiELLEzlfQjqWVWpceETXI",[566,568],{"title":62,"path":63,"stem":64,"description":567,"children":-1},"For each connection to Haraka there is one connection object.",{"title":70,"path":71,"stem":72,"description":569,"children":-1},"This content has moved to haraka-dsn.",1794456869264]