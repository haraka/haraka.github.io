"title":210,"path":211,"stem":212},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":214,"path":215,"stem":216},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":218,"title":66,"body":219,"description":398,"extension":399,"links":400,"meta":401,"navigation":402,"path":67,"seo":403,"stem":68,"__hash__":404},"docs\u002F6.core\u002F5.CoreConfig.md",{"type":220,"value":221,"toc":394},"minimark",[222,230,233,240,246,251,254],[223,224,225,226,229],"p",{},"See ",[227,228,34],"a",{"href":35},".",[223,231,232],{},"The Haraka core reads some configuration files to determine a few actions:",[234,235,236],"ul",{},[237,238,239],"li",{},"smtp.yaml or smtp.json",[223,241,242,243,245],{},"If either of these files exist then they are loaded first.\nThis file is designed to use the JSON\u002FYAML file overrides documented in\n",[227,244,58],{"href":59}," to optionally provide the entire configuration in a single file.",[234,247,248],{},[237,249,250],{},"plugins",[223,252,253],{},"The list of plugins to load",[234,255,256,312,318,365,385,388],{},[237,257,258,259,262,263],{},"smtp.ini",[260,261],"br",{},"Keys:",[234,264,265,268,276,279,282,285,288,291,294,297,300,303,306,309],{},[237,266,267],{},"listen_host, port - the host and port to listen on (default: ::0 and 25)",[237,269,270,271,275],{},"listen - (default: ",[272,273,274],"span",{},"::0",":25) Comma separated IP:Port addresses to listen on",[237,277,278],{},"inactivity_time - how long to let clients idle in seconds (default: 300)",[237,280,281],{},"nodes - specifies how many processes to fork. The string \"cpus\" will fork as many children as there are CPUs (default: 1, which enables cluster mode with a single process)",[237,283,284],{},"user - optionally a user to drop privileges to. Can be a string or UID.",[237,286,287],{},"group - optionally a group to drop privileges to. Can be a string or GID.",[237,289,290],{},"ignore_bad_plugins - If a plugin fails to compile by default Haraka will stop at load time.\nIf, however, you wish to continue on without that plugin's facilities, then\nset this config option",[237,292,293],{},"daemonize - enable this to cause Haraka to fork into the background on start-up (default: 0)",[237,295,296],{},"daemon_log_file - (default: \u002Fvar\u002Flog\u002Fharaka.log) where to redirect stdout\u002Fstderr when daemonized",[237,298,299],{},"daemon_pid_file - (default: \u002Fvar\u002Frun\u002Fharaka.pid) where to write a PID file to",[237,301,302],{},"spool_dir - (default: none) directory to create temporary spool files in",[237,304,305],{},"spool_after - (default: -1) if message exceeds this size in bytes, then spool the message to disk\nspecify -1 to disable spooling completely or 0 to force all messages to be spooled to disk.",[237,307,308],{},"graceful_shutdown - (default: false) enable this to wait for sockets on shutdown instead of closing them quickly",[237,310,311],{},"force_shutdown_timeout - (default: 30) number of seconds to wait for a graceful shutdown",[237,313,314,315,317],{},"me",[260,316],{},"A name to use for this server. Used in received lines and elsewhere. Setup\nby default to be your hostname.",[237,319,320,321,323,324],{},"connection.ini",[260,322],{},"See inline comments in connection.ini for the following settings:",[234,325,326,329,332,335,338,341,344,347,350,353,356,359,362],{},[237,327,328],{},"haproxy.hosts_ipv4",[237,330,331],{},"haproxy.hosts_ipv6",[237,333,334],{},"headers.*",[237,336,337],{},"max.bytes",[237,339,340],{},"max.line_length",[237,342,343],{},"max.data_line_length",[237,345,346],{},"max.mime_parts",[237,348,349],{},"message.greeting",[237,351,352],{},"message.close",[237,354,355],{},"smtputf8",[237,357,358],{},"strict_rfc1869",[237,360,361],{},"uuid.deny_chars",[237,363,364],{},"uuid.banner_bytes",[237,366,367,368,370,371,373,374,378,379,381,382],{},"plugin_timeout",[260,369],{},"Seconds to allow a plugin to run before the next hook is called automatically\ndefault: 30",[260,372],{},"Note also that each plugin can have a ",[375,376,377],"code",{},"config\u002F\u003Cplugin_name>.timeout","\nfile specifying a per-plugin timeout.  In this file you can set a timeout of 0 to mean that this plugin's hooks never time out.  Use this with care.",[260,380],{},"If the plugin is in a sub-directory of plugins, then you must create this file\nin the equivalent path e.g. the queue\u002Fsmtp_forward would need a timeout file in ",[375,383,384],{},"config\u002Fqueue\u002Fsmtp_forward.timeout",[237,386,387],{},"outbound.ini",[237,389,390,391,393],{},"outbound.bounce_message",[260,392],{},"The bounce message if delivery of the message fails. The default is normally fine. Bounce messages contain a number of template replacement values which are best discovered by looking at the source code.",{"title":395,"searchDepth":396,"depth":396,"links":397},"",2,[],"See Logging.","md",null,{"_path":67},true,{"title":66,"description":398},"ONmlzM75GrEA1u8paHPLVjiELLEzlfQjqWVWpceETXI",[406,408],{"title":62,"path":63,"stem":64,"description":407,"children":-1},"For each connection to Haraka there is one connection object.",{"title":70,"path":71,"stem":72,"description":409,"children":-1},"This content has moved to haraka-dsn.",1794458076308]