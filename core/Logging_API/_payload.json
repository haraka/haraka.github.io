ns\u002Fsyslog","8.plugins\u002Fsyslog",{"title":354,"path":355,"stem":356},"tarpit","\u002Fplugins\u002Ftarpit","8.plugins\u002Ftarpit",{"title":358,"path":359,"stem":360},"tls","\u002Fplugins\u002Ftls","8.plugins\u002Ftls",{"title":362,"path":363,"stem":364},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":366,"path":367,"stem":368},"uribl","\u002Fplugins\u002Furibl","8.plugins\u002Furibl",{"title":370,"path":371,"stem":372},"watch","\u002Fplugins\u002Fwatch","8.plugins\u002Fwatch",{"title":374,"path":375,"stem":376},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":378,"title":78,"body":379,"description":385,"extension":555,"links":556,"meta":557,"navigation":558,"path":79,"seo":559,"stem":80,"__hash__":560},"docs\u002F6.core\u002F8.Logging_API.md",{"type":380,"value":381,"toc":551},"minimark",[382,386,391,398,401,411,414,417,467,470,476,479,509,512,541,544,547],[383,384,385],"p",{},"Logging conventions within Haraka",[387,388,390],"h2",{"id":389},"see-also","See also",[383,392,393],{},[394,395,397],"a",{"href":396},"","https:\u002F\u002Fgithub.com\u002Fharaka\u002FHaraka\u002Fpull\u002F119",[383,399,400],{},"logline will always always be in the form:",[402,403,408],"pre",{"className":404,"code":406,"language":407,"meta":396},[405],"language-text","[level] [connection uuid] [origin] message\n","text",[409,410,406],"code",{"__ignoreMap":396},[383,412,413],{},"where origin is \"haraka_core\" or the name of the plugin which\ntriggered the message, and \"connection uuid\" is the ID of the\nconnection associated with the message.",[383,415,416],{},"when calling a log method on logger, you should provide the\nplugin object and the connection object anywhere in the arguments\nto the log method.",[402,418,422],{"className":419,"code":420,"language":421,"meta":396,"style":396},"language-js shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","logger.logdebug(\"i like turtles\", plugin, connection);\n","js",[409,423,424],{"__ignoreMap":396},[425,426,429,433,437,441,444,447,451,453,456,459,461,464],"span",{"class":427,"line":428},"line",1,[425,430,432],{"class":431},"sTEyZ","logger",[425,434,436],{"class":435},"sMK4o",".",[425,438,440],{"class":439},"s2Zo4","logdebug",[425,442,443],{"class":431},"(",[425,445,446],{"class":435},"\"",[425,448,450],{"class":449},"sfazB","i like turtles",[425,452,446],{"class":435},[425,454,455],{"class":435},",",[425,457,458],{"class":431}," plugin",[425,460,455],{"class":435},[425,462,463],{"class":431}," connection)",[425,465,466],{"class":435},";\n",[383,468,469],{},"will yield, for example,",[402,471,474],{"className":472,"code":473,"language":407,"meta":396},[405],"[DEBUG] [7F1C820F-DC79-4192-9AA6-5307354B20A6] [dnsbl] i like turtles\n",[409,475,473],{"__ignoreMap":396},[383,477,478],{},"if you call the log method on the connection object, you can\nforego the connection as argument:",[402,480,482],{"className":419,"code":481,"language":421,"meta":396,"style":396},"connection.logdebug(\"turtles all the way down\", plugin);\n",[409,483,484],{"__ignoreMap":396},[425,485,486,489,491,493,495,497,500,502,504,507],{"class":427,"line":428},[425,487,488],{"class":431},"connection",[425,490,436],{"class":435},[425,492,440],{"class":439},[425,494,443],{"class":431},[425,496,446],{"class":435},[425,498,499],{"class":449},"turtles all the way down",[425,501,446],{"class":435},[425,503,455],{"class":435},[425,505,506],{"class":431}," plugin)",[425,508,466],{"class":435},[383,510,511],{},"and similarly for the log methods on the plugin object:",[402,513,515],{"className":419,"code":514,"language":421,"meta":396,"style":396},"plugin.logdebug(\"he just really likes turtles\", connection);\n",[409,516,517],{"__ignoreMap":396},[425,518,519,522,524,526,528,530,533,535,537,539],{"class":427,"line":428},[425,520,521],{"class":431},"plugin",[425,523,436],{"class":435},[425,525,440],{"class":439},[425,527,443],{"class":431},[425,529,446],{"class":435},[425,531,532],{"class":449},"he just really likes turtles",[425,534,446],{"class":435},[425,536,455],{"class":435},[425,538,463],{"class":431},[425,540,466],{"class":435},[383,542,543],{},"failing to provide a connection and\u002For plugin object will leave\nthe default values in the log (currently \"core\" and\n\"no_connection\").",[383,545,546],{},"this is implemented by testing for argument type in\nthe logger.js log* method. objects-as-arguments are then sniffed\nto try to determine if they're a connection or plugin instance.",[548,549,550],"style",{},"html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);back