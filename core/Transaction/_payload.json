[443,444,449],"pre",{"className":445,"code":446,"language":447,"meta":448,"style":448},"language-js shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","transaction.message_stream.pipe(WritableStream, options)\n","js","",[410,450,451],{"__ignoreMap":448},[414,452,455,459,463,466,468,472,475,478],{"class":453,"line":454},"line",1,[414,456,458],{"class":457},"sTEyZ","transaction",[414,460,462],{"class":461},"sMK4o",".",[414,464,465],{"class":457},"message_stream",[414,467,462],{"class":461},[414,469,471],{"class":470},"s2Zo4","pipe",[414,473,474],{"class":457},"(WritableStream",[414,476,477],{"class":461},",",[414,479,480],{"class":457}," options)\n",[383,482,483],{},"Where WritableStream is a node.js Writable Stream object such as a\nnet.socket, fs.writableStream, process.stdout\u002Fstderr or custom stream.",[383,485,486],{},"The options argument should be an object that overrides the following\nproperties:",[443,488,490],{"className":445,"code":489,"language":447,"meta":448,"style":448},"    * line_endings (default: \"\\r\\n\")\n    * dot_stuffed  (default: true)\n    * ending_dot   (default: false)\n    * end          (default: true)\n    * buffer_size  (default: 65535)\n    * clamd_style  (default: false)\n",[410,491,492,514,531,547,562,578],{"__ignoreMap":448},[414,493,494,497,500,503,506,509,511],{"class":453,"line":454},[414,495,496],{"class":461},"    *",[414,498,499],{"class":470}," line_endings",[414,501,502],{"class":457}," (default: ",[414,504,505],{"class":461},"\"",[414,507,508],{"class":457},"\\r\\n",[414,510,505],{"class":461},[414,512,513],{"class":457},")\n",[414,515,517,519,522,525,529],{"class":453,"line":516},2,[414,518,496],{"class":461},[414,520,521],{"class":470}," dot_stuffed",[414,523,524],{"class":457},"  (default: ",[414,526,528],{"class":527},"sfNiH","true",[414,530,513],{"class":457},[414,532,534,536,539,542,545],{"class":453,"line":533},3,[414,535,496],{"class":461},[414,537,538],{"class":470}," ending_dot",[414,540,541],{"class":457},"   (default: ",[414,543,544],{"class":527},"false",[414,546,513],{"class":457},[414,548,550,552,555,558,560],{"class":453,"line":549},4,[414,551,496],{"class":461},[414,553,554],{"class":470}," end",[414,556,557],{"class":457},"          (default: ",[414,559,528],{"class":527},[414,561,513],{"class":457},[414,563,565,567,570,572,576],{"class":453,"line":564},5,[414,566,496],{"class":461},[414,568,569],{"class":470}," buffer_size",[414,571,524],{"class":457},[414,573,575],{"class":574},"sbssI","65535",[414,577,513],{"class":457},[414,579,581,583,586,588,590],{"class":453,"line":580},6,[414,582,496],{"class":461},[414,584,585],{"class":470}," clamd_style",[414,587,524],{"class":457},[414,589,544],{"class":527},[414,591,513],{"class":457},[383,593,594],{},"e.g.",[443,596,598],{"className":445,"code":597,"language":447,"meta":448,"style":448},"transaction.message_stream.pipe(socket, { ending_dot: true });\n",[410,599,600],{"__ignoreMap":448},[414,601,602,604,606,608,610,612,615,617,620,623,626,629,632,635],{"class":453,"line":454},[414,603,458],{"class":457},[414,605,462],{"class":461},[414,607,465],{"class":457},[414,609,462],{"class":461},[414,611,471],{"class":470},[414,613,614],{"class":457},"(socket",[414,616,477],{"class":461},[414,618,619],{"class":461}," {",[414,621,538],{"class":622},"swJcz",[414,624,625],{"class":461},":",[414,627,628],{"class":527}," true",[414,630,631],{"class":461}," }",[414,633,634],{"class":457},")",[414,636,637],{"class":461},";\n",[392,639,640],{},[395,641,642],{},"transaction.data_bytes",[383,644,645],{},"The number of bytes in the email after DATA.",[392,647,648],{},[395,649,650],{},"transaction.add_data(line)",[383,652,653],{},"Adds a line of data to the email. Note this is RAW email - it isn't useful\nfor adding banners to the email.",[392,655,656],{},[395,657,658],{},"transaction.notes",[383,660,661,662,669,670,462],{},"A safe place to store transaction specific values. See also ",[663,664,668],"a",{"href":665,"rel":666},"https:\u002F\u002Fgithub.com\u002Fharaka\u002Fharaka-results",[667],"nofollow","haraka-results"," and ",[663,671,674],{"href":672,"rel":673},"https:\u002F\u002Fgithub.com\u002Fharaka\u002Fharaka-notes",[667],"haraka-notes",[392,676,677],{},[395,678,679],{},"transaction.add_leading_header(key, value)",[383,681,682,683,686],{},"Adds a header to the top of the header list.  This should only be used in\nvery specific cases.  Most people will want to use ",[410,684,685],{},"add_header()"," instead.",[392,688,689],{},[395,690,691],{},"transaction.add_header(key, value)",[383,693,694],{},"Adds a header to the email.",[392,696,697],{},[395,698,699],{},"transaction.remove_header(key)",[383,701,702],{},"Deletes a header from the email.",[392,704,705],{},[395,706,707],{},"transaction.header",[383,709,710,711,462],{},"The header of the email. See ",[410,712,82],{},[392,714,715],{},[395,716,717,718],{},"transaction.parse_body = true|false ",[414,719,720],{},"default: false",[383,722,723,724,726],{},"Set to ",[410,725,528],{}," to enable parsing of the mail body. Make sure you set this in\nhook_data or before.",[392,728,729],{},[395,730,731],{},"transaction.body",[383,733,734,735,738,739,462],{},"The body of the email if you set ",[410,736,737],{},"parse_body"," above. See ",[410,740,54],{},[392,742,743],{},[395,744,745],{},"transaction.attachment_hooks(start)",[383,747,748,749,751],{},"Sets a callback for when we see an attachment if ",[410,750,737],{}," has been set.",[383,753,754,755,758,759,762],{},"The ",[410,756,757],{},"start"," event will receive ",[410,760,761],{},"(content_type, filename, body, stream)"," as\nparameters.",[383,764,765,766,769,770,774],{},"The stream is a ",[410,767,768],{},"ReadableStream"," - see ",[663,771,772],{"href":772,"rel":773},"http:\u002F\u002Fnodejs.org\u002Fapi\u002Fstream.html",[667]," for\ndetails on how this works.",[383,776,777,778,781],{},"If you set stream.connection then the stream will apply backpressure to the\nconnection, allowing you to process attachments before the connection has\nended. Here is an example which stores attachments in temporary files using\nthe ",[410,779,780],{},"tmp"," library from npm and tells us the size of the file:",[443,783,785],{"className":445,"code":784,"language":447,"meta":448,"style":448},"exports.hook_data = function (next, connection) {\n    \u002F\u002F enable mail body parsing\n    connection.transaction.parse_body = true;\n    connection.transaction.attachment_hooks(\n        function (ct, fn, body, stream) {\n            start_att(connection, ct, fn, body, stream)\n        }\n    );\n    next();\n}\n\nfunction start_att (connection, ct, fn, body, stream) {\n    connection.loginfo(\"Got attachment: \" + ct + \", \" + fn + \" for user id: \" + connection.transaction.notes.hubdoc_user.email);\n    connection.transaction.notes.attachment_count++;\n\n    stream.connection = connection; \u002F\u002F Allow backpressure\n    stream.pause();\n\n    var tmp = require('tmp');\n\n    tmp.file(function (err, path, fd) {\n        connection.loginfo(\"Got tempfile: \" + path + \" (\" + fd + \")\");\n        var ws = fs.createWriteStream(path);\n        stream.pipe(ws);\n        stream.resume();\n        ws.on('close', function () {\n            connection.loginfo(\"End of stream reached\");\n            fs.fstat(fd, function (err, stats) {\n                connection.loginfo(\"Got data of length: \" + stats.size);\n                \u002F\u002F Close the tmp file descriptor\n                fs.close(fd, function(){});\n            });\n        });\n    });\n}\n",[410,786,787,819,825,844,860,889,919,925,933,944,950,957,990,1065,1086,1091,1111,1125,1130,1157,1162,1196,1243,1271,1290,1304,1333,1356,1389,1421,1427,1452,1462,1472,1482],{"__ignoreMap":448},[414,788,789,792,795,798,802,805,809,811,814,816],{"class":453,"line":454},[414,790,791],{"class":461},"exports.",[414,793,794],{"class":470},"hook_data",[414,796,797],{"class":461}," =",[414,799,801],