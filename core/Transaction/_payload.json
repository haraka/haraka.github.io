e used in\nvery specific cases.  Most people will want to use ",[250,524,525],{},"add_header()"," instead.",[232,528,529],{},[235,530,531],{},"transaction.add_header(key, value)",[223,533,534],{},"Adds a header to the email.",[232,536,537],{},[235,538,539],{},"transaction.remove_header(key)",[223,541,542],{},"Deletes a header from the email.",[232,544,545],{},[235,546,547],{},"transaction.header",[223,549,550,551,302],{},"The header of the email. See ",[250,552,82],{},[232,554,555],{},[235,556,557,558],{},"transaction.parse_body = true|false ",[254,559,560],{},"default: false",[223,562,563,564,566],{},"Set to ",[250,565,368],{}," to enable parsing of the mail body. Make sure you set this in\nhook_data or before.",[232,568,569],{},[235,570,571],{},"transaction.body",[223,573,574,575,578,579,302],{},"The body of the email if you set ",[250,576,577],{},"parse_body"," above. See ",[250,580,54],{},[232,582,583],{},[235,584,585],{},"transaction.attachment_hooks(start)",[223,587,588,589,591],{},"Sets a callback for when we see an attachment if ",[250,590,577],{}," has been set.",[223,593,594,595,598,599,602],{},"The ",[250,596,597],{},"start"," event will receive ",[250,600,601],{},"(content_type, filename, body, stream)"," as\nparameters.",[223,604,605,606,609,610,614],{},"The stream is a ",[250,607,608],{},"ReadableStream"," - see ",[503,611,612],{"href":612,"rel":613},"http:\u002F\u002Fnodejs.org\u002Fapi\u002Fstream.html",[507]," for\ndetails on how this works.",[223,616,617,618,621],{},"If you set stream.connection then the stream will apply backpressure to the\nconnection, allowing you to process attachments before the connection has\nended. Here is an example which stores attachments in temporary files using\nthe ",[250,619,620],{},"tmp"," library from npm and tells us the size of the file:",[283,623,625],{"className":285,"code":624,"language":287,"meta":288,"style":288},"exports.hook_data = function (next, connection) {\n    \u002F\u002F enable mail body parsing\n    connection.transaction.parse_body = true;\n    connection.transaction.attachment_hooks(\n        function (ct, fn, body, stream) {\n            start_att(connection, ct, fn, body, stream)\n        }\n    );\n    next();\n}\n\nfunction start_att (connection, ct, fn, body, stream) {\n    connection.loginfo(\"Got attachment: \" + ct + \", \" + fn + \" for user id: \" + connection.transaction.notes.hubdoc_user.email);\n    connection.transaction.notes.attachment_count++;\n\n    stream.connection = connection; \u002F\u002F Allow backpressure\n    stream.pause();\n\n    var tmp = require('tmp');\n\n    tmp.file(function (err, path, fd) {\n        connection.loginfo(\"Got tempfile: \" + path + \" (\" + fd + \")\");\n        var ws = fs.createWriteStream(path);\n        stream.pipe(ws);\n        stream.resume();\n        ws.on('close', function () {\n            connection.loginfo(\"End of stream reached\");\n            fs.fstat(fd, function (err, stats) {\n                connection.loginfo(\"Got data of length: \" + stats.size);\n                \u002F\u002F Close the tmp file descriptor\n                fs.close(fd, function(){});\n            });\n        });\n    });\n}\n",[250,626,627,659,665,684,700,729,759,765,773,784,790,797,830,905,926,931,951,965,970,997,1002,1036,1083,1111,1130,1144,1173,1196,1229,1261,1267,1292,1302,1312,1322],{"__ignoreMap":288},[254,628,629,632,635,638,642,645,649,651,654,656],{"class":293,"line":294},[254,630,631],{"class":301},"exports.",[254,633,634],{"class":310},"hook_data",[254,636,637],{"class":301}," =",[254,639,641],{"class":640},"spNyl"," function",[254,643,644],{"class":301}," (",[254,646,648],{"class":647},"sHdIc","next",[254,650,317],{"class":301},[254,652,653],{"class":647}," connection",[254,655,474],{"class":301},[254,657,658],{"class":301}," {\n",[254,660,661],{"class":293,"line":356},[254,662,664],{"class":663},"sHwdD","    \u002F\u002F enable mail body parsing\n",[254,666,667,670,672,674,676,678,680,682],{"class":293,"l