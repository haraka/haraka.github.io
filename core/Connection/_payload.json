itle":210,"path":211,"stem":212},"toobusy","\u002Fplugins\u002Ftoobusy","8.plugins\u002Ftoobusy",{"title":214,"path":215,"stem":216},"xclient","\u002Fplugins\u002Fxclient","8.plugins\u002Fxclient",{"id":218,"title":62,"body":219,"description":225,"extension":369,"links":370,"meta":371,"navigation":372,"path":63,"seo":373,"stem":64,"__hash__":374},"docs\u002F6.core\u002F4.Connection.md",{"type":220,"value":221,"toc":364},"minimark",[222,226,231,238,241,302,313,318,321,326,329,334,337,342,345,350,353,358],[223,224,225],"p",{},"For each connection to Haraka there is one connection object.",[227,228,230],"h2",{"id":229},"api","API",[232,233,234],"ul",{},[235,236,237],"li",{},"connection.uuid",[223,239,240],{},"A unique UUID for this connection.",[232,242,243,260,274,288,299],{},[235,244,245,246],{},"connection.remote - info about the host that is connecting to Haraka.",[232,247,248,251,254,257],{},[235,249,250],{},"ip   - remote IP address",[235,252,253],{},"host - reverse DNS of the remote hosts IP",[235,255,256],{},"is_private - true if the remote IP is from a private (loopback, RFC 1918, link local, etc.) IP address.",[235,258,259],{},"is_local - true if the remote IP is localhost (loopback, link local)",[235,261,262,263],{},"connection.local - info about the host that is running Haraka",[232,264,265,268,271],{},[235,266,267],{},"ip - the IP of the Haraka server, as reported by the OS",[235,269,270],{},"port - the port number handling the connection.",[235,272,273],{},"host - the rDNS host name of the local IP",[235,275,276,277],{},"connection.proxy - proxy properties set when a proxy is used (like haproxy)",[232,278,279,282,285],{},[235,280,281],{},"allowed - if the remote IP has proxy permission",[235,283,284],{},"ip - when proxied, the proxy servers IP address",[235,286,287],{},"type - currently null or 'haproxy'",[235,289,290,291],{},"connection.hello",[232,292,293,296],{},[235,294,295],{},"verb - Either 'EHLO' or 'HELO' whichever the remote end used",[235,297,298],{},"host - The hostname given with HELO or EHLO",[235,300,301],{},"connection.notes",[223,303,304,305,312],{},"An object which persists during the lifetime of the connection. It is used to store connection-specific properties. See also, connection.results and ",[306,307,311],"a",{"href":308,"rel":309},"https:\u002F\u002Fgithub.com\u002Fharaka\u002Fharaka-notes",[310],"nofollow","haraka-notes",".",[232,314,315],{},[235,316,317],{},"connection.transaction",[223,319,320],{},"The current transaction object, valid after MAIL FROM, and destroyed at queue\ntime, RSET time, or if MAIL FROM was rejected. See the Transaction Object\ndocumentation file.",[232,322,323],{},[235,324,325],{},"connection.relaying",[223,327,328],{},"A boolean flag to say whether this connection is allowed to relay mails (i.e.\ndeliver mails outbound). This is normally set by SMTP AUTH, or sometimes via\nan IP address check.",[232,330,331],{},[235,332,333],{},"connection.current_line",[223,335,336],{},"For low level use. Contains the current line sent from the remote end,\nverbatim as it was sent. Can be useful in certain botnet detection techniques.",[232,338,339],{},[235,340,341],{},"connection.last_response",[223,343,344],{},"Contains the last SMTP response sent to the client.",[232,346,347],{},[235,348,349],{},"connection.remote_closed",[223,351,352],{},"For low level use.  This value is set when the remote host drops the connection.",[232,354,355],{},[235,356,357],{},"connection.results",[223,359,360,361],{},"Store results of processing in a structured format. See ",[306,362,363],{"href":47},"docs\u002FResults",{"title":365,"searchDepth":366,"depth":366,"links":367},"",2,[368],{"id":229,"depth":366,"text":230},"md",null,{"_path":63},true,{"title":62,"description":225},"evDqRaS8Ohp1ctgCff4hQ21ozgjETzhS5U1RXPZ0xKo",[376,378],{"title":58,"path":59,"stem":60,"description":377,"children":-1},"This documentation has moved to haraka-config.",{"title":66,"path":67,"stem":68,"description":379,"children":-1},"See Logging.",1794458076258]